+/* -----------------------------------------------------------------------------
+AlfGpu.h  -  backend interface for offloading the ALF luma reconstruction
+
+The encoder hands over one "band" (one CTU row, or several) at a time. The band
+contains the pre-ALF luma samples (m_tempBuf, already border-extended by VVenC),
+the list of CTUs to filter with their filter-set index, and the APS filter sets of
+the current picture. The backend writes the filtered samples straight into the
+destination (picture reconstruction) buffer for those CTUs only.
+
+Two backends implement it:
+  * "cuda"      - real GPU kernels (AlfGpuCuda.cu, built with -DVVENC_ENABLE_CUDA_ALF=ON)
+  * "host-emu"  - the same data flow and the same core functions run on the CPU;
+                  used to validate bit-exactness without a GPU.
+Like AlfGpuCore.h, this header has no VVenC dependencies.
+------------------------------------------------------------------------------- */
+#pragma once
+
+#include "AlfGpuTiles.h"
+#include "AlfGpuCov.h"
+#include "AlfGpuDerive.h"
+
+#include <atomic>
+
+namespace alfgpu
+{
+
+enum Mode : int
+{
+  MODE_OFF        = 0,   // original VVenC CPU path
+  MODE_FULL       = 1,   // GPU gradients/classification/transpose (at the start of the ALF, also used for the
+                         // encoder statistics) + GPU filtering with the geometric transformation
+  MODE_FILTER     = 2,   // GPU filtering, classification taken from VVenC (m_classifier)
+  MODE_VERIFY     = 3,   // MODE_FULL + CPU reference, compare sample by sample (keeps CPU result)
+};
+
+struct BandParams
+{
+  // input: pre-ALF luma (m_tempBuf). src points to picture sample (0, bandY0);
+  // samples [-kHalo, picWidth + kHalo) x [bandY0 - kHalo, bandY0 + bandH + kHalo) must be readable
+  const Pel*  src;
+  ptrdiff_t   srcStride;
+
+  int picWidth;          // luma width (pcv.lumaWidth)
+  int bandY0;            // first luma row of the band (multiple of ctuSize)
+  int bandH;             // rows in the band
+  int ctuSize;
+  int numCtuCols;        // CTU columns in the picture
+  int bitDepth;
+  int vbH, vbPos;        // ALF virtual boundary parameters
+
+  // per CTU of the band (raster inside the band, numCtuCols * ceil(bandH/ctuSize)):
+  // filter set index (0..15 fixed, 16.. APS) or -1 = not filtered by the backend
+  const int16_t* ctuSetIdx;
+
+  // APS sets referenced by setIdx >= 16: numAps * kSetStride coefficients and clip values
+  const int16_t* apsCoef;
+  const int16_t* apsClip;
+  int numAps;
+
+  // MODE_FILTER: classification from VVenC, one byte per 4x4 block, (classIdx | transposeIdx << 5),
+  // row-major with stride picWidth/4, bandH/4 rows. Unused otherwise.
+  const uint8_t* cpuClass;
+
+  // output: dst points to picture sample (0, bandY0) of the reconstruction buffer
+  Pel*      dst;
+  ptrdiff_t dstStride;
+
+  // optional: if not null, receives the backend's classification (same packing as cpuClass)
+  uint8_t*  outClass;
+};
+
+// covariance statistics of one colour component for a set of statistics units (ASUs or CTUs)
+struct CovJob
+{
+  int comp;                    // 0 = luma: uses the picture and classes resident from classifyFrame(); 1, 2 = chroma
+  const Pel* rec;              // chroma: pre-ALF plane (m_tempBuf) at sample (0,0), kHalo samples readable around it
+  ptrdiff_t  recStride;
+  const Pel* org;              // original plane at (0,0); nullptr: use the original prefetched with prefetchOriginal()
+  ptrdiff_t  orgStride;
+  int width, height;           // plane size
+  CovKParams k;                // shape, bins, clipping values, virtual boundary (recPitch/orgPitch/clsStride set by the backend)
+  int numUnits;
+  const int*     unitCtuStart; // numUnits + 1 entries into ctuRect
+  const int16_t* ctuRect;      // x0, y0, w, h of each CTU (plane coordinates), CPU order inside each unit
+  const uint32_t* elem;        // k.numElem element descriptors (covElements())
+  float*   out;                // numUnits * numClasses * numElem accumulated values
+  uint8_t* used;               // numUnits * numClasses: class received at least one block (AlfCovariance::all0 == false)
+};
+
+// CCALF statistics (EncAdaptiveLoopFilter::deriveStatsForCcAlfFilteringCTU / getBlkStatsCcAlf) of one chroma component,
+// one unit per CTU; luma input = the pre-ALF luma resident from classifyFrame() of the same slot
+struct CcAlfJob
+{
+  int comp;                    // 1 = Cb, 2 = Cr
+  const Pel* slf;              // chroma reconstruction after the ALF (cs.getRecoBuf( comp )) at (0,0)
+  ptrdiff_t  slfStride;
+  const Pel* org;              // chroma original at (0,0); nullptr: prefetched original
+  ptrdiff_t  orgStride;
+  int width, height;           // chroma plane size
+  CovKParams k;                // ccalf = 1, sx, sy, vbH / vbPos (luma), lumaPicH, ctuSize; pitches set by the backend
+  int numUnits;                // CTUs
+  const int16_t* ctuRect;      // x0, y0, w, h (chroma coordinates) of each CTU
+  const uint32_t* elem;        // k.numElem element descriptors (covElements( 7, 1 ))
+  float* out;                  // numUnits * numElem
+};
+
+// original planes of the current picture (uploaded early, before the ALF needs them)
+struct OrigPlanes
+{
+  int numComp;
+  const Pel* org[3];
+  ptrdiff_t  stride[3];
+  int width[3], height[3];
+};
+
+struct Timing
+{
+  double hostPackMs   = 0;   // pageable -> staging copies (input)
+  double h2dMs        = 0;   // host -> device transfers
+  double classifyMs   = 0;   // classification kernel
+  double filterMs     = 0;   // filtering kernel
+  double covMs        = 0;   // covariance statistics kernels
+  double distMs       = 0;   // filter-derivation distortion-table kernels
+  double ccalfMs      = 0;   // CCALF statistics kernels
+  double d2hMs        = 0;   // device -> host transfers
+  double hostUnpackMs = 0;   // staging -> picture buffer copies (output)
+  double gpuSpanMs    = 0;   // GPU timeline from the first H2D to the last D2H (stages overlap across streams)
+  double totalMs      = 0;   // wall clock of the whole call
+  int    chunks       = 0;   // pipeline chunks used
+  uint64_t bytesH2D   = 0;
+  uint64_t bytesD2H   = 0;
+};
+
+class Backend
+{
+  std::atomic<int> m_nextSlot{ 0 };
+public:
+  virtual ~Backend() {}
+  virtual const char* name() const = 0;
+  // fixedCoef/fixedClip: kNumFixedSets * kSetStride each (m_fixedFilterSetCoeffDec / m_clipDefault)
+  virtual bool init( const int16_t* fixedCoef, const int16_t* fixedClip, int maxPicWidth, int maxBandH, int numWorkers ) = 0;
+  // thread-safe for distinct worker indices
+  virtual void filterLumaBand( const BandParams& p, int mode, int worker, Timing& t ) = 0;
+
+  // ---- frame-resident path: one slot per encoder picture context (EncAdaptiveLoopFilter instance)
+  // Stage 1, at the start of the ALF (ALF_GET_STATISTICS): uploads the whole picture (p.src, bandY0 = 0,
+  //   bandH = picture height), computes gradients, class and transpose index of every 4x4 block of the CTUs
+  //   with p.ctuSetIdx >= 0 and downloads them to p.outClass. Picture and classes stay on the device.
+  virtual void classifyFrame( const BandParams& p, int slot, Timing& t ) = 0;
+  // Stage 2, after the filter decisions (ALF_DERIVE_FILTER): filters the CTUs with p.ctuSetIdx >= 0 (filter set
+  //   index) with the resident picture and classes; p.src / p.cpuClass are not used. Output to p.dst.
+  virtual void filterFrameResident( const BandParams& p, int slot, Timing& t ) = 0;
+  // Statistics (ALF_GET_STATISTICS), after classifyFrame() on the same slot: covariance statistics of the jobs
+  //   (luma reuses the resident picture and classes; chroma and the original planes are uploaded).
+  virtual void covarianceFrame( const CovJob* jobs, int numJobs, int slot, Timing& t ) = 0;
+  // Filter derivation (ALF_DERIVE_FILTER): the parallel part of mergeFiltersAndCost() - greedy class merging and the
+  //   Wiener filter + quantisation of every (numFilters, filter) hypothesis - for the frame covariances in job.cov.
+  virtual void mergeFilters( const MergeJob& job, MergeResult& res, int slot, Timing& t ) = 0;
+  // CCALF statistics of the whole picture (after the ALF reconstruction), after classifyFrame() on the same slot
+  virtual void ccalfStatsFrame( const CcAlfJob* jobs, int numJobs, int slot, Timing& t ) = 0;
+  // Fixed-cost reduction:
+  //   prefetchOriginal: asynchronous upload of the original planes at the start of the picture (consumed by
+  //                     covarianceFrame / ccalfStatsFrame jobs with org == nullptr)
+  //   classifyAndCovariance: classifyFrame + covarianceFrame as one submission with a single synchronisation;
+  //                     the classes are downloaded only if p.outClass != nullptr
+  //   registerHost:     page-lock a long-lived host buffer (the encoder's pre-ALF picture copy) so that uploads read it
+  //                     directly (no staging copy)
+  virtual void prefetchOriginal( const OrigPlanes&, int /*slot*/, Timing& ) {}
+  virtual void classifyAndCovariance( const BandParams& p, const CovJob* jobs, int numJobs, int slot, Timing& tCls, Timing& tCov )
+  {
+    classifyFrame( p, slot, tCls );
+    covarianceFrame( jobs, numJobs, slot, tCov );
+  }
+  virtual bool registerHost( void*, size_t ) { return false; }
+  virtual void unregisterHost( void* ) {}
+  int  acquireSlot() { return m_nextSlot++; }
+  // GPU energy counter (NVML, mJ since driver load) and instantaneous power (mW); false if unavailable
+  virtual bool readEnergy_mJ( unsigned long long& )  { return false; }
+  virtual bool readPower_mW ( unsigned& )            { return false; }
+};
+
+// returns an initialised CUDA backend when compiled with VVENC_CUDA_ALF and a device is present
+// (unless env VVENC_ALF_GPU_EMU=1), otherwise the initialised host emulation backend
+Backend* createBackend( const int16_t* fixedCoef, const int16_t* fixedClip, int maxPicWidth, int maxBandH, int numWorkers );
+
+// host reference used by the emulation backend and by the benchmark (exposed for tests)
+void hostClassifyBand( const Pel* in, ptrdiff_t inStride, const BandParams& p, uint8_t* cls, int clsStride );
+void hostFilterBand  ( const Pel* in, ptrdiff_t inStride, const BandParams& p, const int16_t* coefTab, const int16_t* clipTab,
+                       const uint8_t* cls, int clsStride, Pel* out, ptrdiff_t outStride );
+
+} // namespace alfgpu
diff --git a/source/Lib/CommonLib/AlfGpuCore.h b/source/Lib/CommonLib/AlfGpuCore.h
new file mode 100644
index 0000000..0625c73
--- /dev/null
+++ b/source/Lib/CommonLib/AlfGpuCore.h
@@ -0,0 +1,260 @@
+/* -----------------------------------------------------------------------------
+AlfGpuCore.h  -  bit-exact ALF luma core shared by CPU (host) and CUDA (device)
+
+Every function here reproduces, sample by sample, the integer arithmetic of
+  AdaptiveLoopFilter::deriveClassificationBlk()   (classification, 4x4 blocks)
+  AdaptiveLoopFilter::filterBlk<ALF_FILTER_7>()    (7x7 diamond luma filter)
+of VVenC, including the ALF virtual boundary (VB) handling.
+
+The functions take a pointer to the sample being processed plus the row stride,
+so they work the same on a full picture buffer, a padded band copied to the GPU,
+or a tile staged in CUDA shared memory. The *global* (picture) row y is passed
+separately because the VB rules depend on (y mod CTU height).
+
+No VVenC headers are included, so this file compiles with nvcc as well as g++.
+------------------------------------------------------------------------------- */
+#pragma once
+
+#include <cstdint>
+#include <cstddef>
+
+#if defined( __CUDACC__ )
+#  define ALFG_HD __host__ __device__ __forceinline__
+#else
+#  define ALFG_HD inline
+#endif
+
+namespace alfgpu
+{
+
+typedef int16_t Pel;
+
+static constexpr int kNumClasses   = 25;
+static constexpr int kNumCoeff     = 13;                        // 12 taps + centre (128)
+static constexpr int kSetStride    = kNumClasses * kNumCoeff;   // 325 shorts per filter set
+static constexpr int kNumFixedSets = 16;                        // NUM_FIXED_FILTER_SETS
+static constexpr int kMaxAps       = 8;                         // ALF_CTB_MAX_NUM_APS
+static constexpr int kMaxSets      = kNumFixedSets + kMaxAps;   // setIdx as in m_alfCtbFilterIndex
+static constexpr int kHalo         = 4;                         // samples kept around a band (>= 3 needed)
+static constexpr int kShift        = 7;                         // m_NUM_BITS - 1
+
+ALFG_HD int iabs_ ( int v )                 { return v < 0 ? -v : v; }
+ALFG_HD int clip3_( int lo, int hi, int v ) { return v < lo ? lo : ( v > hi ? hi : v ); }
+
+// th[16] = { 0, 1, 2, 2, 2, 2, 2, 3, 3, 3, 3, 3, 3, 3, 3, 4 }
+ALFG_HD int activityToClass( int a )
+{
+  return a == 0 ? 0 : a == 1 ? 1 : a < 7 ? 2 : a < 15 ? 3 : 4;
+}
+
+// transposeTable[8] = { 0, 1, 0, 2, 2, 3, 1, 3 }, packed 2 bits per entry
+ALFG_HD int transposeLut( int idx )
+{
+  return ( 0xDE84 >> ( 2 * idx ) ) & 3;
+}
+
+// ---------------------------------------------------------------------------
+// Laplacian "cell": the 4 directional activities of the 2x2 cell whose top-left
+// sample is (r, c). Each cell contributes |lap(r,c)| + |lap(r+1,c+1)| per direction
+// (VVenC sub-sampling). A 4x4 block sums the 4x4 cells r = y-2, y, y+2, y+4 and
+// c = x-2, x, x+2, x+4; neighbouring blocks share cells, so a GPU tile computes each
+// cell once and all blocks of the tile reuse it.
+//   p  : pointer to sample (r, c)        ry : global picture row r (even)
+// Needs rows r-1 .. r+2 and columns c-1 .. c+2.
+// ---------------------------------------------------------------------------
+ALFG_HD void lapCell( const Pel* p, ptrdiff_t stride, int ry, int vbH, int vbPos, int& v, int& h, int& d0, int& d1 )
+{
+  const int vbMask = vbH - 1;
+  const Pel* s1 = p;
+  const Pel* s0 = s1 - stride;
+  const Pel* s2 = s1 + stride;
+  const Pel* s3 = s1 + 2 * stride;
+  if( ry > 0 && ( ry & vbMask ) == vbPos - 2 )      s3 = s2;   // VB: no access below the boundary
+  else if( ry > 0 && ( ry & vbMask ) == vbPos )     s0 = s1;   // VB: no access above the boundary
+
+  const int y0   = s1[0] * 2;
+  const int yup1 = s2[1] * 2;
+  v  = iabs_( y0 - s0[0]  - s2[0] ) + iabs_( yup1 - s1[1] - s3[1] );
+  h  = iabs_( y0 - s1[1]  - s1[-1]) + iabs_( yup1 - s2[2] - s2[0] );
+  d0 = iabs_( y0 - s0[-1] - s2[1] ) + iabs_( yup1 - s1[0] - s3[2] );
+  d1 = iabs_( y0 - s2[-1] - s0[1] ) + iabs_( yup1 - s3[0] - s1[2] );
+}
+
+// which of the 4 cell rows a block uses (VB: blocks touching the boundary use 3)
+ALFG_HD void cellRowRange( int y, int vbH, int vbPos, int& kBeg, int& kEnd )
+{
+  const int yb = y & ( vbH - 1 );
+  kBeg = 0; kEnd = 4;
+  if( yb == vbPos - 4 )  kEnd = 3;   // block just above the VB: drop last pair of rows
+  else if( yb == vbPos ) kBeg = 1;   // block just below the VB: drop first pair of rows
+}
+
+// class and transpose index of a 4x4 block from its summed directional activities
+//   y : global picture row of the block      shift : internal bit depth + 4
+ALFG_HD void classFromSums( int sumV, int sumH, int sumD0, int sumD1, int y, int shift, int vbH, int vbPos,
+                            int& classIdx, int& transposeIdx )
+{
+  const int yb       = y & ( vbH - 1 );
+  const int tempAct  = sumV + sumH;
+  const int mul      = ( yb == vbPos - 4 || yb == vbPos ) ? 96 : 64;
+  const int activity = clip3_( 0, 15, ( tempAct * mul ) >> shift );
+  int cls            = activityToClass( activity );
+
+  int hv1, hv0, d1, d0, dirTempHV, dirTempD;
+  if( sumV > sumH )   { hv1 = sumV;  hv0 = sumH;  dirTempHV = 1; }
+  else                { hv1 = sumH;  hv0 = sumV;  dirTempHV = 3; }
+  if( sumD0 > sumD1 ) { d1 = sumD0;  d0 = sumD1;  dirTempD  = 0; }
+  else                { d1 = sumD1;  d0 = sumD0;  dirTempD  = 2; }
+
+  int hvd1, hvd0, mainDirection, secondaryDirection;
+  // NOTE: 32-bit unsigned products, exactly as VVenC (do NOT widen to 64 bit)
+  if( ( uint32_t ) d1 * ( uint32_t ) hv0 > ( uint32_t ) hv1 * ( uint32_t ) d0 )
+  {
+    hvd1 = d1;  hvd0 = d0;  mainDirection = dirTempD;   secondaryDirection = dirTempHV;
+  }
+  else
+  {
+    hvd1 = hv1; hvd0 = hv0; mainDirection = dirTempHV;  secondaryDirection = dirTempD;
+  }
+
+  int directionStrength = 0;
+  if( hvd1 > 2 * hvd0 )     directionStrength = 1;
+  if( hvd1 * 2 > 9 * hvd0 ) directionStrength = 2;
+
+  if( directionStrength )
+  {
+    cls += ( ( ( mainDirection & 0x1 ) << 1 ) + directionStrength ) * 5;
+  }
+
+  classIdx     = cls;
+  transposeIdx = transposeLut( mainDirection * 2 + ( secondaryDirection >> 1 ) );
+}
+
+// ---------------------------------------------------------------------------
+// Classification of one 4x4 block (reference form: computes its own 16 cells).
+//   p      : pointer to the top-left sample of the block
+//   y      : global picture row of the block (multiple of 4)
+//   shift  : internal bit depth + 4
+//   vbH    : m_alfVBLumaCTUHeight (CTU height, power of 2)
+//   vbPos  : m_alfVBLumaPos (CTU height - 4)
+// Needs 3 readable samples above/left and 3 below/right of the block.
+// ---------------------------------------------------------------------------
+ALFG_HD void classifyBlock4x4( const Pel* p, ptrdiff_t stride, int y, int shift, int vbH, int vbPos,
+                               int& classIdx, int& transposeIdx )
+{
+  int kBeg, kEnd;
+  cellRowRange( y, vbH, vbPos, kBeg, kEnd );
+  int sumV = 0, sumH = 0, sumD0 = 0, sumD1 = 0;
+  for( int k = kBeg; k < kEnd; k++ )
+  {
+    for( int l = 0; l < 4; l++ )
+    {
+      int v, h, d0, d1;
+      lapCell( p + ( ptrdiff_t ) ( 2 * k - 2 ) * stride + ( 2 * l - 2 ), stride, y - 2 + 2 * k, vbH, vbPos, v, h, d0, d1 );
+      sumV += v; sumH += h; sumD0 += d0; sumD1 += d1;
+    }
+  }
+  classFromSums( sumV, sumH, sumD0, sumD1, y, shift, vbH, vbPos, classIdx, transposeIdx );
+}
+
+ALFG_HD int clipALF( int clip, int ref, int v0, int v1 )
+{
+  return clip3_( -clip, clip, v0 - ref ) + clip3_( -clip, clip, v1 - ref );
+}
+
+// ---------------------------------------------------------------------------
+// 7x7 diamond luma filter for one sample.
+//   p0      : pointer to the sample (x, y)
+//   y       : global picture row (for the VB rules)
+//   coef    : 13 coefficients of the class (coef[12] = 128 is not used as a tap)
+//   clip    : 13 clipping values of the class (actual values, e.g. 1024 for 10 bit)
+//   maxVal  : (1 << bitDepth) - 1
+// Needs 3 readable rows/columns around the sample.
+// ---------------------------------------------------------------------------
+ALFG_HD Pel filterLumaSample( const Pel* p0, ptrdiff_t stride, int y, const int16_t* coef, const int16_t* clip,
+                              int transposeIdx, int vbH, int vbPos, int maxVal )
+{
+  int fc[12], fl[12];
+
+  switch( transposeIdx )
+  {
+  case 1:
+    {
+      const int m[12] = { 9, 4, 10, 8, 1, 5, 11, 7, 3, 0, 2, 6 };
+      for( int k = 0; k < 12; k++ ) { fc[k] = coef[m[k]]; fl[k] = clip[m[k]]; }
+    }
+    break;
+  case 2:
+    {
+      const int m[12] = { 0, 3, 2, 1, 8, 7, 6, 5, 4, 9, 10, 11 };
+      for( int k = 0; k < 12; k++ ) { fc[k] = coef[m[k]]; fl[k] = clip[m[k]]; }
+    }
+    break;
+  case 3:
+    {
+      const int m[12] = { 9, 8, 10, 4, 3, 7, 11, 5, 1, 0, 2, 6 };
+      for( int k = 0; k < 12; k++ ) { fc[k] = coef[m[k]]; fl[k] = clip[m[k]]; }
+    }
+    break;
+  default:
+    for( int k = 0; k < 12; k++ ) { fc[k] = coef[k]; fl[k] = clip[k]; }
+    break;
+  }
+
+  // p1..p6 = rows y+1, y-1, y+2, y-2, y+3, y-3 (VVenC pImg1..pImg6)
+  const Pel* p1 = p0 + stride;
+  const Pel* p2 = p0 - stride;
+  const Pel* p3 = p1 + stride;
+  const Pel* p4 = p2 - stride;
+  const Pel* p5 = p3 + stride;
+  const Pel* p6 = p4 - stride;
+
+  const int yVb = y & ( vbH - 1 );
+  if( yVb < vbPos && yVb >= vbPos - 4 )        // above the virtual boundary
+  {
+    p1 = ( yVb == vbPos - 1 ) ? p0 : p1;
+    p3 = ( yVb >= vbPos - 2 ) ? p1 : p3;
+    p5 = ( yVb >= vbPos - 3 ) ? p3 : p5;
+
+    p2 = ( yVb == vbPos - 1 ) ? p0 : p2;
+    p4 = ( yVb >= vbPos - 2 ) ? p2 : p4;
+    p6 = ( yVb >= vbPos - 3 ) ? p4 : p6;
+  }
+  else if( yVb >= vbPos && yVb <= vbPos + 3 )  // below the virtual boundary
+  {
+    p2 = ( yVb == vbPos )     ? p0 : p2;
+    p4 = ( yVb <= vbPos + 1 ) ? p2 : p4;
+    p6 = ( yVb <= vbPos + 2 ) ? p4 : p6;
+
+    p1 = ( yVb == vbPos )     ? p0 : p1;
+    p3 = ( yVb <= vbPos + 1 ) ? p1 : p3;
+    p5 = ( yVb <= vbPos + 2 ) ? p3 : p5;
+  }
+  const bool nearVB = ( yVb == vbPos - 1 ) || ( yVb == vbPos );
+
+  const int curr = p0[0];
+  int sum = 0;
+  sum += fc[0]  * clipALF( fl[0],  curr, p5[ 0], p6[ 0] );
+
+  sum += fc[1]  * clipALF( fl[1],  curr, p3[+1], p4[-1] );
+  sum += fc[2]  * clipALF( fl[2],  curr, p3[ 0], p4[ 0] );
+  sum += fc[3]  * clipALF( fl[3],  curr, p3[-1], p4[+1] );
+
+  sum += fc[4]  * clipALF( fl[4],  curr, p1[+2], p2[-2] );
+  sum += fc[5]  * clipALF( fl[5],  curr, p1[+1], p2[-1] );
+  sum += fc[6]  * clipALF( fl[6],  curr, p1[ 0], p2[ 0] );
+  sum += fc[7]  * clipALF( fl[7],  curr, p1[-1], p2[+1] );
+  sum += fc[8]  * clipALF( fl[8],  curr, p1[-2], p2[+2] );
+
+  sum += fc[9]  * clipALF( fl[9],  curr, p0[+3], p0[-3] );
+  sum += fc[10] * clipALF( fl[10], curr, p0[+2], p0[-2] );
+  sum += fc[11] * clipALF( fl[11], curr, p0[+1], p0[-1] );
+
+  if( !nearVB ) sum = ( sum + ( 1 << ( kShift - 1 ) ) ) >> kShift;
+  else          sum = ( sum + ( 1 << ( kShift + 2 ) ) ) >> ( kShift + 3 );
+
+  sum += curr;
+  return ( Pel ) clip3_( 0, maxVal, sum );
+}
+
+} // namespace alfgpu
diff --git a/source/Lib/CommonLib/AlfGpuCov.h b/source/Lib/CommonLib/AlfGpuCov.h
new file mode 100644
index 0000000..e40370b
--- /dev/null
+++ b/source/Lib/CommonLib/AlfGpuCov.h
@@ -0,0 +1,231 @@
+/* -----------------------------------------------------------------------------
+AlfGpuCov.h - bit-exact ALF covariance statistics (the encoder's Wiener statistics)
+
+Reproduces EncAdaptiveLoopFilter::getPreBlkStats() + getPreBlkStatsAccum() of VVenC:
+for every 4x4 block of a CTU, in raster order,
+  ELocal[b][k][s] : the 13 (luma) / 7 (chroma) filter inputs of sample s of the block for
+                    clipping bin b (sum of the two symmetric neighbours, coefficient order
+                    given by the transpose index, rows clipped at the ALF virtual boundary),
+  yLocal[s]       : org - rec
+  E[b0][b1][k][l] += float( sum_s ELocal[b1][l][s] * ELocal[b0][k][s] )   (l >= k)
+  y[b0][k]        += float( sum_s ELocal[b0][k][s] * yLocal[s] )
+  pixAcc          += float( sum_s yLocal[s]^2 )
+into the covariance of the block's class, for a statistics unit (ASU or CTU) that is
+reset to 0 and then fed CTU by CTU (raster inside the unit).
+
+Bit-exactness: the per-block sums are integers (exact in any order); the float additions
+are done by ONE thread per (unit, element) that walks the blocks in the CPU order and adds
+into the accumulator of the block's class - the same sequence of IEEE float roundings as
+the CPU. Parallelism: units x elements (e.g. 1509 elements per luma unit with non-linear
+ALF), with the ELocal vectors of a batch of blocks computed cooperatively in shared memory.
+
+Like AlfGpuTiles.h, each kernel phase is a function used by the CUDA kernel and by the
+host simulator of the emulation backend.
+------------------------------------------------------------------------------- */
+#pragma once
+
+#include "AlfGpuCore.h"
+
+#include <vector>
+
+namespace alfgpu
+{
+
+static constexpr int CV_THREADS  = 128;   // elements per CUDA block
+static constexpr int CV_NB       = 16;    // 4x4 blocks per shared-memory batch
+static constexpr int CV_MAXBINS  = 4;
+static constexpr int CV_MAXCOEF  = 13;
+static constexpr int CV_MAXCLS   = 25;
+
+// element descriptor: kind (0 = E, 1 = y, 2 = pixAcc) | b0 | k | b1 | l
+ALFG_HD uint32_t covElem( int kind, int b0, int k, int b1, int l ) { return ( uint32_t ) ( kind << 24 | b0 << 18 | k << 12 | b1 << 6 | l ); }
+ALFG_HD int covKind( uint32_t e ) { return ( e >> 24 ) & 3; }
+ALFG_HD int covB0  ( uint32_t e ) { return ( e >> 18 ) & 63; }
+ALFG_HD int covK   ( uint32_t e ) { return ( e >> 12 ) & 63; }
+ALFG_HD int covB1  ( uint32_t e ) { return ( e >> 6 ) & 63; }
+ALFG_HD int covL   ( uint32_t e ) { return e & 63; }
+
+// element list in the order of the CPU loops: E (b0, k, b1, l >= k), y (b0, k), pixAcc
+inline std::vector<uint32_t> covElements( int numCoeff, int numBins )
+{
+  std::vector<uint32_t> v;
+  for( int b0 = 0; b0 < numBins; b0++ )
+    for( int k = 0; k < numCoeff; k++ )
+      for( int b1 = 0; b1 < numBins; b1++ )
+        for( int l = k; l < numCoeff; l++ ) v.push_back( covElem( 0, b0, k, b1, l ) );
+  for( int b0 = 0; b0 < numBins; b0++ )
+    for( int k = 0; k < numCoeff; k++ ) v.push_back( covElem( 1, b0, k, 0, 0 ) );
+  v.push_back( covElem( 2, 0, 0, 0, 0 ) );
+  return v;
+}
+
+struct CovKParams
+{
+  int numCoeff, halfLen, numBins, nonLinear, numClasses, numElem;
+  int clip[CV_MAXBINS];
+  int vbH, vbPos;
+  int recPitch, orgPitch, clsStride;   // clsStride: luma only (bytes per row of 4x4 blocks)
+  // CCALF statistics (ccalf = 1): rec = pre-ALF luma (recPitch), slf = ALF-filtered chroma (slfPitch), org = chroma
+  int ccalf, sx, sy, lumaPicH, ctuSize, slfPitch;
+};
+
+struct CovSmem
+{
+  Pel     e[CV_NB][CV_MAXBINS][CV_MAXCOEF][16];
+  Pel     y[CV_NB][16];
+  uint8_t cls[CV_NB];
+};
+
+// ELocal of one sample (VVenC calcLinCovariance4 / calcCovariance4, one column)
+ALFG_HD void covSample( Pel e[CV_MAXBINS][CV_MAXCOEF][16], int s, const Pel* r, ptrdiff_t pitch, int t, const CovKParams& k, int clipTop, int clipBot )
+{
+  const int curr = r[0];
+  const int h = k.halfLen;
+  int kk = 0;
+  auto emit = [&]( int dy0, int dx0, int dy1, int dx1 )
+  {
+    const int v0 = r[dy0 * pitch + dx0], v1 = r[dy1 * pitch + dx1];
+    if( !k.nonLinear )
+    {
+      e[0][kk][s] = ( Pel ) ( v0 + v1 - ( Pel ) ( curr << 1 ) );
+    }
+    else
+    {
+      for( int b = 0; b < k.numBins; b++ ) e[b][kk][s] = ( Pel ) ( clip3_( -k.clip[b], k.clip[b], v0 - curr ) + clip3_( -k.clip[b], k.clip[b], v1 - curr ) );
+    }
+    kk++;
+  };
+  auto top = [&]( int i ) { return i > clipTop ? i : clipTop; };          // clipIdx( i,  clipTopRow )
+  auto bot = [&]( int i ) { return -( i > -clipBot ? i : -clipBot ); };   // -clipIdx( i, -clipBotRow )
+  if( t == 0 )
+  {
+    for( int i = -h; i < 0; i++ )
+      for( int j = -h - i; j <= h + i; j++ ) emit( top( i ), j, bot( i ), -j );
+    for( int j = -h; j < 0; j++ ) emit( 0, j, 0, -j );
+  }
+  else if( t == 1 )
+  {
+    for( int j = -h; j < 0; j++ )
+      for( int i = -h - j; i <= h + j; i++ ) emit( top( i ), j, bot( i ), -j );
+    for( int i = -h; i < 0; i++ ) emit( top( i ), 0, bot( i ), 0 );
+  }
+  else if( t == 2 )
+  {
+    for( int i = -h; i < 0; i++ )
+      for( int j = h + i; j >= -h - i; j-- ) emit( top( i ), j, bot( i ), -j );
+    for( int j = -h; j < 0; j++ ) emit( 0, j, 0, -j );
+  }
+  else
+  {
+    for( int j = -h; j < 0; j++ )
+      for( int i = h + j; i >= -h - j; i-- ) emit( top( i ), j, bot( i ), -j );
+    for( int i = -h; i < 0; i++ ) emit( top( i ), 0, bot( i ), 0 );
+  }
+  for( int b = 0; b < ( k.nonLinear ? k.numBins : 1 ); b++ ) e[b][kk][s] = ( Pel ) curr;
+}
+
+// CCALF ELocal of one chroma sample (VVenC calcCovariance4CcAlf, one column): r = luma at the co-located sample
+ALFG_HD void ccSample( Pel e[CV_MAXBINS][CV_MAXCOEF][16], int s, const Pel* r, ptrdiff_t pitch, int vbDistance )
+{
+  const Pel* yM1 = r - pitch;
+  const Pel* y0  = r;
+  const Pel* yP1 = r + pitch;
+  const Pel* yP2 = r + 2 * pitch;
+  if( vbDistance == -2 || vbDistance == +1 )
+  {
+    yP2 = yP1;
+  }
+  else if( vbDistance == -1 || vbDistance == 0 )
+  {
+    yM1 = y0;
+    yP2 = yP1 = y0;
+  }
+  const Pel c = y0[0];
+  e[0][0][s] = ( Pel ) ( yM1[0]  - c );
+  e[0][1][s] = ( Pel ) ( y0[-1]  - c );
+  e[0][2][s] = ( Pel ) ( y0[+1]  - c );
+  e[0][3][s] = ( Pel ) ( yP1[-1] - c );
+  e[0][4][s] = ( Pel ) ( yP1[0]  - c );
+  e[0][5][s] = ( Pel ) ( yP1[+1] - c );
+  e[0][6][s] = ( Pel ) ( yP2[0]  - c );
+}
+
+// phase 1 (CCALF): blocks [q0, q0 + nb) of the CTU at chroma (x0, y0); rec = luma (0,0), slf / org = chroma (0,0)
+ALFG_HD void ccPhaseLoad( CovSmem& s, int tid, const CovKParams& k, const Pel* rec, const Pel* slf, const Pel* org,
+                          int x0, int y0, int bw, int q0, int nb )
+{
+  for( int i = tid; i < nb * 16; i += CV_THREADS )
+  {
+    const int blk = i >> 4, smp = i & 15, ii = smp >> 2, xx = smp & 3;
+    const int q = q0 + blk, by = q / bw, bx = q - by * bw;
+    const int px = x0 + 4 * bx + xx, py = y0 + 4 * by + ii;
+    const int ly = py << k.sy, lx = px << k.sx;
+    const int ctuY0 = ( ly / k.ctuSize ) * k.ctuSize;
+    const int vbPos = ( ctuY0 + k.ctuSize >= k.lumaPicH ) ? k.lumaPicH : k.vbPos;
+    const int vbDistance = ( ly % k.vbH ) - vbPos;
+    ccSample( s.e[blk], smp, rec + ( ptrdiff_t ) ly * k.recPitch + lx, k.recPitch, vbDistance );
+    s.y[blk][smp] = ( Pel ) ( org[( ptrdiff_t ) py * k.orgPitch + px] - slf[( ptrdiff_t ) py * k.slfPitch + px] );
+    if( smp == 0 ) s.cls[blk] = 0;
+  }
+}
+
+// phase 1: ELocal / yLocal / class of blocks [q0, q0 + nb) of the CTU at (x0, y0) with bw blocks per row
+// rec / org point to plane sample (0, 0); cls: luma class map (classIdx | transposeIdx << 5) or nullptr
+ALFG_HD void covPhaseLoad( CovSmem& s, int tid, const CovKParams& k, const Pel* rec, const Pel* org, const uint8_t* cls,
+                           int x0, int y0, int bw, int q0, int nb )
+{
+  for( int i = tid; i < nb * 16; i += CV_THREADS )
+  {
+    const int blk = i >> 4, smp = i & 15, ii = smp >> 2, xx = smp & 3;
+    const int q = q0 + blk, by = q / bw, bx = q - by * bw;
+    const int px = x0 + 4 * bx + xx, py = y0 + 4 * by + ii;
+    int clipTop = -4, clipBot = 4;
+    const int vbDistance = ( py % k.vbH ) - k.vbPos;
+    if( vbDistance >= -3 && vbDistance < 0 ) { clipBot = -vbDistance - 1; clipTop = -clipBot; }
+    else if( vbDistance >= 0 && vbDistance < 3 ) { clipTop = -vbDistance; clipBot = -clipTop; }
+    int c = 0, t = 0;
+    if( cls )
+    {
+      const uint8_t v = cls[( py >> 2 ) * k.clsStride + ( px >> 2 )];
+      c = v & 31; t = v >> 5;
+    }
+    const Pel* r = rec + ( ptrdiff_t ) py * k.recPitch + px;
+    covSample( s.e[blk], smp, r, k.recPitch, t, k, clipTop, clipBot );
+    s.y[blk][smp] = ( Pel ) ( org[( ptrdiff_t ) py * k.orgPitch + px] - r[0] );
+    if( smp == 0 ) s.cls[blk] = ( uint8_t ) c;
+  }
+}
+
+// phase 2: one element, blocks of the batch in order, float accumulation per class (CPU order)
+ALFG_HD void covPhaseAccum( const CovSmem& s, uint32_t ed, int nb, float* acc, uint32_t& usedMask )
+{
+  const int kind = covKind( ed ), b0 = covB0( ed ), kk = covK( ed ), b1 = covB1( ed ), l = covL( ed );
+  for( int blk = 0; blk < nb; blk++ )
+  {
+    int sum = 0;
+    if( kind == 0 )
+    {
+      const Pel* a = s.e[blk][b1][l];
+      const Pel* b = s.e[blk][b0][kk];
+      for( int i = 0; i < 16; i++ ) sum += int( a[i] ) * b[i];
+    }
+    else if( kind == 1 )
+    {
+      const Pel* a = s.e[blk][b0][kk];
+      for( int i = 0; i < 16; i++ ) sum += int( a[i] ) * s.y[blk][i];
+    }
+    else
+    {
+      for( int i = 0; i < 16; i++ ) sum += int( s.y[blk][i] ) * s.y[blk][i];
+    }
+    const int c = s.cls[blk];
+#if defined( __CUDA_ARCH__ )
+    acc[c] = __fadd_rn( acc[c], __int2float_rn( sum ) );
+#else
+    acc[c] = acc[c] + ( float ) sum;     // VVenC: float += int (SSE cvtsi2ss / cvtdq2ps + addss / addps)
+#endif
+    usedMask |= 1u << c;
+  }
+}
+
+} // namespace alfgpu
diff --git a/source/Lib/CommonLib/AlfGpuDerive.h b/source/Lib/CommonLib/AlfGpuDerive.h
new file mode 100644
index 0000000..d8a6e4f
--- /dev/null
+++ b/source/Lib/CommonLib/AlfGpuDerive.h
@@ -0,0 +1,714 @@
+/* -----------------------------------------------------------------------------
+AlfGpuDerive.h  -  bit-exact luma filter derivation (Wiener solve + class merging)
+                   shared by CPU (host emulation) and CUDA (device)
+
+Reproduces, operation by operation and in the same float / double precision, the
+encoder functions that dominate the ALF filter derivation of VVenC:
+  EncAdaptiveLoopFilter::mergeClasses()          greedy merging of the 25 classes
+  EncAdaptiveLoopFilter::deriveFilterCoeffs()    one Wiener filter per merged group
+  EncAdaptiveLoopFilter::deriveCoeffQuant()      quantisation + coefficient refinement
+  AlfCovariance::optimizeFilter / calculateError / gnsSolveByChol (Cholesky 13x13)
+  AlfCovariance::calcErrorForCoeffs<>, calcDiffErrorForCoeffs<>
+The parallel structure that is exploited on the GPU:
+  * all candidate pairs (i, j) of one merging step are independent  (300 Cholesky solves in step 1)
+  * the filters of all 25 "number of filters" hypotheses are independent (325 Wiener + quantisation)
+The sequential part (argmin of the merging step, rate estimation, decisions) keeps
+the CPU order (first strictly smaller cost wins).
+
+Bit-exactness rules: VVenC builds this code without FMA contraction, so the CUDA
+translation unit is compiled with --fmad=false; division and sqrt are IEEE rounded
+(nvcc defaults -prec-div=true -prec-sqrt=true), float <-> double conversions are exact.
+No VVenC headers are included.
+------------------------------------------------------------------------------- */
+#pragma once
+
+#include "AlfGpuCore.h"
+#include <cmath>
+#include <cstring>
+
+namespace alfgpu
+{
+
+static constexpr int kMergeMaxBins = 4;                       // AlfNumClippingValues
+static constexpr int kNumPairs     = kNumClasses * ( kNumClasses - 1 ) / 2;   // 300
+static constexpr int kNumHyp       = kNumClasses * ( kNumClasses + 1 ) / 2;   // 325 (numFilters, filtIdx) pairs
+static constexpr double kDblMax    = 1.7976931348623157e+308;
+
+// packed covariance of one class: E[nb][nb][13][13], y[nb][13], pixAcc, pad
+ALFG_HD int covStride( int nb ) { return nb * nb * kNumCoeff * kNumCoeff + nb * kNumCoeff + 2; }
+
+struct CovOne    // one packed covariance
+{
+  const float* p; int nb;
+  ALFG_HD float E( int b0, int b1, int k, int l ) const { return p[( ( b0 * nb + b1 ) * kNumCoeff + k ) * kNumCoeff + l]; }
+  ALFG_HD float y( int b, int k )                 const { return p[nb * nb * kNumCoeff * kNumCoeff + b * kNumCoeff + k]; }
+  ALFG_HD float pixAcc()                          const { return p[nb * nb * kNumCoeff * kNumCoeff + nb * kNumCoeff]; }
+};
+
+struct CovPair   // AlfCovariance::add( lhs, rhs ), evaluated on access (same float additions)
+{
+  CovOne a, b; int nb;
+  ALFG_HD float E( int b0, int b1, int k, int l ) const { return a.E( b0, b1, k, l ) + b.E( b0, b1, k, l ); }
+  ALFG_HD float y( int bb, int k )                const { return a.y( bb, k ) + b.y( bb, k ); }
+  ALFG_HD float pixAcc()                          const { return a.pixAcc() + b.pixAcc(); }
+};
+
+struct CovSel    // a covariance already restricted to one clip vector: E(clip[k], clip[l], k, l) = kE[k][l]
+{
+  float kE[kNumCoeff][kNumCoeff]; float ky[kNumCoeff]; float pix; int nb;
+  ALFG_HD float E( int, int, int k, int l ) const { return kE[k][l]; }
+  ALFG_HD float y( int, int k )             const { return ky[k]; }
+  ALFG_HD float pixAcc()                    const { return pix; }
+};
+
+// ------------------------------------------------------------------ Cholesky (gnsCholeskyDec / back-substitutions / solveByChol<13>)
+#define ALFG_REG     float( 0.0001 )
+#define ALFG_REG_SQR float( 0.0000001 )
+
+ALFG_HD int dCholeskyDec( const float in[kNumCoeff][kNumCoeff], float out[kNumCoeff][kNumCoeff] )
+{
+  for( int i = 0; i < kNumCoeff; i++ )
+  {
+    float invDiag = 0.0f;
+    for( int j = i; j < kNumCoeff; j++ )
+    {
+      float scale = in[i][j];
+      for( int k = i - 1; k >= 0; k-- ) scale -= out[k][j] * out[k][i];
+      if( i == j )
+      {
+        if( scale <= ALFG_REG_SQR ) return 0;
+        invDiag = float( 1.0 ) / ( out[i][i] = sqrtf( scale ) );
+      }
+      else
+      {
+        out[i][j] = scale * invDiag;
+        out[j][i] = float( 0.0 );
+      }
+    }
+  }
+  return 1;
+}
+
+ALFG_HD void dTransBack( const float U[kNumCoeff][kNumCoeff], const float* rhs, float* x )
+{
+  x[0] = rhs[0] / U[0][0];
+  for( int i = 1; i < kNumCoeff; i++ )
+  {
+    float sum = 0;
+    for( int j = 0; j < i; j++ ) sum += x[j] * U[j][i];
+    x[i] = ( rhs[i] - sum ) / U[i][i];
+  }
+}
+
+ALFG_HD void dBack( const float R[kNumCoeff][kNumCoeff], const float* z, float* A )
+{
+  const int size = kNumCoeff - 1;
+  A[size] = z[size] / R[size][size];
+  for( int i = size - 1; i >= 0; i-- )
+  {
+    float sum = 0;
+    for( int j = i + 1; j <= size; j++ ) sum += R[i][j] * A[j];
+    A[i] = ( z[i] - sum ) / R[i][i];
+  }
+}
+
+// solveByChol<13>; LHS is regularised in place when singular (as in VVenC, the caller sees the change)
+ALFG_HD int dSolveByChol( float LHS[kNumCoeff][kNumCoeff], const float* rhs, float* x )
+{
+  float aux[kNumCoeff];
+  float U[kNumCoeff][kNumCoeff];
+  if( dCholeskyDec( LHS, U ) )
+  {
+    dTransBack( U, rhs, aux );
+    dBack( U, aux, x );
+    return 1;
+  }
+  for( int i = 0; i < kNumCoeff; i++ ) LHS[i][i] += ALFG_REG;
+  if( !dCholeskyDec( LHS, U ) )
+  {
+    for( int i = 0; i < kNumCoeff; i++ ) x[i] = 0;
+    return 0;
+  }
+  dTransBack( U, rhs, aux );
+  dBack( U, aux, x );
+  return 0;
+}
+
+// ------------------------------------------------------------------ AlfCovariance members, templated on the covariance view
+template<class C>
+ALFG_HD void dSetEyFromClip( const C& c, const int* clip, float kE[kNumCoeff][kNumCoeff], float* ky )
+{
+  for( int k = 0; k < kNumCoeff; k++ )
+  {
+    ky[k] = c.y( clip[k], k );
+    for( int l = 0; l < kNumCoeff; l++ ) kE[k][l] = c.E( clip[k], clip[l], k, l );
+  }
+}
+
+template<class C>
+ALFG_HD float dCalcErrorCoef( const C& c, const int* clip, const float* coeff )
+{
+  float sum = 0;
+  for( int i = 0; i < kNumCoeff; i++ ) sum += coeff[i] * c.y( clip[i], i );
+  return c.pixAcc() - sum;
+}
+
+// AlfCovariance::calculateError( clip ) = optimizeFilter( clip, f, numCoeff )
+template<class C>
+ALFG_HD float dCalculateError( const C& c, const int* clip )
+{
+  float LHS[kNumCoeff][kNumCoeff], rhs[kNumCoeff], f[kNumCoeff];
+  dSetEyFromClip( c, clip, LHS, rhs );
+  dSolveByChol( LHS, rhs, f );
+  return dCalcErrorCoef( c, clip, f );
+}
+
+template<class C>
+ALFG_HD void dGetClipMax( const C& c, int* clip_max )
+{
+  for( int k = 0; k < kNumCoeff - 1; ++k )
+  {
+    clip_max[k] = 0;
+    bool inc = true;
+    while( inc && clip_max[k] + 1 < c.nb && c.y( clip_max[k] + 1, k ) == c.y( clip_max[k], k ) )
+    {
+      for( int l = 0; inc && l < kNumCoeff; ++l )
+        if( c.E( clip_max[k], 0, k, l ) != c.E( clip_max[k] + 1, 0, k, l ) ) inc = false;
+      if( inc ) ++clip_max[k];
+    }
+  }
+  clip_max[kNumCoeff - 1] = 0;
+}
+
+template<class C>
+ALFG_HD void dReduceClipCost( const C& c, int* clip )
+{
+  for( int k = 0; k < kNumCoeff - 1; ++k )
+  {
+    bool dec = true;
+    while( dec && clip[k] > 0 && c.y( clip[k] - 1, k ) == c.y( clip[k], k ) )
+    {
+      for( int l = 0; dec && l < kNumCoeff; ++l )
+        if( c.E( clip[k], clip[l], k, l ) != c.E( clip[k] - 1, clip[l], k, l ) ) dec = false;
+      if( dec ) --clip[k];
+    }
+  }
+}
+
+// AlfCovariance::optimizeFilter( alfShape, clip, f, optimize_clip )
+template<class C>
+ALFG_HD float dOptimizeFilter( const C& c, int* clip, float* f, bool optimize_clip )
+{
+  const int size = kNumCoeff;
+  int clip_max[kNumCoeff];
+  float err_best, err_last;
+  float kE[kNumCoeff][kNumCoeff];
+  float ky[kNumCoeff];
+
+  if( optimize_clip )
+  {
+    dGetClipMax( c, clip_max );
+    for( int k = 0; k < size; ++k )
+    {
+      clip[k] = clip_max[k] > clip[k] ? clip_max[k] : clip[k];
+      clip[k] = clip[k] < c.nb - 1 ? clip[k] : c.nb - 1;
+    }
+  }
+  dSetEyFromClip( c, clip, kE, ky );
+  dSolveByChol( kE, ky, f );
+  err_best = dCalcErrorCoef( c, clip, f );
+
+  int step = optimize_clip ? ( c.nb + 1 ) / 2 : 0;
+  while( step > 0 )
+  {
+    float err_min = err_best;
+    int idx_min = -1;
+    int inc_min = 0;
+    for( int k = 0; k < size - 1; ++k )
+    {
+      if( clip[k] - step >= clip_max[k] )
+      {
+        clip[k] -= step;
+        ky[k] = c.y( clip[k], k );
+        for( int l = 0; l < size; l++ )
+        {
+          kE[k][l] = c.E( clip[k], clip[l], k, l );
+          kE[l][k] = c.E( clip[l], clip[k], l, k );
+        }
+        dSolveByChol( kE, ky, f );
+        err_last = dCalcErrorCoef( c, clip, f );
+        if( err_last < err_min ) { err_min = err_last; idx_min = k; inc_min = -step; }
+        clip[k] += step;
+      }
+      if( clip[k] + step < c.nb )
+      {
+        clip[k] += step;
+        ky[k] = c.y( clip[k], k );
+        for( int l = 0; l < size; l++ )
+        {
+          kE[k][l] = c.E( clip[k], clip[l], k, l );
+          kE[l][k] = c.E( clip[l], clip[k], l, k );
+        }
+        dSolveByChol( kE, ky, f );
+        err_last = dCalcErrorCoef( c, clip, f );
+        if( err_last < err_min ) { err_min = err_last; idx_min = k; inc_min = step; }
+        clip[k] -= step;
+      }
+      ky[k] = c.y( clip[k], k );
+      for( int l = 0; l < size; l++ )
+      {
+        kE[k][l] = c.E( clip[k], clip[l], k, l );
+        kE[l][k] = c.E( clip[l], clip[k], l, k );
+      }
+    }
+    if( idx_min >= 0 )
+    {
+      err_best = err_min;
+      clip[idx_min] += inc_min;
+      ky[idx_min] = c.y( clip[idx_min], idx_min );
+      for( int l = 0; l < size; l++ )
+      {
+        kE[idx_min][l] = c.E( clip[idx_min], clip[l], idx_min, l );
+        kE[l][idx_min] = c.E( clip[l], clip[idx_min], l, idx_min );
+      }
+    }
+    else
+    {
+      --step;
+    }
+  }
+
+  if( optimize_clip )
+  {
+    for( int k = 0; k < size - 1; ++k ) clip_max[k] = 0;
+    float kE_max[kNumCoeff][kNumCoeff];
+    float ky_max[kNumCoeff];
+    dSetEyFromClip( c, clip_max, kE_max, ky_max );
+    dSolveByChol( kE_max, ky_max, f );
+    err_last = dCalcErrorCoef( c, clip_max, f );
+    if( err_last < err_best )
+    {
+      err_best = err_last;
+      for( int k = 0; k < size; ++k ) clip[k] = clip_max[k];
+    }
+    else
+    {
+      dReduceClipCost( c, clip );
+      dSolveByChol( kE, ky, f );
+    }
+  }
+  return err_best;
+}
+
+// ------------------------------------------------------------------ error of integer coefficients (calcErrorForCoeffs<>, 13 taps)
+// linear: calcErrorForCoeffsLin_13 (scalar mirror of the SSE version, same order); uses E[0][0], y[0]
+template<class C>
+ALFG_HD float dErrLin13( const C& c, const int* coeff, const float invFactor )
+{
+  float vE1[4], vE5[4], vE9[4], vSum[4][4], verror[4], error;
+  int i, n;
+  for( i = 0; i < 4; i++ )
+  {
+    for( n = 0; n < 4; n++ ) vE1[n] = 0;
+    for( n = i; n < 4; n++ ) vE1[n] = c.E( 0, 0, i, n + 1 ) * coeff[n + 1];
+    for( n = 0; n < 4; n++ )
+    {
+      vE5[n] = c.E( 0, 0, i, n + 5 ) * coeff[n + 5];
+      vE9[n] = c.E( 0, 0, i, n + 9 ) * coeff[n + 9];
+      vSum[i][n] = vE1[n] + vE5[n] + vE9[n];
+    }
+  }
+  for( n = 0; n < 4; n++ )
+  {
+    vSum[0][n] = vSum[n >> 1][( n & 1 ) << 1] + vSum[n >> 1][( ( n & 1 ) << 1 ) + 1];
+    vSum[2][n] = vSum[( n >> 1 ) + 2][( n & 1 ) << 1] + vSum[( n >> 1 ) + 2][( ( n & 1 ) << 1 ) + 1];
+  }
+  for( n = 0; n < 4; n++ )
+  {
+    vSum[0][n] = vSum[( n >> 1 ) << 1][( n & 1 ) << 1] + vSum[( n >> 1 ) << 1][( ( n & 1 ) << 1 ) + 1];
+    vE1[n] = ( ( ( c.E( 0, 0, n, n ) * coeff[n] ) + ( vSum[0][n] * 2 ) ) * invFactor ) - ( c.y( 0, n ) * 2 );
+    verror[n] = vE1[n] * coeff[n];
+  }
+  for( i = 0; i < 4; i++ )
+  {
+    for( n = 0; n < 4; n++ ) vE5[n] = 0;
+    for( n = i; n < 4; n++ ) vE5[n] = c.E( 0, 0, i + 4, n + 5 ) * coeff[n + 5];
+    for( n = 0; n < 4; n++ )
+    {
+      vE9[n] = c.E( 0, 0, i + 4, n + 9 ) * coeff[n + 9];
+      vSum[i][n] = vE5[n] + vE9[n];
+    }
+  }
+  for( n = 0; n < 4; n++ )
+  {
+    vSum[0][n] = vSum[n >> 1][( n & 1 ) << 1] + vSum[n >> 1][( ( n & 1 ) << 1 ) + 1];
+    vSum[2][n] = vSum[( n >> 1 ) + 2][( n & 1 ) << 1] + vSum[( n >> 1 ) + 2][( ( n & 1 ) << 1 ) + 1];
+  }
+  for( n = 0; n < 4; n++ )
+  {
+    vSum[0][n] = vSum[( n >> 1 ) << 1][( n & 1 ) << 1] + vSum[( n >> 1 ) << 1][( ( n & 1 ) << 1 ) + 1];
+    vE1[n] = ( ( ( c.E( 0, 0, n + 4, n + 4 ) * coeff[n + 4] ) + ( vSum[0][n] * 2 ) ) * invFactor ) - ( c.y( 0, n + 4 ) * 2 );
+    verror[n] = verror[n] + vE1[n] * coeff[n + 4];
+  }
+  for( i = 0; i < 4; i++ )
+  {
+    for( n = 0; n < 4; n++ ) vE9[n] = 0;
+    for( n = i; n < 4; n++ ) vE9[n] = c.E( 0, 0, i + 8, n + 9 ) * coeff[n + 9];
+    for( n = 0; n < 4; n++ ) vSum[i][n] = vE9[n];
+  }
+  for( n = 0; n < 4; n++ )
+  {
+    vSum[0][n] = vSum[n >> 1][( n & 1 ) << 1] + vSum[n >> 1][( ( n & 1 ) << 1 ) + 1];
+    vSum[2][n] = vSum[( n >> 1 ) + 2][( n & 1 ) << 1] + vSum[( n >> 1 ) + 2][( ( n & 1 ) << 1 ) + 1];
+  }
+  for( n = 0; n < 4; n++ )
+  {
+    vSum[0][n] = vSum[( n >> 1 ) << 1][( n & 1 ) << 1] + vSum[( n >> 1 ) << 1][( ( n & 1 ) << 1 ) + 1];
+    vE1[n] = ( ( ( c.E( 0, 0, n + 8, n + 8 ) * coeff[n + 8] ) + ( vSum[0][n] * 2 ) ) * invFactor ) - ( c.y( 0, n + 8 ) * 2 );
+    verror[n] = verror[n] + vE1[n] * coeff[n + 8];
+  }
+  verror[0] = verror[0] + verror[1];
+  verror[2] = verror[2] + verror[3];
+  error = verror[0] + verror[2];
+  error += ( ( c.E( 0, 0, 12, 12 ) * coeff[12] ) * invFactor - 2 * c.y( 0, 12 ) ) * coeff[12];
+  return error * invFactor;
+}
+
+// non-linear: calcErrorForCoeffsNonLin<13>
+template<class C>
+ALFG_HD float dErrNonLin13( const C& c, const int* clip, const int* coeff, const float invFactor )
+{
+  float error = 0;
+  for( int i = 0; i < kNumCoeff; i++ )
+  {
+    float sum = 0;
+    for( int j = i + 1; j < kNumCoeff; j++ ) sum += c.E( clip[i], clip[j], i, j ) * coeff[j];
+    error += ( ( c.E( clip[i], clip[i], i, i ) * coeff[i] + sum * 2 ) * invFactor - 2 * c.y( clip[i], i ) ) * coeff[i];
+  }
+  return error * invFactor;
+}
+
+template<class C>
+ALFG_HD float dDiffErr( const C& c, bool doClip, const int* clip, const int* coeff, const int coeffBefore, const int coeffAfter, const int coeffPos, const float invFactor )
+{
+  float error = 0;
+  const int coeffDiff = coeffAfter - coeffBefore;
+  for( int i = 0; i < kNumCoeff; i++ )
+  {
+    const int ci = doClip ? clip[i] : 0;
+    if( i == coeffPos )
+    {
+      float sum = 0;
+      for( int j = i + 1; j < kNumCoeff; j++ ) sum += c.E( ci, doClip ? clip[j] : 0, i, j ) * coeff[j];
+      error += ( invFactor * sum - c.y( ci, i ) ) * coeffDiff * 2;
+      error += invFactor * ( c.E( ci, ci, i, i ) * ( coeffAfter * coeffAfter - coeffBefore * coeffBefore ) );
+      break;
+    }
+    else
+    {
+      for( int j = i + 1; j < kNumCoeff; j++ )
+        if( j == coeffPos ) error += 2 * invFactor * c.E( ci, doClip ? clip[j] : 0, i, j ) * coeffDiff * coeff[i];
+    }
+  }
+  return error * invFactor;
+}
+
+// EncAdaptiveLoopFilter::deriveCoeffQuant( clip, coeffQuant, cov, shape(13), bitDepth, optimizeClip = false )
+template<class C>
+ALFG_HD double dDeriveCoeffQuant( const C& cov, int* filterClipp, int* filterCoeffQuant, const int bitDepth, const bool doClip )
+{
+  const int factor = 1 << ( bitDepth - 1 );
+  const int max_value = factor - 1;
+  const int min_value = -factor + 1;
+  const float invFactor = float( 1.0 / ( ( double ) factor ) );
+  float filterCoeff[kNumCoeff];
+
+  dOptimizeFilter( cov, filterClipp, filterCoeff, false );
+  for( int i = 0; i < kNumCoeff; i++ )   // roundFiltCoeff
+  {
+    const int sign = filterCoeff[i] > 0 ? 1 : -1;
+    filterCoeffQuant[i] = int( filterCoeff[i] * sign * factor + 0.5 ) * sign;
+  }
+  for( int i = 0; i < kNumCoeff - 1; i++ )
+  {
+    int v = filterCoeffQuant[i] > min_value ? filterCoeffQuant[i] : min_value;
+    filterCoeffQuant[i] = max_value < v ? max_value : v;
+  }
+  filterCoeffQuant[kNumCoeff - 1] = 0;
+
+  int modified = 1;
+  double errRef = doClip ? dErrNonLin13( cov, filterClipp, filterCoeffQuant, invFactor ) : dErrLin13( cov, filterCoeffQuant, invFactor );
+  while( modified )
+  {
+    modified = 0;
+    for( int sign = 1; sign >= -1; sign -= 2 )
+    {
+      double errMin = kDblMax;
+      int minInd = -1;
+      for( int k = 0; k < kNumCoeff - 1; k++ )
+      {
+        if( filterCoeffQuant[k] - sign > max_value || filterCoeffQuant[k] - sign < min_value ) continue;
+        double error = errRef + dDiffErr( cov, doClip, filterClipp, filterCoeffQuant, filterCoeffQuant[k], filterCoeffQuant[k] - sign, k, invFactor );
+        if( error < errMin ) { errMin = error; minInd = k; }
+      }
+      if( errMin < errRef )
+      {
+        filterCoeffQuant[minInd] -= sign;
+        modified++;
+        errRef = errMin;
+      }
+    }
+  }
+  return errRef;
+}
+
+// ------------------------------------------------------------------ merging (mergeClasses) building blocks
+struct MergeJob
+{
+  int nb;          // covariance bins in use: nonLinearFlag ? 4 : 1
+  int nonLinear;   // m_alfParamTemp.nonLinearFlag[CH_L]: clip optimisation while merging
+  int doClip;      // m_useNonLinearAlfLuma || m_useNonLinearAlfChroma: calcErrorForCoeffs<true> variant
+  int bitDepth;    // m_NUM_BITS
+  const float* cov;   // kNumClasses * covStride( nb ) floats (m_alfCovarianceFrame[CH_L])
+};
+
+struct MergeResult
+{
+  int16_t filterIdx[kNumClasses][kNumClasses];             // m_filterIndices
+  int16_t coeff    [kNumClasses][kNumClasses][kNumCoeff];  // [numFilters-1][filtIdx]: m_filterCoeffSet of deriveFilterCoeffs()
+  int8_t  clip     [kNumClasses][kNumClasses][kNumCoeff];  // [numFilters-1][filtIdx]: m_filterClippSet
+  float   errTab   [kNumClasses][kNumClasses][2];          // [numFilters-1][filtIdx]: errorTabForce0Coeff
+};
+
+ALFG_HD void pairOfIndex( int p, int& i, int& j )   // p-th pair (i < j) in the CPU loop order
+{
+  i = 0;
+  int n = kNumClasses - 1;
+  while( p >= n ) { p -= n; i++; n--; }
+  j = i + 1 + p;
+}
+
+ALFG_HD void hypOfIndex( int t, int& numFilters, int& filtIdx )   // t-th (numFilters, filtIdx), filtIdx < numFilters
+{
+  numFilters = 1;
+  while( t >= numFilters ) { t -= numFilters; numFilters++; }
+  filtIdx = t;
+}
+
+// error of a merged pair (tmpCov.add + calculateError / optimizeFilterClip); clip in: merged clip, out: optimised clip
+ALFG_HD float mergePairError( const float* covMerged, int nb, int i, int j, int nonLinear, int* clip )
+{
+  const int s = covStride( nb );
+  CovPair c{ CovOne{ covMerged + i * s, nb }, CovOne{ covMerged + j * s, nb }, nb };
+  if( nonLinear ) { float f[kNumCoeff]; return dOptimizeFilter( c, clip, f, true ); }
+  return dCalculateError( c, clip );
+}
+
+ALFG_HD float mergeClassError( const float* covMerged, int nb, int i, int nonLinear, int* clip )
+{
+  CovOne c{ covMerged + i * covStride( nb ), nb };
+  if( nonLinear ) { float f[kNumCoeff]; return dOptimizeFilter( c, clip, f, true ); }
+  return dCalculateError( c, clip );
+}
+
+// one filter of deriveFilterCoeffs() for the hypothesis numFilters: sum of the classes of the group in class order
+ALFG_HD void deriveOneFilter( const float* cov, int nb, const int16_t* filterIndices /*[25] of numFilters-1*/,
+                              const int8_t* clipLevel /*[25][13] clipMerged[numFilters-1]*/, int filtIdx, int bitDepth, int doClip,
+                              int16_t* outCoeff, int8_t* outClip, float* outErr )
+{
+  int clip[kNumCoeff];
+  for( int k = 0; k < kNumCoeff; k++ ) clip[k] = 0;
+  for( int c = 0; c < kNumClasses; c++ )   // clip of the first class of the group (deriveFilterCoeffs: found_clip)
+    if( filterIndices[c] == filtIdx ) { for( int k = 0; k < kNumCoeff; k++ ) clip[k] = clipLevel[c * kNumCoeff + k]; break; }
+  CovSel sel;
+  sel.nb = nb;
+  sel.pix = 0;
+  for( int k = 0; k < kNumCoeff; k++ ) { sel.ky[k] = 0; for( int l = 0; l < kNumCoeff; l++ ) sel.kE[k][l] = 0; }
+  const int s = covStride( nb );
+  for( int c = 0; c < kNumClasses; c++ )
+  {
+    if( filterIndices[c] != filtIdx ) continue;
+    CovOne one{ cov + c * s, nb };
+    for( int k = 0; k < kNumCoeff; k++ )
+    {
+      sel.ky[k] += one.y( clip[k], k );
+      for( int l = 0; l < kNumCoeff; l++ ) sel.kE[k][l] += one.E( clip[k], clip[l], k, l );
+    }
+    sel.pix += one.pixAcc();
+  }
+  int q[kNumCoeff];
+  const double e = dDeriveCoeffQuant( sel, clip, q, bitDepth, doClip != 0 );
+  outErr[1] = float( sel.pix + e );
+  outErr[0] = sel.pix;
+  for( int k = 0; k < kNumCoeff; k++ ) { outCoeff[k] = ( int16_t ) q[k]; outClip[k] = ( int8_t ) clip[k]; }
+}
+
+// filterIndices of the level numRemaining-1 from indexList (tail of the merging step)
+ALFG_HD void mergeFilterIndices( const uint8_t* indexList, int16_t* filterIndicesLevel )
+{
+  uint8_t tmp[kNumClasses];
+  for( int i = 0; i < kNumClasses; i++ ) tmp[i] = indexList[i];
+  int ind = 0;
+  for( int j = 0; j < kNumClasses; j++ )
+  {
+    bool exist = false;
+    for( int i = 0; i < kNumClasses; i++ ) if( tmp[i] == j ) { exist = true; break; }
+    if( exist )
+    {
+      for( int i = 0; i < kNumClasses; i++ ) if( tmp[i] == j ) { filterIndicesLevel[i] = ( int16_t ) ind; tmp[i] = ( uint8_t ) -1; }
+      ind++;
+    }
+  }
+}
+
+// ------------------------------------------------------------------ merging kernel, as phases separated by block barriers
+// One CUDA block (MG_THREADS threads) runs the whole greedy merging of mergeClasses():
+//   per step: the candidate pairs are evaluated in parallel (only pairs that involve the class merged in the previous
+//   step are re-evaluated: the others have the same inputs, hence the same float result), the best pair is found by a
+//   tree reduction with the CPU tie-break (smallest cost, then first pair in loop order), and the merge itself
+//   (covariance sum, clip copy, index lists) is applied. The host emulation runs the same phases thread by thread.
+static constexpr int MG_THREADS = 256;
+
+struct MergeSmem
+{
+  double  err[kNumClasses];
+  uint8_t avail[kNumClasses];
+  uint8_t indexList[kNumClasses];
+  float   pairErr[kNumPairs];
+  int8_t  pairClip[kNumPairs][kNumCoeff];
+  double  redE[MG_THREADS];
+  int     redP[MG_THREADS];
+  int     b1, b2, last, nr;
+  double  bestErr;
+  int8_t  bestClip[kNumCoeff];
+};
+
+struct MergeBufs                 // device (or host-emulation) working memory of one call
+{
+  const float* cov;              // input: kNumClasses * covStride( nb )
+  float*       covMerged;        // working copy of the covariances (merged in place)
+  int8_t*      clipMerged;       // [kNumClasses levels][kNumClasses][kNumCoeff]
+  MergeResult* res;
+};
+
+ALFG_HD void mgPhaseInit( MergeSmem& s, int tid, const MergeJob& j, const MergeBufs& b )
+{
+  const int n = kNumClasses * covStride( j.nb );
+  for( int e = tid; e < n; e += MG_THREADS ) b.covMerged[e] = b.cov[e];
+  for( int e = tid; e < kNumClasses * kNumClasses; e += MG_THREADS ) ( &b.res->filterIdx[0][0] )[e] = 0;
+  if( tid == 0 ) { s.last = -1; s.nr = kNumClasses; s.bestErr = kDblMax; for( int k = 0; k < kNumCoeff; k++ ) s.bestClip[k] = 0; }
+}
+
+ALFG_HD void mgPhaseClasses( MergeSmem& s, int tid, const MergeJob& j, const MergeBufs& b )
+{
+  if( tid >= kNumClasses ) return;
+  b.res->filterIdx[kNumClasses - 1][tid] = ( int16_t ) tid;
+  s.indexList[tid] = ( uint8_t ) tid;
+  s.avail[tid] = 1;
+  int clip[kNumCoeff];
+  for( int k = 0; k < kNumCoeff; k++ ) clip[k] = j.nonLinear ? kMergeMaxBins / 2 : 0;
+  s.err[tid] = ( double ) mergeClassError( b.covMerged, j.nb, tid, j.nonLinear, clip );
+  int8_t* cm = b.clipMerged + ( ( kNumClasses - 1 ) * kNumClasses + tid ) * kNumCoeff;
+  for( int k = 0; k < kNumCoeff; k++ ) cm[k] = ( int8_t ) clip[k];
+}
+
+ALFG_HD void mgPhasePairs( MergeSmem& s, int tid, const MergeJob& j, const MergeBufs& b )
+{
+  const int nr = s.nr, last = s.last;
+  for( int p = tid; p < kNumPairs; p += MG_THREADS )
+  {
+    int i, k;
+    pairOfIndex( p, i, k );
+    if( !s.avail[i] || !s.avail[k] ) continue;
+    if( last >= 0 && i != last && k != last ) continue;   // unchanged inputs: cached result
+    const int8_t* ci = b.clipMerged + ( ( nr - 1 ) * kNumClasses + i ) * kNumCoeff;
+    const int8_t* ck = b.clipMerged + ( ( nr - 1 ) * kNumClasses + k ) * kNumCoeff;
+    int clip[kNumCoeff];
+    for( int l = 0; l < kNumCoeff; l++ ) clip[l] = ( ci[l] + ck[l] + 1 ) >> 1;
+    s.pairErr[p] = mergePairError( b.covMerged, j.nb, i, k, j.nonLinear, clip );
+    for( int l = 0; l < kNumCoeff; l++ ) s.pairClip[p][l] = ( int8_t ) clip[l];
+  }
+}
+
+ALFG_HD bool mgBetter( double e, int p, double be, int bp )   // CPU order: strictly smaller cost, ties -> earlier pair
+{
+  if( p < 0 ) return false;
+  if( bp < 0 ) return true;
+  return e < be || ( e == be && p < bp );
+}
+
+ALFG_HD void mgPhaseLocalMin( MergeSmem& s, int tid )
+{
+  double be = kDblMax;
+  int bp = -1;
+  for( int p = tid; p < kNumPairs; p += MG_THREADS )
+  {
+    int i, k;
+    pairOfIndex( p, i, k );
+    if( !s.avail[i] || !s.avail[k] ) continue;
+    const double e = ( double ) s.pairErr[p] - s.err[i] - s.err[k];
+    if( e < be ) { be = e; bp = p; }                       // also rejects NaN and values >= DBL_MAX, as the CPU
+  }
+  s.redE[tid] = be;
+  s.redP[tid] = bp;
+}
+
+ALFG_HD void mgPhaseReduce( MergeSmem& s, int tid, int stride )
+{
+  if( tid < stride && mgBetter( s.redE[tid + stride], s.redP[tid + stride], s.redE[tid], s.redP[tid] ) )
+  {
+    s.redE[tid] = s.redE[tid + stride];
+    s.redP[tid] = s.redP[tid + stride];
+  }
+}
+
+ALFG_HD void mgPhaseSelect( MergeSmem& s, int tid )
+{
+  if( tid ) return;
+  const int bp = s.redP[0];
+  s.b1 = 0; s.b2 = 1;
+  if( bp >= 0 )
+  {
+    pairOfIndex( bp, s.b1, s.b2 );
+    s.bestErr = ( double ) s.pairErr[bp];
+    for( int l = 0; l < kNumCoeff; l++ ) s.bestClip[l] = s.pairClip[bp][l];
+  }
+}
+
+ALFG_HD void mgPhaseApply( MergeSmem& s, int tid, const MergeJob& j, const MergeBufs& b )
+{
+  const int st = covStride( j.nb ), b1 = s.b1, b2 = s.b2, nr = s.nr;
+  float* d = b.covMerged + b1 * st;
+  const float* a = b.covMerged + b2 * st;
+  for( int e = tid; e < st - 1; e += MG_THREADS ) d[e] = d[e] + a[e];          // operator+= (E, y, pixAcc)
+  int8_t* dst = b.clipMerged + ( nr - 2 ) * kNumClasses * kNumCoeff;
+  const int8_t* src = b.clipMerged + ( nr - 1 ) * kNumClasses * kNumCoeff;
+  for( int e = tid; e < kNumClasses * kNumCoeff; e += MG_THREADS ) dst[e] = ( e / kNumCoeff == b1 ) ? s.bestClip[e % kNumCoeff] : src[e];
+}
+
+ALFG_HD void mgPhaseBook( MergeSmem& s, int tid, const MergeBufs& b )
+{
+  if( tid ) return;
+  const int b1 = s.b1, b2 = s.b2;
+  s.err[b1] = s.bestErr;
+  s.avail[b2] = 0;
+  for( int i = 0; i < kNumClasses; i++ ) if( s.indexList[i] == b2 ) s.indexList[i] = ( uint8_t ) b1;
+  s.nr--;
+  mergeFilterIndices( s.indexList, b.res->filterIdx[s.nr - 1] );
+  s.last = b1;
+}
+
+// kernel 2: one thread per hypothesis (numFilters, filtIdx)
+ALFG_HD void mgDeriveHyp( int t, const MergeJob& j, const MergeBufs& b )
+{
+  if( t >= kNumHyp ) return;
+  int nf, f;
+  hypOfIndex( t, nf, f );
+  deriveOneFilter( b.cov, j.nb, b.res->filterIdx[nf - 1], b.clipMerged + ( nf - 1 ) * kNumClasses * kNumCoeff, f, j.bitDepth, j.doClip,
+                   b.res->coeff[nf - 1][f], b.res->clip[nf - 1][f], b.res->errTab[nf - 1][f] );
+}
+
+// host emulation of the two kernels (same phases, threads run one after the other)
+void hostMergeFilters( const MergeJob& job, const MergeBufs& bufs );
+
+} // namespace alfgpu
