+
+void AlfProfiler::stop()
+{
+  if( m_verSamples || m_verBlocks || m_verCov || m_verMerge || m_verCc )
+  {
+    // verification is reported even without --AlfProf
+    const bool err = m_verSampleErr || m_verBlockErr || m_verCovErr || m_verMergeErr || m_verCcErr;
+    fprintf( stderr, "[AlfGpu] VERIFY: %" PRIu64 " samples, %" PRIu64 " mismatches | %" PRIu64 " 4x4 classes, %" PRIu64 " mismatches | %" PRIu64
+                     " covariance values, %" PRIu64 " mismatches | %" PRIu64 " derivation values (merge/Wiener), %" PRIu64 " mismatches | %" PRIu64
+                     " CCALF statistics values, %" PRIu64 " mismatches -> %s\n",
+             m_verSamples, m_verSampleErr, m_verBlocks, m_verBlockErr, m_verCov, m_verCovErr, m_verMerge, m_verMergeErr, m_verCc, m_verCcErr,
+             err ? "NOT BIT-EXACT" : "BIT-EXACT" );
+  }
+  if( !m_enabled ) return;
+  m_t1Real = std::chrono::steady_clock::now();
+  m_t1 = m_t1Real - std::chrono::duration_cast<std::chrono::steady_clock::duration>( std::chrono::duration<double>( m_excludedS ) );
+  m_cpuUJ1 = m_rapl.ok() ? m_rapl.readUJ() - m_excludedUJ : 0;
+  if( m_samplerRun ) { m_samplerRun = false; if( m_samplerThread.joinable() ) m_samplerThread.join(); }
+  if( m_backend && m_gpuEnergyOk )
+  {
+    unsigned long long e;
+    if( m_backend->readEnergy_mJ( e ) ) m_gpuE1 = e; else m_gpuEnergyOk = false;
+  }
+  report( stderr );
+  if( const char* csv = getenv( "VVENC_ALF_PROF_CSV" ) )
+  {
+    FILE* f = fopen( csv, "a" );
+    if( f )
+    {
+      fseek( f, 0, SEEK_END );
+      if( ftell( f ) == 0 )
+      {
+        fprintf( f, "label,backend,mode,enc_s,stats_ms,derive_ms,recon_ms,luma_cpu_ms,luma_gpu_ms,ccalf_ms,"
+                    "gpu_calls,pack_ms,h2d_ms,classify_ms,filter_ms,d2h_ms,unpack_ms,gpu_total_ms,bytes_h2d,bytes_d2h,"
+                    "cpu_pkg_J,cpu_idle_W,alf_scope_cpu_J,gpu_J,gpu_idle_W,gpu_sampled_J,gpu_peak_W,gpu_span_ms,gpu_chunks,class_cpu_ms,alf_pictures,enc_pictures,class_gpu_ms,whole_alf_ms,whole_alf_wall_ms,whole_alf_cpu_J,whole_alf_gpu_J,cov_cpu_ms,cov_gpu_ms,cov_kernel_ms,"
+                    "der_accum_ms,der_enc_y_ms,der_enc_c_ms,der_ctbflags_ms,der_ctbflags_dist_ms,der_framestats_ms,der_merge_ms,der_wiener_cpu_ms,der_ctb_ms,der_ctb_dist_ms,der_gpu_ms,der_aps_ms,"
+                    "ccalf_stats_ms,ccalf_stats_cpu_ms,ccalf_stats_gpu_ms,ccalf_derive_ms,ccalf_der_dist_ms,ccalf_recon_ms,dist_kernel_ms,ccalf_kernel_ms\n" );
+      }
+      const char* label = getenv( "VVENC_ALF_PROF_LABEL" );
+      double wholeMs = 0, wholeUJ = 0;
+      for( int st = 0; st < ALFP_NUM; st++ ) if( alfProfTopLevel( st ) ) { wholeMs += m_stageMs[st]; wholeUJ += m_stageUJ[st]; }
+      const double wholeCpuJ = m_rapl.ok() ? wholeUJ * 1e-6 : -1.0;
+      const double encS = std::chrono::duration<double>( m_t1 - m_t0 ).count();
+      fprintf( f, "%s,%s,%d,%.6f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%" PRIu64 ",%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%" PRIu64 ",%" PRIu64 ",%.4f,%.3f,%.4f,%.4f,%.3f,%.4f,%.2f,%.3f,%d,%.3f,%d,%d,%.3f,%.3f,%.3f,%.5f,%.5f,%.3f,%.3f,%.3f",
+               label ? label : "", m_backend ? m_backend->name() : "cpu", m_gpuMode, encS,
+               m_stageMs[ALFP_STATS], m_stageMs[ALFP_DERIVE], m_stageMs[ALFP_RECON], m_stageMs[ALFP_RECON_LUMA_CPU], m_stageMs[ALFP_RECON_LUMA_GPU],
+               m_stageMs[ALFP_CCALF_STATS] + m_stageMs[ALFP_CCALF_DERIVE] + m_stageMs[ALFP_CCALF_RECON],
+               m_gpuCalls, m_gpu.hostPackMs, m_gpu.h2dMs, m_gpu.classifyMs, m_gpu.filterMs, m_gpu.d2hMs, m_gpu.hostUnpackMs, m_gpu.totalMs,
+               m_gpu.bytesH2D, m_gpu.bytesD2H,
+               ( m_cpuUJ1 - m_cpuUJ0 ) * 1e-6, m_cpuIdleW,
+               ( m_stageUJ[ALFP_STATS] + m_stageUJ[ALFP_DERIVE] + m_stageUJ[ALFP_RECON] ) * 1e-6,
+               m_gpuEnergyOk ? ( m_gpuE1 - m_gpuE0 ) * 1e-3 : -1.0, m_gpuIdleW, m_gpuSampledJ, m_gpuPeakW,
+               m_gpu.gpuSpanMs, ( int ) m_gpu.chunks, m_stageMs[ALFP_STATS_CLASS_CPU], ( int ) m_alfPictures,
+               ( int ) m_encPictures, m_stageMs[ALFP_STATS_CLASS_GPU], wholeMs, alfActiveS() * 1e3, wholeCpuJ, m_backend ? m_gpuAlfJ : -1.0,
+               m_stageMs[ALFP_STATS_COV_CPU], m_stageMs[ALFP_STATS_COV_GPU], m_gpu.covMs );
+      fprintf( f, ",%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f\n",
+               m_stageMs[ALFP_DER_ACCUM], m_stageMs[ALFP_DER_ENC_Y], m_stageMs[ALFP_DER_ENC_C], m_stageMs[ALFP_DER_CTBFLAGS], m_stageMs[ALFP_DER_CTBFLAGS_DIST],
+               m_stageMs[ALFP_DER_FRAMESTATS], m_stageMs[ALFP_DER_MERGE], m_stageMs[ALFP_DER_WIENER_CPU], m_stageMs[ALFP_DER_CTB], m_stageMs[ALFP_DER_CTB_DIST], m_stageMs[ALFP_DER_GPU], m_stageMs[ALFP_DER_APS],
+               m_stageMs[ALFP_CCALF_STATS], m_stageMs[ALFP_CCALF_STATS_CPU], m_stageMs[ALFP_CCALF_STATS_GPU], m_stageMs[ALFP_CCALF_DERIVE], m_stageMs[ALFP_CCALF_DER_DIST],
+               m_stageMs[ALFP_CCALF_RECON], m_gpu.distMs, m_gpu.ccalfMs );
+      fclose( f );
+    }
+  }
+}
+
+void AlfProfiler::report( FILE* f )
+{
+  const double encS  = std::chrono::duration<double>( m_t1 - m_t0 ).count();
+  const double encMs = encS * 1e3;
+  static const char* names[ALFP_NUM] = { "ALF stats (class+cov)", "  luma classif. CPU", "  luma classif. GPU call", "  covariance CPU", "  covariance GPU call", "ALF derive filter", "ALF reconstruct (Y+C)",
+                                          "  luma filter CPU", "  luma filter GPU call", "CCALF stats", "CCALF derive", "CCALF reconstruct",
+                                          "orig. prefetch (GPU)", "  accumulate stats", "  alfEncoder luma", "  alfEncoder chroma", "    CTU on/off", "      filtered dist.", "    frame stats", "    Wiener/merge total",
+                                          "      merge+Wiener CPU", "  filter-set decision", "    filter-set dist.", "      merge+Wiener GPU call", "  APS reconstruction", "  CCALF stats CPU", "  CCALF stats GPU call (in derive)", "  CCALF dist." };
+  static_assert( ALFP_NUM == 28, "update names[] / order[]" );
+  // display order: every fine scope directly below its parent stage
+  static const int order[ALFP_NUM] = { ALFP_STATS, ALFP_STATS_CLASS_CPU, ALFP_STATS_CLASS_GPU, ALFP_STATS_COV_CPU, ALFP_STATS_COV_GPU,
+                                       ALFP_DERIVE, ALFP_DER_ACCUM, ALFP_DER_ENC_Y, ALFP_DER_ENC_C, ALFP_DER_CTBFLAGS, ALFP_DER_CTBFLAGS_DIST, ALFP_DER_FRAMESTATS, ALFP_DER_MERGE,
+                                       ALFP_DER_WIENER_CPU, ALFP_DER_GPU, ALFP_DER_CTB, ALFP_DER_CTB_DIST, ALFP_DER_APS,
+                                       ALFP_RECON, ALFP_RECON_LUMA_CPU, ALFP_RECON_LUMA_GPU,
+                                       ALFP_CCALF_STATS, ALFP_CCALF_STATS_CPU, ALFP_CCALF_DERIVE, ALFP_CCALF_STATS_GPU, ALFP_CCALF_DER_DIST, ALFP_CCALF_RECON,
+                                       ALFP_PREFETCH };
+
+  fprintf( f, "\n================ ALF profile ================\n" );
+  fprintf( f, "backend: %s | AlfGpu mode: %d | encoder wall time: %.3f s\n", m_backend ? m_backend->name() : "cpu (VVenC)", m_gpuMode, encS );
+  fprintf( f, "(stage times are summed over encoder threads; run with --Threads 0 or 1 for a clean single-thread profile)\n\n" );
+  fprintf( f, "%-24s %8s %12s %8s %12s %12s\n", "stage", "calls", "time [ms]", "% enc", "avg [ms]", "RAPL [J]" );
+  double alfMs = 0;
+  for( int oi = 0; oi < ALFP_NUM; oi++ )
+  {
+    const int s = order[oi];
+    if( !m_stageCalls[s] ) continue;
+    const bool fine = !alfProfTopLevel( s );   // no RAPL inside fine (per CTU / per ASU) scopes
+    fprintf( f, "%-24s %8" PRIu64 " %12.3f %7.2f%% %12.4f", names[s], m_stageCalls[s], m_stageMs[s],
+             100.0 * m_stageMs[s] / encMs, m_stageMs[s] / m_stageCalls[s] );
+    if( fine ) fprintf( f, " %12s\n", "-" ); else fprintf( f, " %12.4f\n", m_stageUJ[s] * 1e-6 );
+    if( alfProfTopLevel( s ) ) alfMs += m_stageMs[s];
+  }
+  fprintf( f, "%-24s %8s %12.3f %7.2f%%\n", "ALF+CCALF total", "", alfMs, 100.0 * alfMs / encMs );
+  // ------------------------------------------------------------------ whole ALF
+  const double activeS = alfActiveS();
+  double cpuAlfUJ = 0;
+  for( int st = 0; st < ALFP_NUM; st++ ) if( alfProfTopLevel( st ) ) cpuAlfUJ += m_stageUJ[st];
+  const double cpuAlfJ = cpuAlfUJ * 1e-6;
+  const bool   gpuE    = m_backend && m_samplerRun.load() == false && m_gpuSampledJ > 0;
+  {
+    const double np = ( double ) std::max<uint64_t>( 1, m_encPictures ), na = ( double ) std::max<uint64_t>( 1, m_alfPictures );
+    fprintf( f, "\nWHOLE ALF  (start of the statistics -> end of the reconstruction: classification, covariance statistics,\n" );
+    fprintf( f, "            Wiener derivation, CTU/filter-set decisions, APS, luma+chroma filtering, CCALF)\n" );
+    fprintf( f, "                                              total        per picture   per picture with ALF\n" );
+    fprintf( f, "  pictures                               %10" PRIu64 "                     %10" PRIu64 "\n", ( uint64_t ) m_encPictures, ( uint64_t ) m_alfPictures );
+    fprintf( f, "  time, sum of ALF scopes [ms]           %10.3f   %12.4f   %12.4f   (%.2f%% of the encoder)\n", alfMs, alfMs / np, alfMs / na, 100.0 * alfMs / encMs );
+    fprintf( f, "  time, wall clock with ALF active [ms]  %10.3f   %12.4f   %12.4f\n", activeS * 1e3, activeS * 1e3 / np, activeS * 1e3 / na );
+    fprintf( f, "    of which luma classification [ms]    %10.3f   %12.4f   %12.4f   (%s)\n",
+             m_stageMs[ALFP_STATS_CLASS_CPU] + m_stageMs[ALFP_STATS_CLASS_GPU], ( m_stageMs[ALFP_STATS_CLASS_CPU] + m_stageMs[ALFP_STATS_CLASS_GPU] ) / np,
+             ( m_stageMs[ALFP_STATS_CLASS_CPU] + m_stageMs[ALFP_STATS_CLASS_GPU] ) / na, m_stageCalls[ALFP_STATS_CLASS_GPU] ? "GPU call + CPU for special CTUs" : "CPU" );
+    fprintf( f, "    of which luma filtering [ms]         %10.3f   %12.4f   %12.4f   (%s)\n",
+             m_stageMs[ALFP_RECON_LUMA_CPU] + m_stageMs[ALFP_RECON_LUMA_GPU], ( m_stageMs[ALFP_RECON_LUMA_CPU] + m_stageMs[ALFP_RECON_LUMA_GPU] ) / np,
+             ( m_stageMs[ALFP_RECON_LUMA_CPU] + m_stageMs[ALFP_RECON_LUMA_GPU] ) / na, m_stageCalls[ALFP_RECON_LUMA_GPU] ? "GPU call + CPU for the rest" : "CPU" );
+    const double covMs = m_stageMs[ALFP_STATS_COV_CPU] + m_stageMs[ALFP_STATS_COV_GPU];
+    fprintf( f, "    of which covariance statistics [ms]  %10.3f   %12.4f   %12.4f   (%s)\n", covMs, covMs / np, covMs / na,
+             m_stageCalls[ALFP_STATS_COV_GPU] ? "GPU call + CPU for special units" : "CPU" );
+    const double other = alfMs - ( m_stageMs[ALFP_STATS_CLASS_CPU] + m_stageMs[ALFP_STATS_CLASS_GPU] + m_stageMs[ALFP_RECON_LUMA_CPU] + m_stageMs[ALFP_RECON_LUMA_GPU] + covMs );
+    fprintf( f, "    rest [ms]                            %10.3f   %12.4f   %12.4f   (CPU: Wiener derivation, decisions, APS, chroma filter, CCALF, ...)\n", other, other / np, other / na );
+    {
+      // filter derivation: parallel (per-ASU distortion) vs sequential part
+      const double der    = m_stageMs[ALFP_DERIVE];
+      const double parCpu = m_stageMs[ALFP_DER_CTBFLAGS_DIST] + m_stageMs[ALFP_DER_CTB_DIST] + m_stageMs[ALFP_DER_FRAMESTATS] + m_stageMs[ALFP_DER_ACCUM]
+                          + m_stageMs[ALFP_DER_WIENER_CPU];
+      const double parGpu = m_stageMs[ALFP_DER_GPU];
+      fprintf( f, "    filter derivation [ms]               %10.3f   %12.4f   %12.4f\n", der, der / np, der / na );
+      fprintf( f, "      parallel part on the CPU [ms]      %10.3f   %12.4f   %12.4f   (class merging + Wiener solves, ASU distortions, stat sums)\n", parCpu, parCpu / np, parCpu / na );
+      if( m_stageCalls[ALFP_DER_GPU] )
+        fprintf( f, "      parallel part on the GPU [ms]      %10.3f   %12.4f   %12.4f   (class merging + Wiener solves, call wall time)\n", parGpu, parGpu / np, parGpu / na );
+      const double seq = der - parCpu - parGpu;
+      fprintf( f, "      sequential part [ms]               %10.3f   %12.4f   %12.4f   (CABAC rate, Wiener/merge, decisions, APS)\n", seq, seq / np, seq / na );
+      const double ccs = m_stageMs[ALFP_CCALF_STATS] + m_stageMs[ALFP_CCALF_STATS_GPU];
+      fprintf( f, "    CCALF statistics [ms]                %10.3f   %12.4f   %12.4f   (%s)\n", ccs, ccs / np, ccs / na,
+               m_stageCalls[ALFP_CCALF_STATS_GPU] ? "GPU call + CPU for special CTUs" : "CPU" );
+    }
+    if( m_rapl.ok() )
+    {
+      const double dyn = m_cpuIdleW > 0 ? cpuAlfJ - m_cpuIdleW * alfMs * 1e-3 : -1;
+      fprintf( f, "  CPU energy, RAPL in ALF scopes [J]     %10.4f   %12.5f   %12.5f\n", cpuAlfJ, cpuAlfJ / np, cpuAlfJ / na );
+      if( dyn >= 0 ) fprintf( f, "  CPU energy above idle (%.2f W) [J]   %10.4f   %12.5f   %12.5f\n", m_cpuIdleW, dyn, dyn / np, dyn / na );
+    }
+    else
+    {
+      fprintf( f, "  CPU energy: RAPL not available (Linux powercap only)\n" );
+    }
+    if( gpuE )
+    {
+      fprintf( f, "  GPU energy while ALF active, NVML [J]  %10.4f   %12.5f   %12.5f\n", m_gpuAlfJ, m_gpuAlfJ / np, m_gpuAlfJ / na );
+      if( m_gpuIdleW > 0 )
+      {
+        const double dyn = m_gpuAlfJ - m_gpuIdleW * activeS;
+        fprintf( f, "  GPU energy above idle (%.2f W) [J]    %10.4f   %12.5f   %12.5f\n", m_gpuIdleW, dyn, dyn / np, dyn / na );
+      }
+      if( m_rapl.ok() )
+        fprintf( f, "  CPU + GPU energy of the ALF [J]        %10.4f   %12.5f   %12.5f\n", cpuAlfJ + m_gpuAlfJ, ( cpuAlfJ + m_gpuAlfJ ) / np, ( cpuAlfJ + m_gpuAlfJ ) / na );
+    }
+  }
+
+  if( m_gpuCalls )
+  {
+    const double n = ( double ) m_gpuCalls;
+    fprintf( f, "\nGPU backend breakdown (%" PRIu64 " calls: classification, covariance, filter)  sum [ms]   avg [ms]\n", m_gpuCalls );
+    fprintf( f, "  host pack (pageable->pinned)          %10.3f %10.4f\n", m_gpu.hostPackMs, m_gpu.hostPackMs / n );
+    fprintf( f, "  H2D transfer                          %10.3f %10.4f   (%.1f MB, %.2f GB/s)\n", m_gpu.h2dMs, m_gpu.h2dMs / n,
+             m_gpu.bytesH2D / 1e6, m_gpu.h2dMs > 0 ? m_gpu.bytesH2D / ( m_gpu.h2dMs * 1e6 ) : 0.0 );
+    fprintf( f, "  classification kernel                 %10.3f %10.4f\n", m_gpu.classifyMs, m_gpu.classifyMs / n );
+    fprintf( f, "  filter kernel                         %10.3f %10.4f\n", m_gpu.filterMs, m_gpu.filterMs / n );
+    fprintf( f, "  covariance kernels                    %10.3f %10.4f\n", m_gpu.covMs, m_gpu.covMs / n );
+    fprintf( f, "  derivation kernels (merge + Wiener)   %10.3f %10.4f\n", m_gpu.distMs, m_gpu.distMs / n );
+    fprintf( f, "  CCALF statistics kernels              %10.3f %10.4f\n", m_gpu.ccalfMs, m_gpu.ccalfMs / n );
+    fprintf( f, "  D2H transfer                          %10.3f %10.4f   (%.1f MB, %.2f GB/s)\n", m_gpu.d2hMs, m_gpu.d2hMs / n,
+             m_gpu.bytesD2H / 1e6, m_gpu.d2hMs > 0 ? m_gpu.bytesD2H / ( m_gpu.d2hMs * 1e6 ) : 0.0 );
+    fprintf( f, "  host unpack (pinned->picture)         %10.3f %10.4f\n", m_gpu.hostUnpackMs, m_gpu.hostUnpackMs / n );
+    fprintf( f, "  communication (H2D+D2H)               %10.3f\n", m_gpu.h2dMs + m_gpu.d2hMs );
+    fprintf( f, "  execution (kernels)                   %10.3f\n", m_gpu.classifyMs + m_gpu.filterMs + m_gpu.covMs + m_gpu.distMs + m_gpu.ccalfMs );
+    fprintf( f, "  GPU timeline, overlapped streams      %10.3f %10.4f   (%.1f chunks/call; 1st H2D -> last D2H)\n", m_gpu.gpuSpanMs,
+             m_gpu.gpuSpanMs / n, m_gpu.chunks / n );
+    fprintf( f, "  total per call (wall, incl. host)     %10.3f %10.4f\n", m_gpu.totalMs, m_gpu.totalMs / n );
+  }
+
+  fprintf( f, "\nEnergy\n" );
+  if( m_rapl.ok() )
+  {
+    const double cpuJ = ( m_cpuUJ1 - m_cpuUJ0 ) * 1e-6;
+    fprintf( f, "  CPU package (RAPL) during encoding     %10.3f J  (avg %.2f W, idle baseline %.2f W)\n", cpuJ, cpuJ / encS, m_cpuIdleW );
+    const double scopeJ = cpuAlfJ;
+    fprintf( f, "  CPU energy inside ALF scopes           %10.3f J  (valid with 1 thread; RAPL updates every ~1 ms)\n", scopeJ );
+    fprintf( f, "  CPU energy x ALF time share (estimate) %10.3f J\n", cpuJ * alfMs / encMs );
+  }
+  else
+  {
+    fprintf( f, "  CPU: RAPL not available\n" );
+  }
+  if( m_backend && ( m_gpuEnergyOk || m_gpuSampledJ > 0 ) )
+  {
+    const double gpuS = std::chrono::duration<double>( m_t1Real - m_gpuT0 ).count();
+    if( m_gpuEnergyOk ) fprintf( f, "  GPU (NVML energy counter)              %10.3f J  over %.3f s\n", ( m_gpuE1 - m_gpuE0 ) * 1e-3, gpuS );
+    if( m_gpuIdleW > 0 )
+    {
+      const double totJ = m_gpuEnergyOk ? ( m_gpuE1 - m_gpuE0 ) * 1e-3 : m_gpuSampledJ;
+      fprintf( f, "  GPU idle baseline %.2f W -> dynamic    %10.3f J  (= total - idle x time)\n", m_gpuIdleW, totJ - m_gpuIdleW * gpuS );
+    }
+    fprintf( f, "  GPU (NVML power sampling, 2 ms)        %10.3f J  (avg %.2f W, peak %.2f W)\n", m_gpuSampledJ, m_gpuSampledJ / encS, m_gpuPeakW );
+    fprintf( f, "  note: GPU energy includes its idle power over the whole encode; subtract idle_W x time for the dynamic part\n" );
+  }
+  fprintf( f, "=============================================\n\n" );
+}
+
+} // namespace vvenc
diff --git a/source/Lib/EncoderLib/AlfProfiler.h b/source/Lib/EncoderLib/AlfProfiler.h
new file mode 100644
index 0000000..873e101
--- /dev/null
+++ b/source/Lib/EncoderLib/AlfProfiler.h
@@ -0,0 +1,200 @@
+/* -----------------------------------------------------------------------------
+AlfProfiler.h - time / energy accounting of the ALF stages inside VVenC and the
+shared GPU backend instance.
+
+Enabled with --AlfProf=1. Stage scopes are placed in EncSlice around the ALF
+tasks; with several encoder threads the per-stage numbers are *sums over
+threads* (CPU-time-like), the encoder wall time is reported separately.
+
+"Whole ALF" = everything the encoder does for ALF + CCALF, from the start of the
+statistics to the end of the reconstruction: classification (CPU or GPU), covariance
+statistics, Wiener filter derivation, CTU on/off and filter-set decisions, APS,
+luma/chroma filtering, CCALF. Its time is the sum of the stage scopes and, as wall
+clock, the time during which at least one ALF scope is active; its energy is RAPL
+inside the scopes (CPU) and NVML power integrated only while ALF is active (GPU).
+
+Energy sources:
+  CPU : Linux powercap / RAPL  (/sys/class/powercap/intel-rapl:N/energy_uj, package domains)
+  GPU : NVML total energy counter (Volta+) and a power-sampling thread (fallback / avg/peak)
+------------------------------------------------------------------------------- */
+#pragma once
+
+#include "CommonLib/AlfGpu.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace vvenc
+{
+
+enum AlfProfStage
+{
+  ALFP_STATS = 0,        // ALF_GET_STATISTICS  (classification + covariance statistics)
+  ALFP_STATS_CLASS_CPU,  //   luma 4x4 classification on the CPU (VVenC SIMD), part of ALFP_STATS
+  ALFP_STATS_CLASS_GPU,  //   --AlfGpu 1/3: gradients + classes + transpose of the whole picture on the GPU (call wall time), part of ALFP_STATS
+  ALFP_STATS_COV_CPU,    //   covariance statistics on the CPU (VVenC getPreBlkStats, SIMD), part of ALFP_STATS
+  ALFP_STATS_COV_GPU,    //   --AlfGpu 1/3: covariance statistics of the whole picture on the GPU (call wall time + unpack), part of ALFP_STATS
+  ALFP_DERIVE,           // ALF_DERIVE_FILTER   (filter derivation, CTU decisions, APS)
+  ALFP_RECON,            // ALF_RECONSTRUCT     (whole stage: luma + chroma)
+  ALFP_RECON_LUMA_CPU,   //   luma 7x7 filtering on the CPU (VVenC SIMD)
+  ALFP_RECON_LUMA_GPU,   //   luma band call to the GPU backend (wall clock)
+  ALFP_CCALF_STATS,
+  ALFP_CCALF_DERIVE,
+  ALFP_CCALF_RECON,
+  ALFP_PREFETCH,         // --AlfGpu 1/3: upload of the original at the start of the picture (CPU part of the call; the DMA overlaps the CTU encoding)
+  // ---- fine scopes (no RAPL, not part of the whole-ALF sum: they are contained in the stages above)
+  ALFP_DER_ACCUM,        //   derive: CTU -> ASU -> frame covariance accumulation
+  ALFP_DER_ENC_Y,        //   derive: alfEncoder luma (new filter: iterations of CTU on/off + Wiener/merge)
+  ALFP_DER_ENC_C,        //   derive: alfEncoder chroma
+  ALFP_DER_CTBFLAGS,     //     deriveCtbAlfEnableFlags (CTU on/off decision, all ASUs)
+  ALFP_DER_CTBFLAGS_DIST,//       of which: filtered distortion of the ASUs (calcErrorForCoeffs, parallel part)
+  ALFP_DER_FRAMESTATS,   //     getFrameStats (sum of the enabled ASUs)
+  ALFP_DER_MERGE,        //     mergeFiltersAndCost / chroma coefficients (total)
+  ALFP_DER_WIENER_CPU,   //       of which: class merging + Wiener solves + quantisation on the CPU (parallel part)
+  ALFP_DER_CTB,          //   derive: alfEncoderCtb (fixed / APS / new filter-set decision per ASU)
+  ALFP_DER_CTB_DIST,     //     of which: filter-set distortion of the ASUs (calcErrorForCoeffs, parallel part)
+  ALFP_DER_GPU,          //       --AlfGpu 1/3: class merging + Wiener solves + quantisation on the GPU (call wall time)
+  ALFP_DER_APS,          //   derive: APS coefficient reconstruction
+  ALFP_CCALF_STATS_CPU,  //   CCALF statistics on the CPU (VVenC), part of CCALF stats
+  ALFP_CCALF_STATS_GPU,  //   --AlfGpu 1/3: CCALF statistics of the whole picture on the GPU (call wall time + unpack)
+  ALFP_CCALF_DER_DIST,   //   CCALF derive: distortion part (calcErrorForCoeffs)
+  ALFP_NUM
+};
+
+inline bool alfProfTopLevel( int s ) { return s == ALFP_STATS || s == ALFP_DERIVE || s == ALFP_RECON || s == ALFP_CCALF_STATS || s == ALFP_CCALF_DERIVE || s == ALFP_CCALF_RECON || s == ALFP_PREFETCH; }
+
+class RaplReader
+{
+public:
+  RaplReader();
+  ~RaplReader();
+  bool     ok() const { return !m_fds.empty(); }
+  uint64_t readUJ();                // sum of all package domains, wrap-around corrected, monotonic
+private:
+  std::vector<int>      m_fds;
+  std::vector<uint64_t> m_max, m_last, m_acc;
+  std::mutex            m_mutex;
+};
+
+class AlfProfiler
+{
+public:
+  static AlfProfiler& get();
+
+  bool enabled() const { return m_enabled; }
+  void start( bool enable, int gpuMode );       // EncLib::initEncoderLib
+  void stop();                                  // EncLib::uninitEncoderLib, prints the report
+
+  // shared backend (created on first use with the fixed filter tables)
+  alfgpu::Backend* backend( const int16_t* fixedCoef, const int16_t* fixedClip, int maxPicWidth, int maxBandH, int numWorkers );
+
+  void addStage   ( AlfProfStage s, double ms, uint64_t raplUJ, uint64_t calls = 1 );
+  void addGpu     ( const alfgpu::Timing& t );
+  void addAlfPicture() { m_alfPictures++; }   // pictures not skipped by isSkipAlfForFrame()
+  void addEncPicture() { m_encPictures++; }   // every picture that reaches the ALF derivation
+  // whole-ALF wall-clock tracking (top-level stage scopes)
+  void alfEnter();
+  void alfLeave();
+  void addVerify  ( uint64_t samples, uint64_t sampleErr, uint64_t blocks, uint64_t blockErr );
+  void addVerifyCov( uint64_t values, uint64_t errors );
+  void addVerifyMerge( uint64_t values, uint64_t errors );
+  void addVerifyCcAlf( uint64_t values, uint64_t errors );
+  uint64_t rapl() { return m_rapl.ok() ? m_rapl.readUJ() : 0; }
+
+private:
+  AlfProfiler() {}
+  ~AlfProfiler();
+  void sampler();
+  void openGpuWindow();
+  void report( FILE* f );
+
+  bool m_enabled = false;
+  int  m_gpuMode = 0;
+  std::chrono::steady_clock::time_point m_t0, m_t1, m_t1Real;
+
+  std::mutex        m_mutex;
+  double            m_stageMs[ALFP_NUM]    = { 0 };
+  uint64_t          m_stageCalls[ALFP_NUM] = { 0 };
+  uint64_t          m_stageUJ[ALFP_NUM]    = { 0 };
+  alfgpu::Timing    m_gpu;
+  uint64_t          m_gpuCalls = 0;
+  std::atomic<uint64_t> m_alfPictures{ 0 }, m_encPictures{ 0 };
+  double alfActiveS();                         // seconds with >= 1 ALF scope active, including the running interval
+  std::mutex        m_activeMutex;
+  int               m_activeCount = 0;
+  std::chrono::steady_clock::time_point m_activeT0;
+  double            m_activeS = 0;
+  double            m_gpuAlfJ = 0;             // GPU energy integrated while ALF is active
+  uint64_t          m_verSamples = 0, m_verSampleErr = 0, m_verBlocks = 0, m_verBlockErr = 0, m_verCov = 0, m_verCovErr = 0;
+  uint64_t          m_verMerge = 0, m_verMergeErr = 0, m_verCc = 0, m_verCcErr = 0;
+
+  alfgpu::Backend*  m_backend = nullptr;
+  std::mutex        m_backendMutex;
+
+  RaplReader        m_rapl;
+  uint64_t          m_cpuUJ0 = 0, m_cpuUJ1 = 0;
+  double            m_cpuIdleW = -1;
+
+  // GPU power sampling
+  std::thread             m_samplerThread;
+  std::atomic<bool>       m_samplerRun{ false };
+  double                  m_gpuSampledJ = 0, m_gpuPeakW = 0, m_gpuIdleW = -1;
+  unsigned long long      m_gpuE0 = 0, m_gpuE1 = 0;
+  std::chrono::steady_clock::time_point m_gpuT0;
+  bool                    m_gpuWindowOpen = false;
+  double                  m_excludedS = 0;
+  uint64_t                m_excludedUJ = 0;   // idle sampling done inside the encoding window
+  bool                    m_gpuEnergyOk = false;
+};
+
+// RAII scope: wall time (+ RAPL delta for the stage-level scopes) of an ALF stage.
+// The RAPL reads happen outside the timed interval; fine-grained (per CTU) scopes skip RAPL.
+class AlfProfScope
+{
+public:
+  AlfProfScope( AlfProfStage s ) : m_s( s ), m_on( AlfProfiler::get().enabled() ), m_energy( alfProfTopLevel( s ) )
+  {
+    // stage-level scopes (m_energy) are the top-level ALF scopes: RAPL + whole-ALF wall clock
+    if( m_on ) { if( m_energy ) { m_uj = AlfProfiler::get().rapl(); AlfProfiler::get().alfEnter(); } m_t = std::chrono::steady_clock::now(); }
+  }
+  ~AlfProfScope()
+  {
+    if( !m_on ) return;
+    const double ms = std::chrono::duration<double, std::milli>( std::chrono::steady_clock::now() - m_t ).count();
+    if( m_energy ) AlfProfiler::get().alfLeave();
+    uint64_t duj = 0;
+    if( m_energy ) { const uint64_t uj = AlfProfiler::get().rapl(); duj = uj >= m_uj ? uj - m_uj : 0; }
+    AlfProfiler::get().addStage( m_s, ms, duj );
+  }
+private:
+  AlfProfStage m_s;
+  bool m_on, m_energy;
+  uint64_t m_uj = 0;
+  std::chrono::steady_clock::time_point m_t;
+};
+
+// Low-overhead accumulator for scopes that are entered very often (per ASU / per filter set):
+// start()/stop() pairs are summed locally and posted once when the object dies.
+class AlfProfAcc
+{
+public:
+  AlfProfAcc( AlfProfStage s ) : m_s( s ), m_on( AlfProfiler::get().enabled() ) {}
+  ~AlfProfAcc() { if( m_on && m_n ) AlfProfiler::get().addStage( m_s, m_ms, 0, 1 ); }
+  void start() { if( m_on ) m_t = std::chrono::steady_clock::now(); }
+  void stop()  { if( m_on ) { m_ms += std::chrono::duration<double, std::milli>( std::chrono::steady_clock::now() - m_t ).count(); m_n++; } }
+  bool on() const { return m_on; }
+private:
+  AlfProfStage m_s;
+  bool m_on;
+  double m_ms = 0;
+  uint64_t m_n = 0;
+  std::chrono::steady_clock::time_point m_t;
+};
