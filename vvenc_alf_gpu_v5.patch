+// ====================================================================================================================
+// mergeFiltersAndCost: the parallel part (greedy class merging with one Cholesky solve per candidate pair, and the
+// Wiener filter + quantisation of every (numFilters, filter) hypothesis) runs on the GPU with --AlfGpu 1/3; the
+// sequential part (rate of the coefficients, force-0 decisions, choice of numFilters) stays here. --AlfGpu 3 runs
+// both and compares every level / hypothesis bit by bit.
+// ====================================================================================================================
 double EncAdaptiveLoopFilter::mergeFiltersAndCost( AlfParam& alfParam, AlfFilterShape& alfShape, AlfCovariance* covFrame, AlfCovariance* covMerged, int clipMerged[MAX_NUM_ALF_CLASSES][MAX_NUM_ALF_CLASSES][MAX_NUM_ALF_LUMA_COEFF], int& uiCoeffBits )
+{
+  if( xGpuDeriveActive() && alfShape.numCoeff == MAX_NUM_ALF_LUMA_COEFF && xGpuMerge( covFrame ) )
+  {
+    if( m_alfGpuMode == alfgpu::MODE_FULL )
+    {
+      return xMergeFiltersAndCostGpu( alfParam, alfShape, uiCoeffBits );
+    }
+    m_gpuMergeVerify = true;
+    m_gpuMergeVals = m_gpuMergeErr = 0;
+    const double d = xMergeFiltersAndCostCpu( alfParam, alfShape, covFrame, covMerged, clipMerged, uiCoeffBits );
+    m_gpuMergeVerify = false;
+    AlfProfiler::get().addVerifyMerge( m_gpuMergeVals, m_gpuMergeErr );
+    return d;
+  }
+  return xMergeFiltersAndCostCpu( alfParam, alfShape, covFrame, covMerged, clipMerged, uiCoeffBits );
+}
+
+bool EncAdaptiveLoopFilter::xGpuDeriveActive() const
+{
+  return m_alfGpu && m_gpuDerive && ( m_alfGpuMode == alfgpu::MODE_FULL || m_alfGpuMode == alfgpu::MODE_VERIFY );
+}
+
+// packs the frame covariances (m_alfCovarianceFrame[CH_L]) and runs the merging + hypothesis kernels
+bool EncAdaptiveLoopFilter::xGpuMerge( AlfCovariance* covFrame )
+{
+  const bool nonLin = m_alfParamTemp.nonLinearFlag[CH_L];
+  const int  nb     = nonLin ? AlfNumClippingValues : 1;
+  const int  st     = alfgpu::covStride( nb );
+  m_gpuMergeCov.assign( ( size_t ) MAX_NUM_ALF_CLASSES * st, 0.f );
+  for( int c = 0; c < MAX_NUM_ALF_CLASSES; c++ )
+  {
+    const AlfCovariance& cv = covFrame[c];
+    CHECK( cv.numBins < nb, "ALF GPU: frame covariance with too few bins" );
+    float* d = &m_gpuMergeCov[( size_t ) c * st];
+    for( int b0 = 0; b0 < nb; b0++ )
+      for( int b1 = 0; b1 < nb; b1++ )
+        for( int k = 0; k < MAX_NUM_ALF_LUMA_COEFF; k++ )
+          for( int l = 0; l < MAX_NUM_ALF_LUMA_COEFF; l++ )
+            d[( ( b0 * nb + b1 ) * MAX_NUM_ALF_LUMA_COEFF + k ) * MAX_NUM_ALF_LUMA_COEFF + l] = cv.E[b0][b1][k][l];
+    for( int b = 0; b < nb; b++ )
+      for( int k = 0; k < MAX_NUM_ALF_LUMA_COEFF; k++ ) d[nb * nb * MAX_NUM_ALF_LUMA_COEFF * MAX_NUM_ALF_LUMA_COEFF + b * MAX_NUM_ALF_LUMA_COEFF + k] = cv.y[b][k];
+    d[nb * nb * MAX_NUM_ALF_LUMA_COEFF * MAX_NUM_ALF_LUMA_COEFF + nb * MAX_NUM_ALF_LUMA_COEFF] = cv.pixAcc;
+  }
+  alfgpu::MergeJob job;
+  job.nb        = nb;
+  job.nonLinear = nonLin ? 1 : 0;
+  job.doClip    = ( m_encCfg->m_useNonLinearAlfLuma || m_encCfg->m_useNonLinearAlfChroma ) ? 1 : 0;
+  job.bitDepth  = m_NUM_BITS;
+  job.cov       = m_gpuMergeCov.data();
+  alfgpu::Timing t;
+  {
+    AlfProfScope profScope( ALFP_DER_GPU );
+    m_alfGpu->mergeFilters( job, m_gpuMergeRes, m_gpuSlot, t );
+  }
+  if( AlfProfiler::get().enabled() ) AlfProfiler::get().addGpu( t );
+  return true;
+}
+
+// deriveFilterCoeffs() for numFilters, taken from the GPU result: same outputs (m_filterCoeffSet, m_filterClippSet,
+// errorTabForce0Coeff, returned error) as the CPU function
+double EncAdaptiveLoopFilter::xLoadGpuHypothesis( const int numFilters, alf_float_t errorForce0CoeffTab[MAX_NUM_ALF_CLASSES][2] )
+{
+  double error = 0.0;
+  for( int f = 0; f < numFilters; f++ )
+  {
+    for( int i = 0; i < MAX_NUM_ALF_LUMA_COEFF; i++ )
+    {
+      m_filterCoeffSet[f][i] = m_gpuMergeRes.coeff[numFilters - 1][f][i];
+      m_filterClippSet[f][i] = m_gpuMergeRes.clip [numFilters - 1][f][i];
+    }
+    errorForce0CoeffTab[f][1] = m_gpuMergeRes.errTab[numFilters - 1][f][1];
+    errorForce0CoeffTab[f][0] = m_gpuMergeRes.errTab[numFilters - 1][f][0];
+    error += errorForce0CoeffTab[f][1];
+  }
+  return error;
+}
+
+// --AlfGpu 3: CPU deriveFilterCoeffs( numFilters ) vs the GPU hypothesis
+void EncAdaptiveLoopFilter::xGpuVerifyMergeLevel( const int numFilters, alf_float_t errorForce0CoeffTab[MAX_NUM_ALF_CLASSES][2] )
+{
+  for( int f = 0; f < numFilters; f++ )
+  {
+    for( int i = 0; i < MAX_NUM_ALF_LUMA_COEFF; i++ )
+    {
