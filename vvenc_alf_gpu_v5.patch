+// ====================================================================================================================
+// GPU offload of the luma ALF reconstruction
+//   frame mode (default): one backend call per picture, issued right after the filter derivation, when all CTU
+//                         decisions are final (not in IFP line-sync mode); the CTU-row stage then only does chroma
+//   row mode            : one backend call per CTU row inside ALF_RECONSTRUCT (IFP mode, or env VVENC_ALF_GPU_ROWMODE=1)
+// Only CTUs that VVenC filters directly on the picture buffer (not crossed by virtual / slice / tile boundaries that
+// require extra padding) are sent to the backend; the others keep the full VVenC path.
+// ====================================================================================================================
+
+bool EncAdaptiveLoopFilter::xCtuCrossedByBoundaries( CodingStructure& cs, const int ctu )
+{
+  const PreCalcValues& pcv = *cs.pcv;
+  const int xPos   = ( ctu % pcv.widthInCtus ) << pcv.maxCUSizeLog2;
+  const int yPos   = ( ctu / pcv.widthInCtus ) << pcv.maxCUSizeLog2;
+  const int width  = std::min<int>( pcv.maxCUSize, pcv.lumaWidth - xPos );
+  const int height = std::min<int>( pcv.maxCUSize, pcv.lumaHeight - yPos );
+  bool clipTop, clipBottom, clipLeft, clipRight;
+  int numHorVirBndry, numVerVirBndry, horVirBndryPos[3], verVirBndryPos[3], rasterSliceAlfPad;
+  return isCrossedByVirtualBoundaries( cs, xPos, yPos, width, height, clipTop, clipBottom, clipLeft, clipRight,
+                                       numHorVirBndry, numVerVirBndry, horVirBndryPos, verVirBndryPos, rasterSliceAlfPad );
+}
+
+int EncAdaptiveLoopFilter::xGpuSetIdx( CodingStructure& cs, const int ctu )
+{
+  if( !m_ctuEnableFlag[COMP_Y][ctu] ) return -1;
+  if( xCtuCrossedByBoundaries( cs, ctu ) ) return -1;
+  return cs.picture->m_alfCtbFilterIndex[ctu];
+}
+
+void EncAdaptiveLoopFilter::xFillBandParams( CodingStructure& cs, alfgpu::BandParams& bp, const int bandY0, const int bandH, const int16_t* setIdx )
+{
+  const PreCalcValues& pcv = *cs.pcv;
+  CHECK( pcv.lumaWidth != m_picWidth, "ALF GPU: unexpected picture width" );
+  CHECK( cs.slice->clpRngs.bd != m_inputBitDepth[CH_L], "ALF GPU: bit depth mismatch" );
+  const CPelBuf tmpY = m_tempBuf.get( COMP_Y );
+  int maxSet = -1;
+  const int n = ( ( bandH + pcv.maxCUSize - 1 ) >> pcv.maxCUSizeLog2 ) * pcv.widthInCtus;
+  for( int i = 0; i < n; i++ ) maxSet = std::max<int>( maxSet, setIdx[i] );
+  bp.src        = tmpY.bufAt( 0, bandY0 );
+  bp.srcStride  = tmpY.stride;
+  bp.picWidth   = pcv.lumaWidth;
+  bp.bandY0     = bandY0;
+  bp.bandH      = bandH;
+  bp.ctuSize    = pcv.maxCUSize;
+  bp.numCtuCols = pcv.widthInCtus;
+  bp.bitDepth   = m_inputBitDepth[CH_L];
+  bp.vbH        = m_alfVBLumaCTUHeight;
+  bp.vbPos      = m_alfVBLumaPos;
+  bp.ctuSetIdx  = setIdx;
+  bp.numAps     = std::max( 0, maxSet - NUM_FIXED_FILTER_SETS + 1 );
+  bp.apsCoef    = &m_coeffApsLuma[0][0];
+  bp.apsClip    = &m_clippApsLuma[0][0];
+  bp.cpuClass   = nullptr;
+  bp.dst        = nullptr;
+  bp.dstStride  = 0;
+  bp.outClass   = nullptr;
+}
+
+bool EncAdaptiveLoopFilter::gpuClassifiesAtStats() const
+{
+  return m_alfGpu && ( m_alfGpuMode == alfgpu::MODE_FULL || m_alfGpuMode == alfgpu::MODE_VERIFY ) && !m_gpuRowMode && !m_encCfg->m_ifpLines;
+}
+
+void EncAdaptiveLoopFilter::gpuClassifyFrame( Picture& pic, CodingStructure& cs )
+{
+  std::lock_guard<std::mutex> lock( m_gpuClsMutex );
+  if( xGpuClassesValid( pic, cs.slice->poc ) || isSkipAlfForFrame( pic ) ) return;
+  m_gpuCovValid = false;
+
+  const PreCalcValues& pcv = *cs.pcv;
+  m_gpuClsMap.assign( pcv.sizeInCtus, -1 );
+  int numGpu = 0;
+  for( int ctu = 0; ctu < ( int ) pcv.sizeInCtus; ctu++ )
+  {
+    if( !xCtuCrossedByBoundaries( cs, ctu ) ) { m_gpuClsMap[ctu] = 0; numGpu++; }
+  }
+  if( !numGpu ) return;
+
+  const int clsStride = pcv.lumaWidth >> 2;
+  m_gpuClsFrame.assign( ( size_t ) clsStride * ( ( pcv.lumaHeight + 3 ) >> 2 ), 0 );
+  alfgpu::BandParams bp;
+  xFillBandParams( cs, bp, 0, pcv.lumaHeight, m_gpuClsMap.data() );
+  bp.numAps   = 0;
+  bp.outClass = m_gpuClsFrame.data();
+  m_gpuClsPic = &pic;
+  m_gpuClsPoc = cs.slice->poc;
+  m_gpuResPic = &pic;            // pre-ALF luma of this picture resident on the device (also for the CCALF statistics)
+  m_gpuResPoc = cs.slice->poc;
+
+  bool needClasses = true;
+  if( m_gpuFused )
+  {
+    // classification + covariance statistics in one submission; the classes come back only if the CPU needs them
+    // (verify mode, benchmark dump, or regular CTUs inside a statistics unit that also holds a special CTU)
+    needClasses = xGpuCovarianceFrame( pic, cs, &bp );
+  }
+  else
+  {
+    alfgpu::Timing t;
+    {
+      AlfProfScope profScope( ALFP_STATS_CLASS_GPU );
+      m_alfGpu->classifyFrame( bp, m_gpuSlot, t );
+    }
+    if( AlfProfiler::get().enabled() ) AlfProfiler::get().addGpu( t );
+  }
+
+  if( m_alfGpuMode == alfgpu::MODE_FULL && needClasses )
+  {
+    // the encoder statistics use the GPU classes (VVenC layout: per CTU, MAX_CU_SIZE/4 blocks per row)
+    const int numClassBlocksInCTU = ( MAX_CU_SIZE * MAX_CU_SIZE ) >> 4, ctuSize = pcv.maxCUSize;
+    for( int ctu = 0; ctu < ( int ) pcv.sizeInCtus; ctu++ )
+    {
+      if( m_gpuClsMap[ctu] < 0 ) continue;
+      const int x0 = ( ctu % pcv.widthInCtus ) * ctuSize, y0 = ( ctu / pcv.widthInCtus ) * ctuSize;
+      const int w = std::min<int>( ctuSize, pcv.lumaWidth - x0 ), h = std::min<int>( ctuSize, pcv.lumaHeight - y0 );
+      AlfClassifier* cl = &m_classifier[numClassBlocksInCTU * ctu];
+      for( int by = 0; by < h; by += 4 )
+        for( int bx = 0; bx < w; bx += 4 )
+        {
+          const uint8_t v = m_gpuClsFrame[( ( y0 + by ) >> 2 ) * clsStride + ( ( x0 + bx ) >> 2 )];
+          cl[( by >> 2 ) * ( MAX_CU_SIZE >> 2 ) + ( bx >> 2 )] = AlfClassifier( v & 31, v >> 5 );
+        }
+    }
+  }
+
+  // covariance statistics of the whole picture on the GPU (uses the resident picture and classes)
+  if( !m_gpuFused ) xGpuCovarianceFrame( pic, cs, nullptr );
+}
+
+int EncAdaptiveLoopFilter::xStatUnitOfCtu( const int ctuRsAddr ) const
+{
+  if( m_accumStatCTUWise ) return ctuRsAddr;
+  const int ctuX = ctuRsAddr % m_numCTUsInWidth, ctuY = ctuRsAddr / m_numCTUsInWidth;
+  return ( ctuY / m_numCtusInAsuHeight ) * m_numAsusInWidth + ctuX / m_numCtusInAsuWidth;
+}
+
+// covariance statistics of the regular units; bpClassify != nullptr: fused with the classification of the picture
+// (one submission). Returns true if the CPU needs the GPU classes of the regular CTUs.
+bool EncAdaptiveLoopFilter::xGpuCovarianceFrame( Picture& pic, CodingStructure& cs, alfgpu::BandParams* bpClassify )
+{
+  bool needClasses = m_alfGpuMode == alfgpu::MODE_VERIFY || getenv( "VVENC_ALF_DUMP" ) != nullptr;
+  const PreCalcValues& pcv = *cs.pcv;
+  const int numUnitsInPic = m_accumStatCTUWise ? m_numCTUsInPic : m_numAsusInPic;
+  m_gpuCovUnit.assign( numUnitsInPic, 0 );
+  m_gpuCovUnits.clear();
+
+  // units whose CTUs are all regular (no special padding): CTUs in the CPU order of getStatisticsASU / getStatisticsCTU
+  std::vector<int> unitStart( 1, 0 ), ctus;
+  for( int u = 0; u < numUnitsInPic; u++ )
+  {
+    std::vector<int> list;
+    if( m_accumStatCTUWise ) list.push_back( u );
+    else
+    {
+      int ctuX, ctuY;
+      getAsuCtuXY( u, ctuX, ctuY );
+      for( int y = ctuY; y < getAsuMaxCtuY( ctuY ); y++ )
+        for( int x = ctuX; x < getAsuMaxCtuX( ctuX ); x++ ) list.push_back( y * m_numCTUsInWidth + x );
+    }
+    bool ok = true;
+    for( int ctu : list ) ok = ok && m_gpuClsMap[ctu] >= 0;
+    if( !ok )
+    {
+      for( int ctu : list ) needClasses = needClasses || m_gpuClsMap[ctu] >= 0;   // CPU statistics of this unit use the classes
+      continue;
+    }
+    m_gpuCovUnits.push_back( u );
+    ctus.insert( ctus.end(), list.begin(), list.end() );
+    unitStart.push_back( ( int ) ctus.size() );
+  }
+  if( !bpClassify && m_gpuCovUnits.empty() ) return needClasses;
+  if( bpClassify && !needClasses ) bpClassify->outClass = nullptr;
+  const bool orgResident = m_gpuOrgPic == &pic && m_gpuOrgPoc == cs.slice->poc;
+
+  alfgpu::CovJob jobs[MAX_NUM_COMP];
+  std::vector<int16_t> rects[MAX_NUM_COMP];
+  int numJobs = 0;
+  const PelUnitBuf orgYuv = cs.picture->getOrigBuf();
+  for( int compIdx = 0; compIdx < getNumberValidComponents( m_chromaFormat ); compIdx++ )
+  {
+    m_gpuCovComp[compIdx] = m_alfFilterStatEnabled[compIdx];
+    if( !m_alfFilterStatEnabled[compIdx] ) continue;
+    const ComponentID compID = ComponentID( compIdx );
+    const ChannelType chType = toChannelType( compID );
+    const int sx = getComponentScaleX( compID, m_chromaFormat ), sy = getComponentScaleY( compID, m_chromaFormat );
+    const bool nonLin = isLuma( chType ) ? m_encCfg->m_useNonLinearAlfLuma : m_encCfg->m_useNonLinearAlfChroma;
+    const AlfFilterShape& shape = m_filterShapes[chType];
+    m_gpuCovElem[compIdx] = alfgpu::covElements( shape.numCoeff, nonLin ? AlfNumClippingValues : 1 );
+
+    std::vector<int16_t>& r = rects[compIdx];
+    for( int ctu : ctus )
+    {
+      const int x0 = ( ctu % pcv.widthInCtus ) << pcv.maxCUSizeLog2, y0 = ( ctu / pcv.widthInCtus ) << pcv.maxCUSizeLog2;
+      const int w = std::min<int>( pcv.maxCUSize, pcv.lumaWidth - x0 ), h = std::min<int>( pcv.maxCUSize, pcv.lumaHeight - y0 );
+      r.push_back( ( int16_t ) ( x0 >> sx ) ); r.push_back( ( int16_t ) ( y0 >> sy ) );
+      r.push_back( ( int16_t ) ( w >> sx ) );  r.push_back( ( int16_t ) ( h >> sy ) );
+    }
+    alfgpu::CovJob& jb = jobs[numJobs++];
+    const CPelBuf rec = m_tempBuf.get( compID );
+    const CPelBuf org = orgYuv.get( compID );
+    jb.comp      = compIdx;
+    jb.rec       = rec.bufAt( 0, 0 );
+    jb.recStride = rec.stride;
+    jb.org       = orgResident ? nullptr : org.bufAt( 0, 0 );
+    jb.orgStride = org.stride;
+    jb.width     = pcv.lumaWidth >> sx;
+    jb.height    = pcv.lumaHeight >> sy;
+    jb.k            = alfgpu::CovKParams();
+    jb.k.numCoeff   = shape.numCoeff;
+    jb.k.halfLen    = shape.filterLength >> 1;
+    jb.k.numBins    = nonLin ? AlfNumClippingValues : 1;
+    jb.k.nonLinear  = nonLin;
+    jb.k.numClasses = compIdx ? 1 : MAX_NUM_ALF_CLASSES;
+    jb.k.numElem    = ( int ) m_gpuCovElem[compIdx].size();
+    for( int b = 0; b < alfgpu::CV_MAXBINS; b++ ) jb.k.clip[b] = m_alfClippingValues[chType][b];
+    jb.k.vbH        = compIdx ? m_alfVBChmaCTUHeight : m_alfVBLumaCTUHeight;
+    jb.k.vbPos      = compIdx ? m_alfVBChmaPos : m_alfVBLumaPos;
+    jb.k.recPitch = jb.k.orgPitch = jb.k.clsStride = 0;
+    jb.numUnits     = ( int ) m_gpuCovUnits.size();
+    jb.unitCtuStart = unitStart.data();
+    jb.ctuRect      = r.data();
+    jb.elem         = m_gpuCovElem[compIdx].data();
+    m_gpuCovOut[compIdx].resize( ( size_t ) jb.numUnits * jb.k.numClasses * jb.k.numElem );
+    m_gpuCovUsed[compIdx].resize( ( size_t ) jb.numUnits * jb.k.numClasses );
+    jb.out  = m_gpuCovOut[compIdx].data();
+    jb.used = m_gpuCovUsed[compIdx].data();
+  }
+
+  if( m_gpuCovUnits.empty() ) numJobs = 0;
+  alfgpu::Timing t, tCls;
+  {
+    if( bpClassify )
+    {
+      AlfProfScope profScope( ALFP_STATS_CLASS_GPU );   // fused: classification + covariance kernels, one synchronisation
+      m_alfGpu->classifyAndCovariance( *bpClassify, jobs, numJobs, m_gpuSlot, tCls, t );
+    }
+    else
+    {
+      AlfProfScope profScope( ALFP_STATS_COV_GPU );
+      m_alfGpu->covarianceFrame( jobs, numJobs, m_gpuSlot, t );
+    }
+    AlfProfScope profUnpack( ALFP_STATS_COV_GPU );
+    if( m_alfGpuMode == alfgpu::MODE_FULL )
+    {
+      // the encoder's statistics buffers receive the GPU result; getStatisticsCTU() skips these units
+      for( int i = 0; i < ( int ) m_gpuCovUnits.size(); i++ )
+      {
+        const int u = m_gpuCovUnits[i];
+        for( int compIdx = 0; compIdx < getNumberValidComponents( m_chromaFormat ); compIdx++ )
+        {
+          const int numClasses = compIdx ? 1 : MAX_NUM_ALF_CLASSES;
+          for( int c = 0; c < numClasses; c++ ) m_alfCovariance[compIdx][u][c].reset();
+          if( m_gpuCovComp[compIdx] ) xGpuCovUnpack( compIdx, i, m_alfCovariance[compIdx][u] );
+        }
+        m_gpuCovUnit[u] = 1;
+      }
+    }
+  }
+  if( AlfProfiler::get().enabled() ) { if( bpClassify ) AlfProfiler::get().addGpu( tCls ); AlfProfiler::get().addGpu( t ); }
+  m_gpuCovValid = true;
+  return needClasses;
+}
+
+// GPU result of unit listIdx -> AlfCovariance[numClasses] (upper triangle as computed, lower triangle mirrored as in getPreBlkStats)
+void EncAdaptiveLoopFilter::xGpuCovUnpack( const int compIdx, const int listIdx, AlfCovariance* cov ) const
+{
+  const std::vector<uint32_t>& el = m_gpuCovElem[compIdx];
+  const int numClasses = compIdx ? 1 : MAX_NUM_ALF_CLASSES, ne = ( int ) el.size();
+  const ChannelType chType = toChannelType( ComponentID( compIdx ) );
+  const int numCoeff = m_filterShapes[chType].numCoeff;
+  const bool nonLin = isLuma( chType ) ? m_encCfg->m_useNonLinearAlfLuma : m_encCfg->m_useNonLinearAlfChroma;
+  const int numBins = nonLin ? AlfNumClippingValues : 1;
+  for( int c = 0; c < numClasses; c++ )
+  {
+    AlfCovariance& cv = cov[c];
+    const float* v = &m_gpuCovOut[compIdx][( ( size_t ) listIdx * numClasses + c ) * ne];
+    for( int e = 0; e < ne; e++ )
+    {
+      const uint32_t d = el[e];
+      switch( alfgpu::covKind( d ) )
+      {
+      case 0:  cv.E[alfgpu::covB0( d )][alfgpu::covB1( d )][alfgpu::covK( d )][alfgpu::covL( d )] = v[e]; break;
+      case 1:  cv.y[alfgpu::covB0( d )][alfgpu::covK( d )] = v[e]; break;
+      default: cv.pixAcc = v[e]; break;
+      }
+    }
+    for( int k = 1; k < numCoeff; k++ )
+      for( int l = 0; l < k; l++ )
+        for( int b0 = 0; b0 < numBins; b0++ )
+          for( int b1 = 0; b1 < numBins; b1++ ) cv.E[b0][b1][k][l] = cv.E[b1][b0][l][k];
+    cv.all0 = !m_gpuCovUsed[compIdx][( size_t ) listIdx * numClasses + c];
+  }
+}
+
+// --AlfGpu 3: GPU covariances vs the CPU ones (called when all statistics of the picture are done)
+void EncAdaptiveLoopFilter::xGpuVerifyCovariance()
+{
+  uint64_t values = 0, errors = 0;
+  for( int i = 0; i < ( int ) m_gpuCovUnits.size(); i++ )
+  {
+    const int u = m_gpuCovUnits[i];
+    for( int compIdx = 0; compIdx < getNumberValidComponents( m_chromaFormat ); compIdx++ )
+    {
+      if( !m_gpuCovComp[compIdx] ) continue;
+      const int numClasses = compIdx ? 1 : MAX_NUM_ALF_CLASSES, ne = ( int ) m_gpuCovElem[compIdx].size();
+      for( int c = 0; c < numClasses; c++ )
+      {
+        const AlfCovariance& cv = m_alfCovariance[compIdx][u][c];
+        const float* v = &m_gpuCovOut[compIdx][( ( size_t ) i * numClasses + c ) * ne];
+        for( int e = 0; e < ne; e++ )
+        {
+          const uint32_t d = m_gpuCovElem[compIdx][e];
+          float ref;
+          switch( alfgpu::covKind( d ) )
+          {
+          case 0:  ref = cv.E[alfgpu::covB0( d )][alfgpu::covB1( d )][alfgpu::covK( d )][alfgpu::covL( d )]; break;
+          case 1:  ref = cv.y[alfgpu::covB0( d )][alfgpu::covK( d )]; break;
+          default: ref = cv.pixAcc; break;
+          }
+          values++;
+          if( std::memcmp( &ref, &v[e], sizeof( float ) ) != 0 && errors++ < 5 )
+            fprintf( stderr, "[AlfGpu] VERIFY covariance mismatch comp %d unit %d class %d element %d: gpu %.9g vvenc %.9g\n", compIdx, u, c, e, v[e], ref );
+        }
+        values++;
+        if( cv.all0 != !m_gpuCovUsed[compIdx][( size_t ) i * numClasses + c] ) errors++;
+      }
+    }
+  }
+  AlfProfiler::get().addVerifyCov( values, errors );
+}
+
+// ====================================================================================================================
+// fixed-cost reduction of the GPU calls
+// ====================================================================================================================
+// m_tempBuf (pre-ALF copy of the picture, alive as long as this object) is page-locked once, so the per-picture
+// uploads of the luma (classification) and chroma (covariance) read it directly with 2D DMA copies
+void EncAdaptiveLoopFilter::xGpuRegisterBuffers()
+{
+  if( m_gpuRegistered || !m_alfGpu ) return;
+  const int margin = ( MAX_ALF_FILTER_LENGTH + 1 ) >> 1;
+  const int extH   = ( ( m_picHeight + m_maxCUHeight - 1 ) / m_maxCUHeight ) * m_maxCUHeight;
+  bool ok = true;
+  int  done = 0;
+  for( int c = 0; c < getNumberValidComponents( m_chromaFormat ) && ok; c++ )
+  {
+    const int    sy    = getComponentScaleY( ComponentID( c ), m_chromaFormat );
+    const size_t bytes = ( size_t ) m_tempBuf.get( ComponentID( c ) ).stride * ( ( extH >> sy ) + 2 * margin ) * sizeof( Pel );
+    ok = m_alfGpu->registerHost( m_tempBuf.getOrigin( c ), bytes );
+    if( ok ) done++;
+  }
+  if( !ok )
+  {
+    for( int c = 0; c < done; c++ ) m_alfGpu->unregisterHost( m_tempBuf.getOrigin( c ) );
+    return;
+  }
+  m_gpuRegistered = true;
+}
+
+// original planes of the picture to the GPU at the start of its encoding (asynchronous); the statistics kernels use them
+void EncAdaptiveLoopFilter::xGpuPrefetchOriginal( Slice& slice )
+{
+  m_gpuOrgPoc = -1;
+  m_gpuOrgPic = nullptr;
+  if( !m_alfGpu || !m_gpuPrefetch || !( m_alfGpuMode == alfgpu::MODE_FULL || m_alfGpuMode == alfgpu::MODE_VERIFY ) ) return;
+  if( m_gpuRowMode || m_encCfg->m_ifpLines || !slice.pic ) return;
+  AlfProfScope profScope( ALFP_PREFETCH );
+  const CPelUnitBuf org = slice.pic->getOrigBuf();
+  alfgpu::OrigPlanes o;
+  o.numComp = getNumberValidComponents( m_chromaFormat );
+  for( int c = 0; c < o.numComp; c++ )
+  {
+    const CPelBuf b = org.get( ComponentID( c ) );
+    o.org[c]    = b.bufAt( 0, 0 );
+    o.stride[c] = b.stride;
+    o.width[c]  = m_picWidth  >> getComponentScaleX( ComponentID( c ), m_chromaFormat );
+    o.height[c] = m_picHeight >> getComponentScaleY( ComponentID( c ), m_chromaFormat );
+  }
+  alfgpu::Timing t;
+  m_alfGpu->prefetchOriginal( o, m_gpuSlot, t );
+  if( AlfProfiler::get().enabled() ) AlfProfiler::get().addGpu( t );
+  m_gpuOrgPoc = slice.poc;
+  m_gpuOrgPic = slice.pic;
+}
+
+// ====================================================================================================================
+// CCALF statistics on the GPU: one call per picture at the start of the CCALF derivation (all CTU rows are ALF
+// reconstructed then); the luma input is the pre-ALF luma still resident from the classification
+// ====================================================================================================================
+bool EncAdaptiveLoopFilter::gpuCcAlfStatsActive( const Picture& pic ) const
+{
+  return m_alfGpu && m_gpuCcAlf && ( m_alfGpuMode == alfgpu::MODE_FULL || m_alfGpuMode == alfgpu::MODE_VERIFY )
+      && !m_gpuRowMode && !m_encCfg->m_ifpLines && m_gpuResPic == &pic && m_gpuResPoc == pic.getPOC();
+}
+
+void EncAdaptiveLoopFilter::xGpuCcAlfStatsFrame( CodingStructure& cs )
+{
+  const PreCalcValues& pcv = *cs.pcv;
+  m_gpuCcCtu.assign( pcv.sizeInCtus, 0 );
+  std::vector<int> ctus;
+  for( int ctu = 0; ctu < ( int ) pcv.sizeInCtus; ctu++ ) if( m_gpuClsMap[ctu] >= 0 ) ctus.push_back( ctu );
+  if( ctus.empty() ) return;
+  m_gpuCcElem = alfgpu::covElements( MAX_NUM_CC_ALF_CHROMA_COEFF - 1, 1 );
+  const int ne = ( int ) m_gpuCcElem.size();
+  const bool orgResident = m_gpuOrgPic == cs.picture && m_gpuOrgPoc == cs.slice->poc;
+  const PelUnitBuf orgYuv = cs.picture->getOrigBuf();
+  alfgpu::CcAlfJob jobs[2];
+  std::vector<int16_t> rects[2];
+  for( int j = 0; j < 2; j++ )
+  {
+    const ComponentID compID = ComponentID( j + 1 );
+    const int sx = getComponentScaleX( compID, m_chromaFormat ), sy = getComponentScaleY( compID, m_chromaFormat );
+    for( int ctu : ctus )
+    {
+      const int x0 = ( ctu % pcv.widthInCtus ) << pcv.maxCUSizeLog2, y0 = ( ctu / pcv.widthInCtus ) << pcv.maxCUSizeLog2;
+      const int w = std::min<int>( pcv.maxCUSize, m_picWidth - x0 ), h = std::min<int>( pcv.maxCUSize, m_picHeight - y0 );
+      rects[j].push_back( ( int16_t ) ( x0 >> sx ) ); rects[j].push_back( ( int16_t ) ( y0 >> sy ) );
+      rects[j].push_back( ( int16_t ) ( w >> sx ) );  rects[j].push_back( ( int16_t ) ( h >> sy ) );
+    }
+    alfgpu::CcAlfJob& jb = jobs[j];
+    const CPelBuf slf = cs.getRecoBuf( compID );
+    const CPelBuf org = orgYuv.get( compID );
+    jb.comp      = j + 1;
+    jb.slf       = slf.bufAt( 0, 0 );
+    jb.slfStride = slf.stride;
+    jb.org       = orgResident ? nullptr : org.bufAt( 0, 0 );
+    jb.orgStride = org.stride;
+    jb.width     = m_picWidth >> sx;
+    jb.height    = m_picHeight >> sy;
+    jb.k            = alfgpu::CovKParams();
+    jb.k.numCoeff   = MAX_NUM_CC_ALF_CHROMA_COEFF - 1;
+    jb.k.numBins    = 1;
+    jb.k.numClasses = 1;
+    jb.k.numElem    = ne;
+    jb.k.ccalf      = 1;
+    jb.k.sx         = sx;
+    jb.k.sy         = sy;
+    jb.k.vbH        = m_alfVBLumaCTUHeight;
+    jb.k.vbPos      = m_alfVBLumaPos;
+    jb.k.lumaPicH   = m_picHeight;
+    jb.k.ctuSize    = m_maxCUHeight;
+    jb.numUnits     = ( int ) ctus.size();
+    jb.ctuRect      = rects[j].data();
+    jb.elem         = m_gpuCcElem.data();
+    m_gpuCcOut[j].resize( ( size_t ) jb.numUnits * ne );
+    jb.out          = m_gpuCcOut[j].data();
+  }
+  alfgpu::Timing t;
+  uint64_t values = 0, errors = 0;
+  {
+    AlfProfScope profScope( ALFP_CCALF_STATS_GPU );
+    m_alfGpu->ccalfStatsFrame( jobs, 2, m_gpuSlot, t );
+    for( int j = 0; j < 2; j++ )
+    {
+      for( int i = 0; i < ( int ) ctus.size(); i++ )
+      {
+        AlfCovariance& cv = m_alfCovarianceCcAlf[j][0][ctus[i]];
+        const float* v = &m_gpuCcOut[j][( size_t ) i * ne];
+        if( m_alfGpuMode == alfgpu::MODE_FULL )
+        {
+          cv.reset();
+          for( int e = 0; e < ne; e++ )
+          {
+            const uint32_t d = m_gpuCcElem[e];
+            switch( alfgpu::covKind( d ) )
+            {
+            case 0:  cv.E[0][0][alfgpu::covK( d )][alfgpu::covL( d )] = v[e]; break;
+            case 1:  cv.y[0][alfgpu::covK( d )] = v[e]; break;
+            default: cv.pixAcc = v[e]; break;
+            }
+          }
+          for( int k = 1; k < MAX_NUM_CC_ALF_CHROMA_COEFF - 1; k++ )
+            for( int l = 0; l < k; l++ ) cv.E[0][0][k][l] = cv.E[0][0][l][k];
+        }
+        else
+        {
+          for( int e = 0; e < ne; e++ )
+          {
+            const uint32_t d = m_gpuCcElem[e];
+            float ref;
+            switch( alfgpu::covKind( d ) )
+            {
+            case 0:  ref = cv.E[0][0][alfgpu::covK( d )][alfgpu::covL( d )]; break;
+            case 1:  ref = cv.y[0][alfgpu::covK( d )]; break;
+            default: ref = cv.pixAcc; break;
+            }
+            values++;
+            if( std::memcmp( &ref, &v[e], sizeof( float ) ) != 0 && errors++ < 5 )
+              fprintf( stderr, "[AlfGpu] VERIFY CCALF statistics mismatch comp %d ctu %d element %d: gpu %.9g vvenc %.9g\n", j + 1, ctus[i], e, v[e], ref );
+          }
+        }
+      }
+    }
+  }
+  for( int ctu : ctus ) m_gpuCcCtu[ctu] = 1;
+  m_gpuCcPoc = cs.slice->poc;
+  if( AlfProfiler::get().enabled() ) AlfProfiler::get().addGpu( t );
+  if( m_alfGpuMode == alfgpu::MODE_VERIFY ) AlfProfiler::get().addVerifyCcAlf( values, errors );
+}
+
+// VVenC classification (computed during ALF_GET_STATISTICS) of the CTUs with setIdx >= 0, packed (classIdx | transposeIdx << 5)
+void EncAdaptiveLoopFilter::xPackCpuClasses( const CodingStructure& cs, const int firstCtuRow, const int bandH, const int16_t* setIdx, std::vector<uint8_t>& cls )
+{
+  const PreCalcValues& pcv = *cs.pcv;
+  const int numCols = pcv.widthInCtus, ctuSize = pcv.maxCUSize, picW = pcv.lumaWidth;
+  const int clsStride = picW >> 2, numClassBlocksInCTU = ( MAX_CU_SIZE * MAX_CU_SIZE ) >> 4;
+  cls.assign( ( size_t ) clsStride * ( ( bandH + 3 ) >> 2 ), 0 );
+  const int ctuRows = ( bandH + ctuSize - 1 ) / ctuSize;
+  for( int r = 0; r < ctuRows; r++ )
+    for( int col = 0; col < numCols; col++ )
+    {
+      if( setIdx[r * numCols + col] < 0 ) continue;
+      const int ctu = ( firstCtuRow + r ) * numCols + col;
+      const int x0 = col * ctuSize, y0 = r * ctuSize;
+      const int w = std::min( ctuSize, picW - x0 ), h = std::min( ctuSize, bandH - y0 );
+      const AlfClassifier* cl = &m_classifier[numClassBlocksInCTU * ctu];
+      for( int by = 0; by < h; by += 4 )
+        for( int bx = 0; bx < w; bx += 4 )
+        {
+          const AlfClassifier& a = cl[( by >> 2 ) * ( MAX_CU_SIZE >> 2 ) + ( bx >> 2 )];
+          cls[( ( y0 + by ) >> 2 ) * clsStride + ( ( x0 + bx ) >> 2 )] = ( uint8_t ) ( a.classIdx | ( a.transposeIdx << 5 ) );
+        }
+    }
+}
+
+// runs the backend on CTU rows [firstCtuRow, firstCtuRow + numCtuRows); returns the number of CTUs sent to it
+int EncAdaptiveLoopFilter::xGpuFilterBand( CodingStructure& cs, const int firstCtuRow, const int numCtuRows, const int16_t* setIdx,
+                                          Pel* dst, ptrdiff_t dstStride, uint8_t* outClass, std::vector<uint8_t>& clsCpu, const int threadIdx )
+{
+  const PreCalcValues& pcv = *cs.pcv;
+  const int numCols = pcv.widthInCtus;
+  const int bandY0  = firstCtuRow << pcv.maxCUSizeLog2;
+  const int bandH   = std::min<int>( numCtuRows << pcv.maxCUSizeLog2, pcv.lumaHeight - bandY0 );
+  int numGpu = 0;
+  for( int i = 0; i < numCtuRows * numCols; i++ ) numGpu += setIdx[i] >= 0;
+  const bool verify = m_alfGpuMode == alfgpu::MODE_VERIFY;
+  if( m_alfGpuMode == alfgpu::MODE_FILTER || verify ) xPackCpuClasses( cs, firstCtuRow, bandH, setIdx, clsCpu );
+  if( !numGpu ) return 0;
+
+  alfgpu::BandParams bp;
+  xFillBandParams( cs, bp, bandY0, bandH, setIdx );
+  bp.cpuClass   = m_alfGpuMode == alfgpu::MODE_FILTER ? clsCpu.data() : nullptr;
+  bp.dst        = dst;
+  bp.dstStride  = dstStride;
+  bp.outClass   = outClass;
+
+  alfgpu::Timing t;
+  {
+    AlfProfScope profScope( ALFP_RECON_LUMA_GPU );
+    m_alfGpu->filterLumaBand( bp, verify ? alfgpu::MODE_FULL : m_alfGpuMode, threadIdx, t );
+  }
+  if( AlfProfiler::get().enabled() ) AlfProfiler::get().addGpu( t );
+  return numGpu;
+}
+
+// compares the backend output of CTU row ctuRow (rows/classes given relative to bandY0) with VVenC's result in recY
+void EncAdaptiveLoopFilter::xGpuVerifyRow( CodingStructure& cs, const int ctuRow, const int16_t* setIdxRow, const Pel* gpuOut, const int gpuStride,
+                                          const uint8_t* clsGpu, const uint8_t* clsCpu, const int bandRowOffset )
+{
+  const PreCalcValues& pcv = *cs.pcv;
+  const int numCols = pcv.widthInCtus, ctuSize = pcv.maxCUSize, picW = pcv.lumaWidth, clsStride = picW >> 2;
+  const int y0 = ctuRow << pcv.maxCUSizeLog2, h = std::min<int>( ctuSize, pcv.lumaHeight - y0 );
+  const CPelBuf recY = cs.getRecoBuf( COMP_Y );
+  uint64_t samples = 0, sampleErr = 0, blocks = 0, blockErr = 0;
+  for( int col = 0; col < numCols; col++ )
+  {
+    if( setIdxRow[col] < 0 ) continue;
+    const int x0 = col * ctuSize, w = std::min( ctuSize, picW - x0 );
+    for( int y = 0; y < h; y++ )
+      for( int x = x0; x < x0 + w; x++ )
+      {
+        samples++;
+        const Pel g = gpuOut[( size_t ) ( bandRowOffset + y ) * gpuStride + x], r = recY.at( x, y0 + y );
+        if( g != r && sampleErr++ < 5 )
+          fprintf( stderr, "[AlfGpu] VERIFY sample mismatch POC %d (%d,%d): gpu=%d vvenc=%d\n", cs.slice->poc, x, y0 + y, g, r );
+      }
+    for( int by = 0; by < h; by += 4 )
+      for( int bx = x0; bx < x0 + w; bx += 4 )
+      {
+        blocks++;
+        const size_t i = ( size_t ) ( ( bandRowOffset + by ) >> 2 ) * clsStride + ( bx >> 2 );
+        if( clsGpu[i] != clsCpu[i] && blockErr++ < 5 )
+          fprintf( stderr, "[AlfGpu] VERIFY class mismatch POC %d (%d,%d): gpu=(%d,%d) vvenc=(%d,%d)\n", cs.slice->poc, bx, y0 + by,
+                   clsGpu[i] & 31, clsGpu[i] >> 5, clsCpu[i] & 31, clsCpu[i] >> 5 );
+      }
+  }
+  AlfProfiler::get().addVerify( samples, sampleErr, blocks, blockErr );
+}
+
+void EncAdaptiveLoopFilter::reconstructLumaFrameGpu( Picture& pic, CodingStructure& cs, const int threadIdx )
+{
+  m_gpuFrameDone = false;
+  if( !m_alfGpuMode || !m_alfGpu || isSkipAlfForFrame( pic ) ) return;
+  if( const char* e = getenv( "VVENC_ALF_GPU_ROWMODE" ) ) { if( atoi( e ) ) return; }
+
+  const PreCalcValues& pcv = *cs.pcv;
+  const int numCtus = pcv.sizeInCtus;
+  m_gpuFrameSet.assign( numCtus, -1 );
+  for( int ctu = 0; ctu < numCtus; ctu++ ) m_gpuFrameSet[ctu] = ( int16_t ) xGpuSetIdx( cs, ctu );
+
+  const bool verify = m_alfGpuMode == alfgpu::MODE_VERIFY;
+  if( xGpuClassesValid( pic, cs.slice->poc ) )
+  {
+    // picture and classes are still on the device (gpuClassifyFrame): only the decisions go up, the filtered CTUs come back
+    m_gpuClsPic = nullptr;
+    int numGpu = 0;
+    for( int ctu = 0; ctu < numCtus; ctu++ )
+    {
+      if( m_gpuClsMap[ctu] < 0 ) m_gpuFrameSet[ctu] = -1;
+      numGpu += m_gpuFrameSet[ctu] >= 0;
+    }
+    alfgpu::BandParams bp;
+    xFillBandParams( cs, bp, 0, pcv.lumaHeight, m_gpuFrameSet.data() );
+    PelBuf recY = cs.getRecoBufRef().get( COMP_Y );
+    bp.dst = recY.bufAt( 0, 0 ); bp.dstStride = recY.stride;
+    if( verify )
+    {
+      m_gpuFrameOut.assign( ( size_t ) pcv.lumaWidth * pcv.lumaHeight, 0 );
+      bp.dst = m_gpuFrameOut.data(); bp.dstStride = pcv.lumaWidth;
+      m_gpuFrameCls = m_gpuClsFrame;                                              // GPU classes from the start of the ALF
+      xPackCpuClasses( cs, 0, pcv.lumaHeight, m_gpuFrameSet.data(), m_gpuFrameClsCpu ); // VVenC classes (CPU, statistics)
+    }
+    if( numGpu )
+    {
+      alfgpu::Timing t;
+      {
+        AlfProfScope profScope( ALFP_RECON_LUMA_GPU );
+        m_alfGpu->filterFrameResident( bp, m_gpuSlot, t );
+      }
+      if( AlfProfiler::get().enabled() ) AlfProfiler::get().addGpu( t );
+    }
+    m_gpuFrameDone = true;
+    return;
+  }
+
+  PelBuf recY = cs.getRecoBufRef().get( COMP_Y );
+  Pel*      dst       = recY.bufAt( 0, 0 );
+  ptrdiff_t dstStride = recY.stride;
+  uint8_t*  outClass  = nullptr;
+  if( verify )
+  {
+    m_gpuFrameOut.assign( ( size_t ) pcv.lumaWidth * pcv.lumaHeight, 0 );
+    m_gpuFrameCls.assign( ( size_t ) ( pcv.lumaWidth >> 2 ) * ( ( pcv.lumaHeight + 3 ) >> 2 ), 0 );
+    dst = m_gpuFrameOut.data(); dstStride = pcv.lumaWidth; outClass = m_gpuFrameCls.data();
+  }
+  xGpuFilterBand( cs, 0, pcv.heightInCtus, m_gpuFrameSet.data(), dst, dstStride, outClass, m_gpuFrameClsCpu, threadIdx );
+  m_gpuFrameDone = true;
+}
+
+void EncAdaptiveLoopFilter::reconstructCtuRow( Picture& pic, CodingStructure& cs, const int firstCtu, const int lastCtu, PelStorage& alfTempCtuBuf, const int threadIdx )
+{
+  if( !m_alfGpuMode || !m_alfGpu || isSkipAlfForFrame( pic ) )
+  {
+    for( int ctu = firstCtu; ctu <= lastCtu; ctu++ )
+    {
+      reconstructCTU_MT( pic, cs, ctu, alfTempCtuBuf );
+    }
+    return;
+  }
+
+  const PreCalcValues& pcv = *cs.pcv;
+  const int  numCols = pcv.widthInCtus;
+  const int  ctuRow  = firstCtu / numCols;
+  const bool verify  = m_alfGpuMode == alfgpu::MODE_VERIFY;
+  CHECK( lastCtu / numCols != ctuRow, "ALF GPU: CTU range must be inside one CTU row" );
+
+  if( m_gpuFrameDone )
+  {
+    // frame mode: luma of the eligible CTUs was already filtered by the backend after the derivation
+    const int16_t* setRow = &m_gpuFrameSet[ctuRow * numCols];
+    for( int ctu = firstCtu; ctu <= lastCtu; ctu++ )
+    {
+      reconstructCTU_MT( pic, cs, ctu, alfTempCtuBuf, !verify && setRow[ctu % numCols] >= 0 );
+    }
+    if( verify )
+    {
+      std::vector<int16_t> sub( numCols, -1 );   // only the CTUs of this task
+      for( int ctu = firstCtu; ctu <= lastCtu; ctu++ ) sub[ctu % numCols] = setRow[ctu % numCols];
+      xGpuVerifyRow( cs, ctuRow, sub.data(), m_gpuFrameOut.data(), pcv.lumaWidth, m_gpuFrameCls.data(), m_gpuFrameClsCpu.data(),
+                     ctuRow << pcv.maxCUSizeLog2 );
+    }
+    return;
+  }
+
+  // row mode
+  std::vector<int16_t> setIdx( numCols, -1 );
+  for( int ctu = firstCtu; ctu <= lastCtu; ctu++ ) setIdx[ctu % numCols] = ( int16_t ) xGpuSetIdx( cs, ctu );
+
+  const int bandH = std::min<int>( pcv.maxCUSize, pcv.lumaHeight - ( ctuRow << pcv.maxCUSizeLog2 ) );
+  std::vector<uint8_t> clsCpu, clsGpu;
+  std::vector<Pel>     gpuOut;
+  PelBuf recY = cs.getRecoBufRef().get( COMP_Y );
+  int numGpu;
+  if( verify )
+  {
+    gpuOut.assign( ( size_t ) pcv.lumaWidth * bandH, 0 );
+    clsGpu.assign( ( size_t ) ( pcv.lumaWidth >> 2 ) * ( ( bandH + 3 ) >> 2 ), 0 );
+    numGpu = xGpuFilterBand( cs, ctuRow, 1, setIdx.data(), gpuOut.data(), pcv.lumaWidth, clsGpu.data(), clsCpu, threadIdx );
+  }
+  else
+  {
+    numGpu = xGpuFilterBand( cs, ctuRow, 1, setIdx.data(), recY.bufAt( 0, ctuRow << pcv.maxCUSizeLog2 ), recY.stride, nullptr, clsCpu, threadIdx );
+  }
+
+  for( int ctu = firstCtu; ctu <= lastCtu; ctu++ )
+  {
+    reconstructCTU_MT( pic, cs, ctu, alfTempCtuBuf, !verify && setIdx[ctu % numCols] >= 0 );
+  }
+  if( verify && numGpu )
+  {
+    xGpuVerifyRow( cs, ctuRow, setIdx.data(), gpuOut.data(), pcv.lumaWidth, clsGpu.data(), clsCpu.data(), 0 );
+  }
+}
