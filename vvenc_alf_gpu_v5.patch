+  for( int16_t s : f.ctuSet ) numFiltered += s >= 0;
+  printf( "frame %dx%d, %d-bit, CTU %d, VB at %d, %d/%d CTUs filtered, %d APS sets%s\n", f.W, f.H, f.bitDepth, f.ctu, f.vbPos,
+          numFiltered, f.numCols * f.numRows, f.numAps, dump ? " (VVenC dump)" : " (CSV)" );
+
+  // the whole frame is one band (bandY0 = 0): identical results to VVenC's CTU-row bands because
+  // all VB / boundary decisions use global coordinates
+  BandParams bp{};
+  bp.src = f.at0(); bp.srcStride = f.pitch; bp.picWidth = f.W; bp.bandY0 = 0; bp.bandH = f.H; bp.ctuSize = f.ctu;
+  bp.numCtuCols = f.numCols; bp.bitDepth = f.bitDepth; bp.vbH = f.vbH; bp.vbPos = f.vbPos; bp.ctuSetIdx = f.ctuSet.data();
+  const int clsStride = f.W >> 2, clsRows = ( f.H + 3 ) >> 2;
+  const size_t outN = ( size_t ) f.W * f.H, clsN = ( size_t ) clsStride * clsRows, inN = f.pix.size();
+
+  // ------------------------------------------------------------------ CPU reference (1 thread)
+  std::vector<uint8_t> refCls( clsN, 255 );
+  std::vector<Pel> refOut( outN, 0 );
+  Rapl rapl;
+  Stat cpuCls, cpuFlt, cpuTot;
+  {
+    // CPU idle baseline
+    double cpuIdleW = -1;
+    if( rapl.ok() && idleMs > 0 )
+    {
+      double e0 = rapl.joules(); auto t0 = clk::now();
+      std::this_thread::sleep_for( std::chrono::milliseconds( idleMs ) );
+      cpuIdleW = ( rapl.joules() - e0 ) / ( msSince( t0 ) * 1e-3 );
+    }
+    int n = 0; const auto tStart = clk::now(); const double e0 = rapl.ok() ? rapl.joules() : 0;
+    while( true )
+    {
+      auto t0 = clk::now();
+      hostClassifyBand( f.at0(), f.pitch, bp, refCls.data(), clsStride );
+      const double a = msSince( t0 ); auto t1 = clk::now();
+      hostFilterBand( f.at0(), f.pitch, bp, f.coef.data(), f.clip.data(), refCls.data(), clsStride, refOut.data(), f.W );
+      const double b = msSince( t1 );
+      cpuCls.add( a ); cpuFlt.add( b ); cpuTot.add( a + b ); n++;
+      if( ( iters > 0 && n >= iters ) || ( iters <= 0 && msSince( tStart ) > minSeconds * 1e3 && n >= 3 ) ) break;
+    }
+    const double s = msSince( tStart ) * 1e-3, e = rapl.ok() ? rapl.joules() - e0 : -1;
+    printf( "\nCPU reference (1 thread, shared core, %d iterations)\n", n );
+    printStat( "classification", cpuCls ); printStat( "filter", cpuFlt ); printStat( "total", cpuTot );
+    if( rapl.ok() )
+      printf( "  energy (RAPL package): %.4f J/frame total, idle %.2f W -> dynamic %.4f J/frame\n", e / n, cpuIdleW, ( e - cpuIdleW * s ) / n );
+    else
+      printf( "  energy: RAPL not readable (run as root or chmod o+r /sys/class/powercap/intel-rapl:*/energy_uj)\n" );
+  }
+  if( !f.vvencCls.empty() )
+  {
+    size_t bad = 0, cnt = 0;
+    for( size_t i = 0; i < clsN; i++ ) if( f.vvencCls[i] != 255 ) { cnt++; bad += f.vvencCls[i] != refCls[i]; }
+    printf( "  classification vs VVenC (dump): %zu blocks, %zu mismatches\n", cnt, bad );
+  }
+
+  auto writeOutputs = [&]( const Pel* out, const uint8_t* cls )
+  {
+    if( outCsv )
+    {
+      if( FILE* o = fopen( outCsv, "w" ) )
+      {
+        for( int y = 0; y < f.H; y++ )
+        {
+          for( int x = 0; x < f.W; x++ )
+          {
+            const bool filt = f.ctuSet[( y / f.ctu ) * f.numCols + x / f.ctu] >= 0;
+            fprintf( o, x ? ",%d" : "%d", filt ? out[( size_t ) y * f.W + x] : f.at0()[( size_t ) y * f.pitch + x] );
+          }
+          fprintf( o, "\n" );
+        }
+        fclose( o );
+      }
+    }
+    if( clsCsv )
+    {
+      if( FILE* o = fopen( clsCsv, "w" ) )
+      {
+        for( int y = 0; y < clsRows; y++ )
+        {
+          for( int x = 0; x < clsStride; x++ ) fprintf( o, x ? ",%d" : "%d", cls[y * clsStride + x] == 255 ? -1 : cls[y * clsStride + x] & 31 );
+          fprintf( o, "\n" );
+        }
+        fclose( o );
+      }
+    }
+  };
+
+  // ------------------------------------------------------------------ GPU
+  int ndev = 0;
+  if( cudaGetDeviceCount( &ndev ) != cudaSuccess || ndev == 0 )
+  {
+    printf( "\nno CUDA device - single-stream GPU part skipped (--out/--classes contain the CPU reference)\n" );
+    Stat sSpan, sCall; bool ex = false;
+    runBackendPipeline( f, bp, refOut, refCls, cpuClass, iters, 1, minSeconds, cpuTot.mean(), sSpan, sCall, ex );
+    writeOutputs( refOut.data(), refCls.data() );
+    return ex ? 0 : 2;
+  }
+  CK( cudaSetDevice( device ) );
+  {
+    char d[16]; snprintf( d, sizeof( d ), "%d", device );
+    // the encoder backend uses the same device
+#if defined( _WIN32 )
+    if( !getenv( "VVENC_ALF_GPU_DEVICE" ) ) _putenv_s( "VVENC_ALF_GPU_DEVICE", d );
+#else
+    setenv( "VVENC_ALF_GPU_DEVICE", d, 0 );
+#endif
+  }
+  cudaDeviceProp prop; CK( cudaGetDeviceProperties( &prop, device ) );
+  printf( "\nGPU: %s (sm_%d%d), %s host buffers, classification on %s\n", prop.name, prop.major, prop.minor,
+          pinned ? "pinned" : "pageable", cpuClass ? "CPU (uploaded)" : "GPU" );
+  Nvml nvml; nvml.init( device );
+
+  Pel *hIn, *hOut; uint8_t* hCls;
+  if( pinned ) { CK( cudaMallocHost( &hIn, inN * sizeof( Pel ) ) ); CK( cudaMallocHost( &hOut, outN * sizeof( Pel ) ) ); CK( cudaMallocHost( &hCls, clsN ) ); }
+  else { hIn = ( Pel* ) malloc( inN * sizeof( Pel ) ); hOut = ( Pel* ) malloc( outN * sizeof( Pel ) ); hCls = ( uint8_t* ) malloc( clsN ); }
+  memcpy( hIn, f.pix.data(), inN * sizeof( Pel ) );
+  if( cpuClass ) memcpy( hCls, refCls.data(), clsN );
+
+  Pel *dIn, *dOut; uint8_t* dCls; int16_t *dMap, *dCoef, *dClip;
+  CK( cudaMalloc( &dIn, inN * sizeof( Pel ) ) );   CK( cudaMalloc( &dOut, outN * sizeof( Pel ) ) );
+  CK( cudaMalloc( &dCls, clsN ) );                 CK( cudaMalloc( &dMap, f.ctuSet.size() * sizeof( int16_t ) ) );
+  CK( cudaMalloc( &dCoef, f.coef.size() * sizeof( int16_t ) ) ); CK( cudaMalloc( &dClip, f.clip.size() * sizeof( int16_t ) ) );
+  CK( cudaMemset( dOut, 0, outN * sizeof( Pel ) ) );
+  // fixed sets are resident; the APS sets (as in the encoder) are uploaded every frame
+  CK( cudaMemcpy( dCoef, f.coef.data(), f.coef.size() * sizeof( int16_t ), cudaMemcpyHostToDevice ) );
+  CK( cudaMemcpy( dClip, f.clip.data(), f.clip.size() * sizeof( int16_t ), cudaMemcpyHostToDevice ) );
+
+  KParams k;
+  k.picWidth = f.W; k.bandY0 = 0; k.bandH = f.H; k.ctuSize = f.ctu; k.numCtuCols = f.numCols; k.bitDepth = f.bitDepth;
+  k.vbH = f.vbH; k.vbPos = f.vbPos; k.inPitch = f.pitch; k.clsStride = clsStride; k.outPitch = f.W;
+
+  cudaStream_t s; CK( cudaStreamCreate( &s ) );
+  cudaEvent_t ev[5]; for( auto& e : ev ) CK( cudaEventCreate( &e ) );
+  const size_t apsN = ( size_t ) f.numAps * kSetStride;
+
+  auto runOnce = [&]( double* seg, double& wall )
+  {
+    auto t0 = clk::now();
+    CK( cudaEventRecord( ev[0], s ) );
+    CK( cudaMemcpyAsync( dIn, hIn, inN * sizeof( Pel ), cudaMemcpyHostToDevice, s ) );
+    CK( cudaMemcpyAsync( dMap, f.ctuSet.data(), f.ctuSet.size() * sizeof( int16_t ), cudaMemcpyHostToDevice, s ) );
+    if( apsN )
+    {
+      CK( cudaMemcpyAsync( dCoef + kNumFixedSets * kSetStride, &f.coef[kNumFixedSets * kSetStride], apsN * sizeof( int16_t ), cudaMemcpyHostToDevice, s ) );
+      CK( cudaMemcpyAsync( dClip + kNumFixedSets * kSetStride, &f.clip[kNumFixedSets * kSetStride], apsN * sizeof( int16_t ), cudaMemcpyHostToDevice, s ) );
+    }
+    if( cpuClass ) CK( cudaMemcpyAsync( dCls, hCls, clsN, cudaMemcpyHostToDevice, s ) );
+    CK( cudaEventRecord( ev[1], s ) );
+    if( !cpuClass ) launchAlfClassify( dIn, dMap, dCls, k, s );
+    CK( cudaEventRecord( ev[2], s ) );
+    launchAlfFilterLuma( dIn, dMap, dCls, dCoef, dClip, dOut, k, s );
+    CK( cudaEventRecord( ev[3], s ) );
+    CK( cudaMemcpyAsync( hOut, dOut, outN * sizeof( Pel ), cudaMemcpyDeviceToHost, s ) );
+    CK( cudaEventRecord( ev[4], s ) );
+    CK( cudaEventSynchronize( ev[4] ) );
+    wall = msSince( t0 );
+    float m;
+    for( int i = 0; i < 4; i++ ) { CK( cudaEventElapsedTime( &m, ev[i], ev[i + 1] ) ); seg[i] = m; }
+    CK( cudaGetLastError() );
+  };
+
+  double seg[4], wall;
+  for( int i = 0; i < warmup; i++ ) runOnce( seg, wall );
+
+  // GPU / CPU idle baselines just before the measurement
+  double gpuIdleW = -1, cpuIdleW = -1;
+  if( idleMs > 0 )
+  {
+    double acc = 0; int n = 0; const double e0 = rapl.ok() ? rapl.joules() : 0; auto t0 = clk::now();
+    for( int t = 0; t < idleMs; t += 10 ) { std::this_thread::sleep_for( std::chrono::milliseconds( 10 ) ); double w = nvml.watts(); if( w >= 0 ) { acc += w; n++; } }
+    gpuIdleW = n ? acc / n : -1;
+    if( rapl.ok() ) cpuIdleW = ( rapl.joules() - e0 ) / ( msSince( t0 ) * 1e-3 );
+  }
+
+  Stat sH2D, sCls, sFlt, sD2H, sComm, sExec, sWall;
+  int n = 0; const auto tStart = clk::now();
+  const double g0 = nvml.joules(), c0 = rapl.ok() ? rapl.joules() : 0;
+  while( true )
+  {
+    runOnce( seg, wall );
+    sH2D.add( seg[0] ); sCls.add( seg[1] ); sFlt.add( seg[2] ); sD2H.add( seg[3] );
+    sComm.add( seg[0] + seg[3] ); sExec.add( seg[1] + seg[2] ); sWall.add( wall ); n++;
+    if( ( iters > 0 && n >= iters ) || ( iters <= 0 && msSince( tStart ) > minSeconds * 1e3 && n >= 10 ) ) break;
+  }
+  const double secs = msSince( tStart ) * 1e-3;
+  const double gJ = nvml.energyOk ? nvml.joules() - g0 : -1, cJ = rapl.ok() ? rapl.joules() - c0 : -1;
+
+  printf( "GPU (%d iterations, CUDA events)\n", n );
+  printStat( "H2D (input band + CTU map + APS)", sH2D );
+  printStat( "classification kernel", sCls );
+  printStat( "filter kernel", sFlt );
+  printStat( "D2H (filtered frame)", sD2H );
+  printStat( "communication (H2D + D2H)", sComm );
+  printStat( "execution (kernels)", sExec );
+  printStat( "total (wall clock, incl. sync)", sWall );
+  printf( "  H2D %.2f MB -> %.2f GB/s, D2H %.2f MB -> %.2f GB/s\n", inN * 2e-6, inN * 2e-6 / sH2D.mean(), outN * 2e-6, outN * 2e-6 / sD2H.mean() );
+  if( gJ >= 0 )
+    printf( "  energy GPU (NVML counter): %.4f J/frame total, idle %.2f W -> dynamic %.4f J/frame\n", gJ / n, gpuIdleW, ( gJ - gpuIdleW * secs ) / n );
+  else
+    printf( "  energy GPU: NVML energy counter not supported on this GPU (needs Volta or newer)\n" );
+  if( cJ >= 0 )
+    printf( "  energy CPU during GPU run (RAPL): %.4f J/frame total, idle %.2f W -> dynamic %.4f J/frame\n", cJ / n, cpuIdleW, ( cJ - cpuIdleW * secs ) / n );
+  printf( "  speed-up vs CPU reference: kernels only %.2fx, end-to-end %.2fx\n", cpuTot.mean() / sExec.mean(), cpuTot.mean() / sWall.mean() );
+
+  // ------------------------------------------------------------------ bit-exactness
+  std::vector<uint8_t> gpuCls( clsN );
+  CK( cudaMemcpy( gpuCls.data(), dCls, clsN, cudaMemcpyDeviceToHost ) );
+  size_t badPix = 0, nPix = 0, badCls = 0, nCls = 0;
+  for( int y = 0; y < f.H; y++ )
+    for( int x = 0; x < f.W; x++ )
+    {
+      if( f.ctuSet[( y / f.ctu ) * f.numCols + x / f.ctu] < 0 ) continue;
+      nPix++;
+      if( hOut[( size_t ) y * f.W + x] != refOut[( size_t ) y * f.W + x] && badPix++ < 5 )
+        printf( "  mismatch (%d,%d): gpu %d cpu %d\n", x, y, hOut[( size_t ) y * f.W + x], refOut[( size_t ) y * f.W + x] );
+      if( ( x & 3 ) == 0 && ( y & 3 ) == 0 ) { nCls++; badCls += gpuCls[( y >> 2 ) * clsStride + ( x >> 2 )] != refCls[( y >> 2 ) * clsStride + ( x >> 2 )]; }
+    }
+  printf( "\nbit-exactness: %zu samples / %zu mismatches, %zu classes / %zu mismatches -> %s\n", nPix, badPix, nCls, badCls,
+          ( badPix || badCls ) ? "NOT BIT-EXACT" : "BIT-EXACT" );
+
+  // ------------------------------------------------------------------ encoder backend (multi-stream frame pipeline)
+  Stat pSpan, pCall; bool pExact = false;
+  runBackendPipeline( f, bp, refOut, refCls, cpuClass, iters, warmup, minSeconds, cpuTot.mean(), pSpan, pCall, pExact );
+  if( !pExact ) badPix++;
+
+  // ------------------------------------------------------------------ outputs
+  writeOutputs( hOut, gpuCls.data() );
+  if( csvlog )
+  {
+    FILE* o = fopen( csvlog, "a" );
+    if( o )
+    {
+      fseek( o, 0, SEEK_END );
+      if( ftell( o ) == 0 )
+        fprintf( o, "label,width,height,gpu,pinned,cpu_class,cpu_class_ms,cpu_filter_ms,cpu_total_ms,h2d_ms,class_ms,filter_ms,d2h_ms,comm_ms,exec_ms,wall_ms,gpu_J_frame,gpu_idle_W,cpu_J_frame_gpu_run,bitexact,pipe_span_ms,pipe_call_ms\n" );
+      fprintf( o, "%s,%d,%d,%s,%d,%d,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,%.5f,%.2f,%.5f,%d,%.4f,%.4f\n", label, f.W, f.H, prop.name, pinned, cpuClass,
+               cpuCls.mean(), cpuFlt.mean(), cpuTot.mean(), sH2D.mean(), sCls.mean(), sFlt.mean(), sD2H.mean(), sComm.mean(), sExec.mean(), sWall.mean(),
+               gJ >= 0 ? gJ / n : -1.0, gpuIdleW, cJ >= 0 ? cJ / n : -1.0, ( badPix || badCls ) ? 0 : 1, pSpan.mean(), pCall.mean() );
+      fclose( o );
+    }
+  }
+
+  for( auto& e : ev ) cudaEventDestroy( e );
+  cudaStreamDestroy( s );
+  cudaFree( dIn ); cudaFree( dOut ); cudaFree( dCls ); cudaFree( dMap ); cudaFree( dCoef ); cudaFree( dClip );
+  if( pinned ) { cudaFreeHost( hIn ); cudaFreeHost( hOut ); cudaFreeHost( hCls ); } else { free( hIn ); free( hOut ); free( hCls ); }
+  if( nvml.ok ) nvmlShutdown();
+  return ( badPix || badCls ) ? 2 : 0;
+}
diff --git a/test/alfgpu/run_bitexact_tests.sh b/test/alfgpu/run_bitexact_tests.sh
new file mode 100755
index 0000000..6fe638f
--- /dev/null
+++ b/test/alfgpu/run_bitexact_tests.sh
@@ -0,0 +1,69 @@
+#!/usr/bin/env bash
+# Bit-exactness regression for --AlfGpu: encodes each configuration with the original CPU ALF (AlfGpu=0)
+# and with AlfGpu=1 (GPU classification+filter), AlfGpu=2 (GPU filter) and AlfGpu=3 (verify), then compares
+# bitstream and reconstruction MD5s. Without a CUDA build (or with VVENC_ALF_GPU_EMU=1) the host emulation
+# backend runs the same data flow on the CPU.
+#
+# usage: run_bitexact_tests.sh <vvencFFapp> <seq_dir> <out_dir>
+set -u
+APP=${1:-bin/release-static/vvencFFapp}
+SEQ=${2:-seq}
+OUT=${3:-alfgpu_tests}
+mkdir -p "$OUT"
+
+# name | input | size | extra options | environment (optional, for the ablation runs)
+# 480p / 720p / 1080p / 4K, all intra (-ip 1) and random access (default GOP), 8 and 10 bit input, linear and
+# non-linear ALF, CTU 64/128, IFP, tiles, several threads; the last rows switch single v5 stages off (env).
+CONFIGS=(
+  "ra_416_ctu128_t0|s416x240.yuv|416x240|--preset faster -f 8 -q 32 -t 0|"
+  "ra_416_ctu64_t0|s416x240.yuv|416x240|--preset fast -f 8 -q 27 -t 0 --CTUSize 64|"
+  "ra_416_nonlin_t0|s416x240.yuv|416x240|--preset faster -f 8 -q 37 -t 0 --UseNonLinearAlfLuma 1|"
+  "ra_416_nonlinYC_t0|s416x240.yuv|416x240|--preset faster -f 8 -q 32 -t 0 --UseNonLinearAlfLuma 1 --UseNonLinearAlfChroma 1|"
+  "ra_416_medium_t1|s416x240.yuv|416x240|--preset medium -f 4 -q 32 -t 1|"
+  "ai_480p_medium_t2|s832x480.yuv|832x480|--preset medium -f 2 -q 32 -t 2 -ip 1|"
+  "ra_480p_medium_nonlin_t2|s832x480.yuv|832x480|--preset medium -f 4 -q 32 -t 2 --UseNonLinearAlfLuma 1 --UseNonLinearAlfChroma 1|"
+  "ai_832x472_t2|s832x472.yuv|832x472|--preset faster -f 4 -q 30 -t 2 -ip 1|"
+  "ra_832x472_ifp_t4|s832x472.yuv|832x472|--preset faster -f 6 -q 32 -t 4 --IFP 1|"
+  "ra_832x472_tiles_t2|s832x472.yuv|832x472|--preset faster -f 6 -q 32 -t 2 --Tiles 2x1|"
+  "ai_720p_medium_t2|s1280x720.yuv|1280x720|--preset medium -f 2 -q 32 -t 2 -ip 1|"
+  "ra_720p_fast_t2|s1280x720.yuv|1280x720|--preset fast -f 4 -q 32 -t 2|"
+  "ra_1080p_t2|s1920x1080.yuv|1920x1080|--preset faster -f 4 -q 32 -t 2|"
+  "ai_1080p_10b_t2|s1920x1080_10b.yuv|1920x1080|--preset faster -f 1 -q 32 -t 2 -ip 1 --InputBitDepth 10|"
+  "ai_2160p_10b_t2|s3840x2160_10b.yuv|3840x2160|--preset faster -f 1 -q 32 -t 2 -ip 1 --InputBitDepth 10|"
+  "ra_2160p_10b_t2|s3840x2160_10b.yuv|3840x2160|--preset faster -f 2 -q 32 -t 2 --InputBitDepth 10|"
+  "abl_nofused_416|s416x240.yuv|416x240|--preset faster -f 4 -q 32 -t 1|VVENC_ALF_GPU_FUSED=0"
+  "abl_noprefetch_416|s416x240.yuv|416x240|--preset faster -f 4 -q 32 -t 1|VVENC_ALF_GPU_PREFETCH=0"
+  "abl_noderive_416|s416x240.yuv|416x240|--preset faster -f 4 -q 32 -t 1|VVENC_ALF_GPU_DERIVE=0"
+  "abl_noccalf_416|s416x240.yuv|416x240|--preset faster -f 4 -q 32 -t 1|VVENC_ALF_GPU_CCALF=0"
+  "abl_rowmode_416|s416x240.yuv|416x240|--preset faster -f 4 -q 32 -t 1|VVENC_ALF_GPU_ROWMODE=1"
+)
+
+fail=0
+printf "%-24s %-8s %-34s %-34s %s\n" config mode bitstream_md5 recon_md5 result
+for c in "${CONFIGS[@]}"; do
+  IFS='|' read -r name inp size opts envs <<< "$c"
+  ref_bs=""; ref_rec=""
+  for mode in 0 1 2 3; do
+    base="$OUT/${name}_m$mode"
+    # shellcheck disable=SC2086
+    env $envs "$APP" -i "$SEQ/$inp" -s "$size" -fr 30 --InputBitDepth 8 --InternalBitDepth 10 $opts \
+           --AlfGpu $mode -b "$base.266" -o "$base.yuv" > "$base.log" 2>&1
+    if [ $? -ne 0 ]; then echo "$name mode $mode: ENCODER FAILED (see $base.log)"; fail=1; continue; fi
+    bs=$(md5sum < "$base.266" | cut -c1-32); rec=$(md5sum < "$base.yuv" | cut -c1-32)
+    res="ref"
+    if [ $mode -eq 0 ]; then ref_bs=$bs; ref_rec=$rec
+    else
+      if [ "$bs" == "$ref_bs" ] && [ "$rec" == "$ref_rec" ]; then res="IDENTICAL"; else res="DIFFERENT"; fail=1; fi
+      if [ $mode -eq 3 ]; then
+        v=$(grep "VERIFY:" "$base.log" | tail -1)
+        case "$v" in *"-> BIT-EXACT"*) res="$res, verify BIT-EXACT";; *) res="$res, verify: ${v:-missing}"; fail=1;; esac
+      fi
+    fi
+    printf "%-24s %-8s %-34s %-34s %s\n" "$name" "$mode" "$bs" "$rec" "$res"
+  done
+  rm -f "$OUT/${name}"_m*.yuv
+done
+backend=$(grep -h "backend:" "$OUT"/*_m1.log | head -1)
+echo "${backend}"
+[ $fail -eq 0 ] && echo "ALL CONFIGURATIONS BIT-EXACT" || echo "SOME CONFIGURATIONS FAILED"
+exit $fail
diff --git a/test/alfgpu/test_alf_core.cpp b/test/alfgpu/test_alf_core.cpp
new file mode 100644
index 0000000..3d61144
--- /dev/null
+++ b/test/alfgpu/test_alf_core.cpp
@@ -0,0 +1,143 @@
+/* -----------------------------------------------------------------------------
+test_alf_core.cpp - compares the shared ALF core (AlfGpuCore.h) against VVenC's
+own classification and 7x7 luma filter (scalar AND SIMD versions) on synthetic
+10-bit pictures, for several CTU sizes, contents and random filter sets.
+
+Build (from the vvenc root, after building libvvenc):
+  g++ -O2 -std=gnu++14 -flto=auto -DTARGET_SIMD_X86=1 -DHAVE_PTHREADS \
+      -Iinclude -Ibuild/base -Isource/Lib -Isource/Lib/CommonLib -Isource/Lib/CommonLib/x86 \
+      test/alfgpu/test_alf_core.cpp lib/release-static/libvvenc.a -lpthread -o test_alf_core
+------------------------------------------------------------------------------- */
+
+#include "CommonLib/AdaptiveLoopFilter.h"
+#include "CommonLib/AlfGpuCore.h"
+
+#include <cstdio>
+#include <random>
+#include <vector>
+
+using namespace vvenc;
+
+static void fillPicture( std::vector<Pel>& buf, int stride, int margin, int W, int H, int content, std::mt19937& rng )
+{
+  Pel* p = &buf[margin * stride + margin];
+  std::uniform_int_distribution<int> u( 0, 1023 );
+  for( int y = 0; y < H; y++ )
+    for( int x = 0; x < W; x++ )
+    {
+      int v = 0;
+      switch( content )
+      {
+      case 0: v = u( rng ); break;                                                        // white noise, extremes
+      case 1: v = ( x * 7 + y * 3 ) % 1024; break;                                        // gradients / ramps
+      case 2: v = ( ( x / 9 + y / 5 ) & 1 ) ? 1023 : 0; break;                             // hard edges
+      case 3: v = std::min( 1023, std::max( 0, 512 + ( int ) ( 300 * std::sin( x * 0.07 ) * std::cos( y * 0.05 ) ) + u( rng ) % 40 - 20 ) ); break;
+      default: v = ( ( x ^ y ) & 8 ) ? u( rng ) : ( x * 4 ) % 1024; break;               // mixed texture
+      }
+      p[y * stride + x] = ( Pel ) v;
+    }
+  // replicate padding (VVenC extendBorderPel)
+  for( int y = 0; y < H; y++ )
+    for( int k = 1; k <= margin; k++ )
+    {
+      p[y * stride - k]         = p[y * stride];
+      p[y * stride + W - 1 + k] = p[y * stride + W - 1];
+    }
+  for( int k = 1; k <= margin; k++ )
+  {
+    memcpy( p - k * stride - margin, p - margin, ( W + 2 * margin ) * sizeof( Pel ) );
+    memcpy( p + ( H - 1 + k ) * stride - margin, p + ( H - 1 ) * stride - margin, ( W + 2 * margin ) * sizeof( Pel ) );
+  }
+}
+
+int main()
+{
+  std::mt19937 rng( 1234 );
+  const int bitDepth = 10, margin = 8;
+  const int clipVals[4] = { 1024, 128, 32, 8 };
+
+  AdaptiveLoopFilter alfSimd( true ), alfScalar( false );
+
+  long long blocks = 0, samples = 0, errCls = 0, errFlt = 0;
+
+  struct Cfg { int W, H, ctu; };
+  const Cfg cfgs[] = { { 416, 240, 64 }, { 416, 240, 128 }, { 832, 480, 128 }, { 256, 264, 64 }, { 1920, 1080, 128 } };
+
+  for( const Cfg& cfg : cfgs )
+  for( int content = 0; content < 5; content++ )
+  for( int useSimd = 0; useSimd < 2; useSimd++ )
+  for( int nonLin = 0; nonLin < 2; nonLin++ )
+  {
+    AdaptiveLoopFilter& alf = useSimd ? alfSimd : alfScalar;
+    const int W = cfg.W, H = cfg.H, S = cfg.ctu, vbH = S, vbPos = S - 4;
+    const int stride = W + 2 * margin;
+    std::vector<Pel> src( ( H + 2 * margin ) * stride ), dstRef( ( H + 2 * margin ) * stride, 0 );
+    fillPicture( src, stride, margin, W, H, content, rng );
+    const Pel* s = &src[margin * stride + margin];
+    Pel* dRef    = &dstRef[margin * stride + margin];
+
+    // random filter set: 25 classes x 13 coefficients
+    std::vector<short> coef( 325 ), clip( 325 );
+    std::uniform_int_distribution<int> uc( -128, 127 ), uk( 0, 3 );
+    for( int c = 0; c < 25; c++ )
+    {
+      for( int k = 0; k < 12; k++ )
+      {
+        coef[c * 13 + k] = ( short ) ( content == 0 ? uc( rng ) : uc( rng ) / 4 );
+        clip[c * 13 + k] = ( short ) ( nonLin ? clipVals[uk( rng )] : 1024 );
+      }
+      coef[c * 13 + 12] = 128; clip[c * 13 + 12] = 1024;
+    }
+
+    ClpRng clpRng; clpRng.bd = bitDepth;
+    const CPelBuf  srcBuf( s, stride, W, H );
+    const CPelUnitBuf srcUnit( VVENC_CHROMA_400, srcBuf );
+    const PelUnitBuf  dstUnit( VVENC_CHROMA_400, PelBuf( dRef, stride, W, H ) );
+    alignas( 64 ) char dummyCs[64] = { 0 };   // filterBlk takes a CodingStructure& it does not use for luma
+    const CodingStructure& cs = *reinterpret_cast<const CodingStructure*>( dummyCs );
+
+    std::vector<AlfClassifier> cls( 32 * 32 );
+    for( int y0 = 0; y0 < H; y0 += S )
+    for( int x0 = 0; x0 < W; x0 += S )
+    {
+      const int w = std::min( S, W - x0 ), h = std::min( S, H - y0 );
+      const Area blk( x0, y0, w, h );
+      // VVenC classification (shift = bitDepth + 4)
+      alf.m_deriveClassificationBlk( cls.data(), srcBuf, blk, blk, bitDepth + 4, vbH, vbPos );
+      // VVenC filter
+      alf.m_filter7x7Blk[nonLin]( cls.data(), dstUnit, srcUnit, blk, blk, COMP_Y, coef.data(), clip.data(), clpRng, cs, vbH, vbPos );
+
+      for( int by = 0; by < h; by += 4 )
+      for( int bx = 0; bx < w; bx += 4 )
+      {
+        int c, t;
+        alfgpu::classifyBlock4x4( s + ( y0 + by ) * stride + x0 + bx, stride, y0 + by, bitDepth + 4, vbH, vbPos, c, t );
+        const AlfClassifier& r = cls[( by / 4 ) * 32 + bx / 4];
+        blocks++;
+        if( c != r.classIdx || t != r.transposeIdx )
+        {
+          if( errCls++ < 10 ) printf( "CLS mismatch simd=%d W=%d ctu=%d content=%d (%d,%d): core=(%d,%d) vvenc=(%d,%d)\n",
+                                      useSimd, W, S, content, x0 + bx, y0 + by, c, t, r.classIdx, r.transposeIdx );
+        }
+        for( int yy = 0; yy < 4; yy++ )
+        for( int xx = 0; xx < 4; xx++ )
+        {
+          const int x = x0 + bx + xx, y = y0 + by + yy;
+          const Pel v = alfgpu::filterLumaSample( s + y * stride + x, stride, y, &coef[r.classIdx * 13], &clip[r.classIdx * 13],
+                                                  r.transposeIdx, vbH, vbPos, ( 1 << bitDepth ) - 1 );
+          samples++;
+          if( v != dRef[y * stride + x] )
+          {
+            if( errFlt++ < 10 ) printf( "FLT mismatch simd=%d nl=%d W=%d ctu=%d content=%d (%d,%d): core=%d vvenc=%d\n",
+                                        useSimd, nonLin, W, S, content, x, y, v, dRef[y * stride + x] );
+          }
+        }
+      }
+    }
+  }
+
+  printf( "classification: %lld blocks, %lld mismatches\n", blocks, errCls );
+  printf( "filter        : %lld samples, %lld mismatches\n", samples, errFlt );
+  printf( ( errCls || errFlt ) ? "RESULT: NOT bit-exact\n" : "RESULT: bit-exact with VVenC (scalar and SIMD)\n" );
+  return ( errCls || errFlt ) ? 1 : 0;
+}
