+/* -----------------------------------------------------------------------------
+AlfGpuHost.cpp  -  host reference loops + host-emulation backend
+
+The emulation backend mimics the GPU data flow (pack band with halo -> classify ->
+filter -> unpack) but runs the shared core on the CPU. It exists to prove that
+the integration (indices, halos, VB, borders, per-CTU sets) is bit-exact with
+VVenC on machines without a GPU, and as a CPU baseline for the benchmark.
+------------------------------------------------------------------------------- */
+
+#include "AlfGpu.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+#include <mutex>
+#include <memory>
+
+namespace alfgpu
+{
+
+static inline int ctuOf( const BandParams& p, int x, int yInBand )
+{
+  return ( yInBand / p.ctuSize ) * p.numCtuCols + x / p.ctuSize;
+}
+
+void hostClassifyBand( const Pel* in, ptrdiff_t inStride, const BandParams& p, uint8_t* cls, int clsStride )
+{
+  const int shift = p.bitDepth + 4;
+  for( int yb = 0; yb < p.bandH; yb += 4 )
+  {
+    for( int x = 0; x < p.picWidth; x += 4 )
+    {
+      if( p.ctuSetIdx[ctuOf( p, x, yb )] < 0 ) continue;
+      int c, t;
+      classifyBlock4x4( in + yb * inStride + x, inStride, p.bandY0 + yb, shift, p.vbH, p.vbPos, c, t );
+      cls[( yb >> 2 ) * clsStride + ( x >> 2 )] = ( uint8_t ) ( c | ( t << 5 ) );
+    }
+  }
+}
+
+void hostFilterBand( const Pel* in, ptrdiff_t inStride, const BandParams& p, const int16_t* coefTab, const int16_t* clipTab,
+                     const uint8_t* cls, int clsStride, Pel* out, ptrdiff_t outStride )
+{
+  const int maxVal = ( 1 << p.bitDepth ) - 1;
+  for( int yb = 0; yb < p.bandH; yb++ )
+  {
+    for( int x = 0; x < p.picWidth; x++ )
+    {
+      const int set = p.ctuSetIdx[ctuOf( p, x, yb )];
+      if( set < 0 ) continue;
+      const uint8_t c   = cls[( yb >> 2 ) * clsStride + ( x >> 2 )];
+      const int classIdx = c & 31, tr = c >> 5;
+      const int16_t* cf = coefTab + set * kSetStride + classIdx * kNumCoeff;
+      const int16_t* cl = clipTab + set * kSetStride + classIdx * kNumCoeff;
+      out[yb * outStride + x] = filterLumaSample( in + yb * inStride + x, inStride, p.bandY0 + yb, cf, cl, tr, p.vbH, p.vbPos, maxVal );
+    }
+  }
+}
+
+// copies the rectangles of CTUs with setIdx >= 0 from (src,srcStride) to (dst,dstStride); both point to (0,bandY0)
+static void copyCtuAreas( const BandParams& p, const Pel* src, ptrdiff_t srcStride, Pel* dst, ptrdiff_t dstStride )
+{
+  const int rows = ( p.bandH + p.ctuSize - 1 ) / p.ctuSize;
+  for( int r = 0; r < rows; r++ )
+  {
+    const int y0 = r * p.ctuSize, h = std::min( p.ctuSize, p.bandH - y0 );
+    for( int c = 0; c < p.numCtuCols; c++ )
+    {
+      if( p.ctuSetIdx[r * p.numCtuCols + c] < 0 ) continue;
+      const int x0 = c * p.ctuSize, w = std::min( p.ctuSize, p.picWidth - x0 );
+      for( int y = y0; y < y0 + h; y++ )
+      {
+        memcpy( dst + y * dstStride + x0, src + y * srcStride + x0, w * sizeof( Pel ) );
+      }
+    }
+  }
+}
+
+// ------------------------------------------------------------------------------------------------
+// CPU simulation of the CUDA kernels: loops over the grid and over the threads of each block,
+// executing the phases of AlfGpuTiles.h in the same order as the __syncthreads()-separated kernel
+// ------------------------------------------------------------------------------------------------
+void simClassifyKernel( ClsSmem& s, const Pel* d_in, const int16_t* d_ctuSet, uint8_t* d_cls, const KParams& k )
+{
+  const int gx = ( k.picWidth + CT_W - 1 ) / CT_W, gy = ( k.bandH + CT_H - 1 ) / CT_H;
+  for( int by = 0; by < gy; by++ )
+    for( int bx = 0; bx < gx; bx++ )
+    {
+      const int x0 = bx * CT_W, y0 = by * CT_H;
+      for( int t = 0; t < CT_THREADS; t++ ) clsPhaseLoad( s, t, d_in, k, x0, y0 );
+      for( int t = 0; t < CT_THREADS; t++ ) clsPhaseCells( s, t, k, y0 );
+      for( int t = 0; t < CT_THREADS; t++ ) clsPhaseBlocks( s, t, d_ctuSet, d_cls, k, x0, y0 );
+    }
+}
+
+void simFilterKernel( FltSmem& s, const Pel* d_in, const int16_t* d_ctuSet, const uint8_t* d_cls, const int16_t* d_coef,
+                      const int16_t* d_clip, Pel* d_out, const KParams& k )
+{
+  const int gx = ( k.picWidth + FT_W - 1 ) / FT_W, gy = ( k.bandH + FT_H - 1 ) / FT_H;
+  for( int by = 0; by < gy; by++ )
+    for( int bx = 0; bx < gx; bx++ )
+    {
+      const int x0 = bx * FT_W, y0 = by * FT_H;
+      for( int t = 0; t < FT_THREADS; t++ ) fltPhaseLoad( s, t, d_in, k, x0, y0 );
+      for( int ty = 0; ty < FT_TY; ty++ )
+        for( int tx = 0; tx < FT_TX; tx++ ) fltPhaseCompute( s, tx, ty, d_ctuSet, d_cls, d_coef, d_clip, d_out, k, x0, y0 );
+    }
+}
+
+void simCovKernel( CovSmem& s, const CovKParams& k, int numUnits, const Pel* rec, const Pel* org, const uint8_t* cls,
+                   const int* unitStart, const int16_t* ctuRect, const uint32_t* elem, float* out, uint8_t* used, const Pel* slf = nullptr )
+{
+  const int groups = ( k.numElem + CV_THREADS - 1 ) / CV_THREADS;
+  std::vector<float>    acc( ( size_t ) CV_THREADS * CV_MAXCLS );
+  std::vector<uint32_t> mask( CV_THREADS );
+  for( int unit = 0; unit < numUnits; unit++ )
+    for( int g = 0; g < groups; g++ )
+    {
+      std::fill( acc.begin(), acc.end(), 0.f );
+      std::fill( mask.begin(), mask.end(), 0u );
+      for( int ctu = unitStart[unit]; ctu < unitStart[unit + 1]; ctu++ )
+      {
+        const int x0 = ctuRect[4 * ctu], y0 = ctuRect[4 * ctu + 1], bw = ctuRect[4 * ctu + 2] >> 2, bh = ctuRect[4 * ctu + 3] >> 2;
+        for( int q0 = 0; q0 < bw * bh; q0 += CV_NB )
+        {
+          const int nb = std::min( CV_NB, bw * bh - q0 );
+          for( int t = 0; t < CV_THREADS; t++ )
+          {
+            if( k.ccalf ) ccPhaseLoad( s, t, k, rec, slf, org, x0, y0, bw, q0, nb );
+            else          covPhaseLoad( s, t, k, rec, org, cls, x0, y0, bw, q0, nb );
+          }
+          for( int t = 0; t < CV_THREADS; t++ )
+          {
+            const int e = g * CV_THREADS + t;
+            if( e < k.numElem ) covPhaseAccum( s, elem[e], nb, &acc[( size_t ) t * CV_MAXCLS], mask[t] );
+          }
+        }
+      }
+      for( int t = 0; t < CV_THREADS; t++ )
+      {
+        const int e = g * CV_THREADS + t;
+        if( e >= k.numElem ) continue;
+        for( int c = 0; c < k.numClasses; c++ ) out[( ( size_t ) unit * k.numClasses + c ) * k.numElem + e] = acc[( size_t ) t * CV_MAXCLS + c];
+      }
+      if( g == 0 && used )
+      {
+        for( int c = 0; c < k.numClasses; c++ ) used[unit * k.numClasses + c] = ( mask[0] >> c ) & 1;
+      }
+    }
+}
+
+// the merging kernel (one block) and the hypothesis kernel, thread by thread
+void hostMergeFilters( const MergeJob& j, const MergeBufs& b )
+{
+  std::unique_ptr<MergeSmem> sp( new MergeSmem );
+  MergeSmem& s = *sp;
+  for( int t = 0; t < MG_THREADS; t++ ) mgPhaseInit( s, t, j, b );
+  for( int t = 0; t < MG_THREADS; t++ ) mgPhaseClasses( s, t, j, b );
+  while( s.nr >= 2 )
+  {
+    for( int t = 0; t < MG_THREADS; t++ ) mgPhasePairs( s, t, j, b );
+    for( int t = 0; t < MG_THREADS; t++ ) mgPhaseLocalMin( s, t );
+    for( int st = MG_THREADS / 2; st > 0; st >>= 1 )
+      for( int t = 0; t < MG_THREADS; t++ ) mgPhaseReduce( s, t, st );
+    for( int t = 0; t < MG_THREADS; t++ ) mgPhaseSelect( s, t );
+    for( int t = 0; t < MG_THREADS; t++ ) mgPhaseApply( s, t, j, b );
+    for( int t = 0; t < MG_THREADS; t++ ) mgPhaseBook( s, t, b );
+  }
+  for( int t = 0; t < kNumHyp; t++ ) mgDeriveHyp( t, j, b );
+}
+
+class HostEmuBackend : public Backend
+{
+  struct Worker
+  {
+    std::vector<Pel>     band;   // input band with halo ("device" input)
+    std::vector<Pel>     out;    // filtered band ("device" output)
+    std::vector<uint8_t> cls;    // classes ("device")
+    std::unique_ptr<ClsSmem> clsSmem{ new ClsSmem };
+    std::unique_ptr<FltSmem> fltSmem{ new FltSmem };
+    std::unique_ptr<CovSmem> covSmem{ new CovSmem };
+    std::vector<Pel>     plane[3], orgPlane[3];   // "device" chroma inputs (with halo) and original planes
+    bool                 orgPrefetched[3] = { false, false, false };
+    std::vector<Pel>     slfPlane;                // CCALF: ALF-filtered chroma
+    std::vector<float>   mgCovMerged;             // merging: working covariances
+    std::vector<int8_t>  mgClip;                  // merging: clipMerged levels
+  };
+  std::vector<int16_t> m_coef, m_clip;   // kMaxSets * kSetStride
+  std::vector<std::unique_ptr<Worker>> m_workers, m_slots;
+  std::mutex m_mutex;
+
+  using clk = std::chrono::steady_clock;
+  static double ms( clk::time_point a, clk::time_point b ) { return std::chrono::duration<double, std::milli>( b - a ).count(); }
+
+  Worker* get( std::vector<std::unique_ptr<Worker>>& v, int idx )
+  {
+    std::lock_guard<std::mutex> lock( m_mutex );
+    if( idx >= ( int ) v.size() ) v.resize( idx + 1 );
+    if( !v[idx] ) v[idx].reset( new Worker );
+    return v[idx].get();
+  }
+
+  static KParams chunkParams( const BandParams& p, int cy, int chunkH, int inW )
+  {
+    KParams k;
+    k.picWidth = p.picWidth;  k.bandY0 = p.bandY0 + cy;  k.bandH = std::min( chunkH, p.bandH - cy );  k.ctuSize = p.ctuSize;
+    k.numCtuCols = p.numCtuCols;  k.bitDepth = p.bitDepth;  k.vbH = p.vbH;  k.vbPos = p.vbPos;
+    k.inPitch = inW;  k.clsStride = p.picWidth >> 2;  k.outPitch = p.picWidth;
+    return k;
+  }
+
+  // "H2D": the band with its halo into the worker's "device" buffer
+  static void upload( Worker* w, const BandParams& p )
+  {
+    const int inW = p.picWidth + 2 * kHalo, inH = p.bandH + 2 * kHalo;
+    w->band.resize( ( size_t ) inW * inH );
+    for( int y = 0; y < inH; y++ )
+    {
+      memcpy( &w->band[( size_t ) y * inW], p.src + ( ptrdiff_t ) ( y - kHalo ) * p.srcStride - kHalo, inW * sizeof( Pel ) );
+    }
+  }
+
+  void coefTables( const BandParams& p, std::vector<int16_t>& coef, std::vector<int16_t>& clip ) const
+  {
+    coef = m_coef; clip = m_clip;
+    if( p.numAps > 0 )
+    {
+      memcpy( &coef[kNumFixedSets * kSetStride], p.apsCoef, p.numAps * kSetStride * sizeof( int16_t ) );
+      memcpy( &clip[kNumFixedSets * kSetStride], p.apsClip, p.numAps * kSetStride * sizeof( int16_t ) );
+    }
+  }
+
+  // kernels, chunk by chunk exactly as the CUDA backend splits the band
+  static int runKernels( Worker* w, const BandParams& p, bool doClassify, bool doFilter, const int16_t* coef, const int16_t* clip,
+                         double& clsMs, double& fltMs )
+  {
+    const int inW = p.picWidth + 2 * kHalo, clsStride = p.picWidth >> 2;
+    w->cls.resize( ( size_t ) clsStride * ( ( p.bandH + 3 ) >> 2 ) );
+    if( doFilter ) w->out.resize( ( size_t ) p.picWidth * p.bandH );
+    const int chunkH = chunkCtuRows( p.bandH, p.ctuSize ) * p.ctuSize;
+    int chunks = 0;
+    for( int cy = 0; cy < p.bandH; cy += chunkH, chunks++ )
+    {
+      const KParams  k   = chunkParams( p, cy, chunkH, inW );
+      const Pel*     in  = &w->band[( size_t ) cy * inW];                    // halo top of the chunk
+      const int16_t* map = p.ctuSetIdx + ( cy / p.ctuSize ) * p.numCtuCols;
+      uint8_t*       cl  = &w->cls[( size_t ) ( cy >> 2 ) * clsStride];
+      const auto a = clk::now();
+      if( doClassify ) simClassifyKernel( *w->clsSmem, in, map, cl, k );
+      const auto b = clk::now();
+      if( doFilter ) simFilterKernel( *w->fltSmem, in, map, cl, coef, clip, &w->out[( size_t ) cy * p.picWidth], k );
+      const auto c = clk::now();
+      clsMs += ms( a, b ); fltMs += ms( b, c );
+    }
+    return chunks;
+  }
+
+public:
+  const char* name() const override { return "host-emu"; }
+
+  bool init( const int16_t* fixedCoef, const int16_t* fixedClip, int, int, int numWorkers ) override
+  {
+    m_coef.assign( kMaxSets * kSetStride, 0 );
+    m_clip.assign( kMaxSets * kSetStride, 0 );
+    memcpy( m_coef.data(), fixedCoef, kNumFixedSets * kSetStride * sizeof( int16_t ) );
+    memcpy( m_clip.data(), fixedClip, kNumFixedSets * kSetStride * sizeof( int16_t ) );
+    m_workers.resize( std::max( 1, numWorkers ) );
+    return true;
+  }
+
+  void filterLumaBand( const BandParams& p, int mode, int worker, Timing& t ) override
+  {
+    const auto t0 = clk::now();
+    Worker* w = get( m_workers, worker );
+    std::vector<int16_t> coef, clip;
+    coefTables( p, coef, clip );
+
+    const auto t1 = clk::now();
+    upload( w, p );
+    if( mode == MODE_FILTER )
+    {
+      w->cls.resize( ( size_t ) ( p.picWidth >> 2 ) * ( ( p.bandH + 3 ) >> 2 ) );
+      memcpy( w->cls.data(), p.cpuClass, w->cls.size() );
+    }
+    const auto t2 = clk::now();
+    double clsMs = 0, fltMs = 0;
+    const int chunks = runKernels( w, p, mode != MODE_FILTER, true, coef.data(), clip.data(), clsMs, fltMs );
+    const auto t4 = clk::now();
+    copyCtuAreas( p, w->out.data(), p.picWidth, p.dst, p.dstStride );   // "D2H" + unpack
+    if( p.outClass ) memcpy( p.outClass, w->cls.data(), w->cls.size() );
+    const auto t5 = clk::now();
+
+    t.h2dMs        += ms( t1, t2 );
+    t.classifyMs   += clsMs;
+    t.filterMs     += fltMs;
+    t.hostUnpackMs += ms( t4, t5 );
+    t.gpuSpanMs    += ms( t1, t4 );
+    t.totalMs      += ms( t0, t5 );
+    t.chunks       += chunks;
+    t.bytesH2D     += ( uint64_t ) ( p.picWidth + 2 * kHalo ) * ( p.bandH + 2 * kHalo ) * sizeof( Pel );
+    t.bytesD2H     += ( uint64_t ) p.picWidth * p.bandH * sizeof( Pel );
+  }
+
+  void classifyFrame( const BandParams& p, int slot, Timing& t ) override
+  {
+    const auto t0 = clk::now();
+    Worker* w = get( m_slots, slot );
+    upload( w, p );
+    const auto t1 = clk::now();
+    double clsMs = 0, fltMs = 0;
+    const int chunks = runKernels( w, p, true, false, nullptr, nullptr, clsMs, fltMs );
+    const auto t2 = clk::now();
+    if( p.outClass ) memcpy( p.outClass, w->cls.data(), w->cls.size() );   // "D2H" of the classes (only if requested)
+    const auto t3 = clk::now();
+
+    t.h2dMs      += ms( t0, t1 );
+    t.classifyMs += clsMs;
+    t.d2hMs      += ms( t2, t3 );
+    t.gpuSpanMs  += ms( t0, t3 );
+    t.totalMs    += ms( t0, t3 );
+    t.chunks     += chunks;
+    t.bytesH2D   += ( uint64_t ) ( p.picWidth + 2 * kHalo ) * ( p.bandH + 2 * kHalo ) * sizeof( Pel );
+    t.bytesD2H   += p.outClass ? w->cls.size() : 0;
+  }
+
+  void covarianceFrame( const CovJob* jobs, int numJobs, int slot, Timing& t ) override
+  {
+    const auto t0 = clk::now();
+    Worker* w = get( m_slots, slot );
+    double upMs = 0, kMs = 0;
+    for( int j = 0; j < numJobs; j++ )
+    {
+      const CovJob& jb = jobs[j];
+      CovKParams k = jb.k;
+      const Pel* rec;
+      const uint8_t* cls = nullptr;
+      const auto a = clk::now();
+      // "H2D": original plane (unless prefetched) and chroma reconstruction with halo
+      std::vector<Pel>& og = w->orgPlane[jb.comp];
+      if( jb.org )
+      {
+        og.resize( ( size_t ) jb.width * jb.height );
+        for( int y = 0; y < jb.height; y++ ) memcpy( &og[( size_t ) y * jb.width], jb.org + y * jb.orgStride, jb.width * sizeof( Pel ) );
+        t.bytesH2D += og.size() * sizeof( Pel );
+      }
+      else if( !w->orgPrefetched[jb.comp] || og.size() != ( size_t ) jb.width * jb.height )
+      {
+        fprintf( stderr, "[AlfGpu] covarianceFrame without a prefetched original\n" );
+        abort();
+      }
+      k.orgPitch = jb.width;
+      if( jb.comp == 0 )
+      {
+        k.recPitch  = jb.width + 2 * kHalo;
+        k.clsStride = jb.width >> 2;
+        rec = &w->band[( size_t ) kHalo * k.recPitch + kHalo];      // resident from classifyFrame
+        cls = w->cls.data();
+      }
+      else
+      {
+        k.recPitch = jb.width + 2 * kHalo;
+        std::vector<Pel>& pl = w->plane[jb.comp];
+        pl.resize( ( size_t ) k.recPitch * ( jb.height + 2 * kHalo ) );
+        for( int y = -kHalo; y < jb.height + kHalo; y++ )
+        {
+          memcpy( &pl[( size_t ) ( y + kHalo ) * k.recPitch], jb.rec + y * jb.recStride - kHalo, k.recPitch * sizeof( Pel ) );
+        }
+        rec = &pl[( size_t ) kHalo * k.recPitch + kHalo];
+        t.bytesH2D += pl.size() * sizeof( Pel );
+      }
+      const auto b = clk::now();
+      simCovKernel( *w->covSmem, k, jb.numUnits, rec, og.data(), cls, jb.unitCtuStart, jb.ctuRect, jb.elem, jb.out, jb.used );
+      const auto c = clk::now();
+      upMs += ms( a, b ); kMs += ms( b, c );
+      t.bytesD2H += ( uint64_t ) jb.numUnits * k.numClasses * ( k.numElem * sizeof( float ) + 1 );
+    }
+    const auto t1 = clk::now();
+    t.h2dMs     += upMs;
+    t.covMs     += kMs;
+    t.gpuSpanMs += ms( t0, t1 );
+    t.totalMs   += ms( t0, t1 );
+  }
+
+  void prefetchOriginal( const OrigPlanes& o, int slot, Timing& t ) override
+  {
+    const auto t0 = clk::now();
+    Worker* w = get( m_slots, slot );
+    for( int c = 0; c < o.numComp; c++ )
+    {
+      std::vector<Pel>& og = w->orgPlane[c];
+      og.resize( ( size_t ) o.width[c] * o.height[c] );
+      for( int y = 0; y < o.height[c]; y++ ) memcpy( &og[( size_t ) y * o.width[c]], o.org[c] + y * o.stride[c], o.width[c] * sizeof( Pel ) );
+      w->orgPrefetched[c] = true;
+      t.bytesH2D += og.size() * sizeof( Pel );
+    }
+    const auto t1 = clk::now();
+    t.h2dMs   += ms( t0, t1 );
+    t.totalMs += ms( t0, t1 );
+  }
+
+  void mergeFilters( const MergeJob& job, MergeResult& res, int slot, Timing& t ) override
+  {
+    const auto t0 = clk::now();
+    Worker* w = get( m_slots, slot );
+    const size_t n = ( size_t ) kNumClasses * covStride( job.nb );
+    w->mgCovMerged.resize( n );
+    w->mgClip.resize( ( size_t ) kNumClasses * kNumClasses * kNumCoeff );
+    MergeBufs b{ job.cov, w->mgCovMerged.data(), w->mgClip.data(), &res };
+    hostMergeFilters( job, b );
+    const auto t1 = clk::now();
+    t.distMs   += ms( t0, t1 );
+    t.totalMs  += ms( t0, t1 );
+    t.bytesH2D += n * sizeof( float );
+    t.bytesD2H += sizeof( MergeResult );
+  }
+
+  void ccalfStatsFrame( const CcAlfJob* jobs, int numJobs, int slot, Timing& t ) override
+  {
+    const auto t0 = clk::now();
+    Worker* w = get( m_slots, slot );
+    double upMs = 0, kMs = 0;
+    for( int j = 0; j < numJobs; j++ )
+    {
+      const CcAlfJob& jb = jobs[j];
+      CovKParams k = jb.k;
+      const auto a = clk::now();
+      const int lumaW = jb.width << k.sx;
+      if( w->band.empty() || ( size_t ) ( lumaW + 2 * kHalo ) * ( ( jb.height << k.sy ) + 2 * kHalo ) != w->band.size() )
+      {
+        fprintf( stderr, "[AlfGpu] ccalfStatsFrame without a matching classifyFrame\n" );
+        abort();
+      }
+      k.recPitch = lumaW + 2 * kHalo;
+      const Pel* rec = &w->band[( size_t ) kHalo * k.recPitch + kHalo];
+      std::vector<Pel> ogTmp;
+      const Pel* og;
+      if( jb.org )
+      {
+        ogTmp.resize( ( size_t ) jb.width * jb.height );
+        for( int y = 0; y < jb.height; y++ ) memcpy( &ogTmp[( size_t ) y * jb.width], jb.org + y * jb.orgStride, jb.width * sizeof( Pel ) );
+        og = ogTmp.data();
+        t.bytesH2D += ogTmp.size() * sizeof( Pel );
+      }
+      else
+      {
+        if( !w->orgPrefetched[jb.comp] ) { fprintf( stderr, "[AlfGpu] ccalfStatsFrame without a prefetched original\n" ); abort(); }
+        og = w->orgPlane[jb.comp].data();
+      }
+      k.orgPitch = jb.width;
+      w->slfPlane.resize( ( size_t ) jb.width * jb.height );
+      for( int y = 0; y < jb.height; y++ ) memcpy( &w->slfPlane[( size_t ) y * jb.width], jb.slf + y * jb.slfStride, jb.width * sizeof( Pel ) );
+      k.slfPitch = jb.width;
+      t.bytesH2D += w->slfPlane.size() * sizeof( Pel );
+      std::vector<int> unitStart( jb.numUnits + 1 );
+      for( int u = 0; u <= jb.numUnits; u++ ) unitStart[u] = u;
+      const auto b = clk::now();
+      simCovKernel( *w->covSmem, k, jb.numUnits, rec, og, nullptr, unitStart.data(), jb.ctuRect, jb.elem, jb.out, nullptr, w->slfPlane.data() );
+      const auto c = clk::now();
+      upMs += ms( a, b ); kMs += ms( b, c );
+      t.bytesD2H += ( uint64_t ) jb.numUnits * k.numElem * sizeof( float );
+    }
+    const auto t1 = clk::now();
+    t.h2dMs     += upMs;
+    t.ccalfMs   += kMs;
+    t.gpuSpanMs += ms( t0, t1 );
+    t.totalMs   += ms( t0, t1 );
+  }
+
+  void filterFrameResident( const BandParams& p, int slot, Timing& t ) override
+  {
+    const auto t0 = clk::now();
+    Worker* w = get( m_slots, slot );
+    std::vector<int16_t> coef, clip;
+    coefTables( p, coef, clip );
+    const auto t1 = clk::now();
+    double clsMs = 0, fltMs = 0;
+    const int chunks = runKernels( w, p, false, true, coef.data(), clip.data(), clsMs, fltMs );
+    const auto t2 = clk::now();
+    copyCtuAreas( p, w->out.data(), p.picWidth, p.dst, p.dstStride );
+    const auto t3 = clk::now();
+
+    t.hostPackMs   += ms( t0, t1 );
+    t.filterMs     += fltMs;
+    t.hostUnpackMs += ms( t2, t3 );
+    t.gpuSpanMs    += ms( t1, t2 );
+    t.totalMs      += ms( t0, t3 );
+    t.chunks       += chunks;
+    t.bytesH2D     += ( uint64_t ) ( ( p.bandH + p.ctuSize - 1 ) / p.ctuSize ) * p.numCtuCols * sizeof( int16_t )
+                    + ( uint64_t ) 2 * p.numAps * kSetStride * sizeof( int16_t );
+    t.bytesD2H     += ( uint64_t ) p.picWidth * p.bandH * sizeof( Pel );
+  }
+};
+
+#if VVENC_CUDA_ALF
+Backend* createCudaBackend();   // AlfGpuCuda.cu, returns nullptr if no usable device
+#endif
+
+Backend* createBackend( const int16_t* fixedCoef, const int16_t* fixedClip, int maxPicWidth, int maxBandH, int numWorkers )
+{
+  const char* emu = getenv( "VVENC_ALF_GPU_EMU" );
+#if VVENC_CUDA_ALF
+  if( !( emu && atoi( emu ) ) )
+  {
+    Backend* b = createCudaBackend();
+    if( b && b->init( fixedCoef, fixedClip, maxPicWidth, maxBandH, numWorkers ) ) return b;
+    delete b;
+    fprintf( stderr, "[AlfGpu] no usable CUDA device, falling back to host emulation\n" );
+  }
+#else
+  ( void ) emu;
+#endif
+  Backend* b = new HostEmuBackend;
+  b->init( fixedCoef, fixedClip, maxPicWidth, maxBandH, numWorkers );
+  return b;
+}
+
+} // namespace alfgpu
diff --git a/source/Lib/CommonLib/AlfGpuTiles.h b/source/Lib/CommonLib/AlfGpuTiles.h
new file mode 100644
index 0000000..8cebc41
--- /dev/null
+++ b/source/Lib/CommonLib/AlfGpuTiles.h
@@ -0,0 +1,169 @@
+/* -----------------------------------------------------------------------------
+AlfGpuTiles.h - tiled, massively parallel ALF luma: the phases of each CUDA block
+
+Each CUDA kernel is written as a sequence of phases separated by __syncthreads():
+    phase(shared memory, thread index, ...)
+The same phase functions are executed
+  * on the GPU by the kernels in cuda/AlfGpuKernels.cuh (one call per thread), and
+  * on the CPU by the host simulator in AlfGpuHost.cpp (loop over blocks and threads),
+so the emulation backend validates the exact tiling / indexing of the CUDA code.
+
+Classification kernel (256 threads, tile of 128 x 32 samples = 32 x 8 blocks of 4x4):
+  1. load   : 134 x 38 samples (3-sample halo) into shared memory, coalesced
+  2. cells  : every 2x2 laplacian cell of the tile is computed ONCE (66 x 18 cells,
+              ~4.6 per thread) and stored in shared memory
+  3. blocks : one thread per 4x4 block sums its 4x4 (or 3x4 at the VB) cells
+Neighbouring 4x4 blocks share 3/4 of their cells, so phase 2 removes ~3.5x of the
+laplacian arithmetic of the per-block version and makes the work uniform per thread.
+
+Filter kernel (32 x 8 threads, tile of 32 x 32 samples, 4 samples per thread):
+  1. load    : 38 x 38 samples into shared memory
+  2. compute : 7x7 diamond filter per sample from shared memory
+------------------------------------------------------------------------------- */
+#pragma once
+
+#include "AlfGpuCore.h"
+
+#include <cstdlib>
+
+namespace alfgpu
+{
+
+struct KParams
+{
+  int picWidth, bandY0, bandH, ctuSize, numCtuCols, bitDepth, vbH, vbPos;
+  int inPitch;     // samples per row of the input band (picWidth + 2*kHalo)
+  int clsStride;   // bytes per row of 4x4 blocks (= picWidth / 4)
+  int outPitch;    // samples per row of the output
+};
+
+// ------------------------------------------------------------------ classification
+static constexpr int CT_THREADS = 256;
+static constexpr int CT_W  = 128, CT_H = 32;                   // samples per tile
+static constexpr int CT_BX = CT_W / 4, CT_BY = CT_H / 4;       // 32 x 8 blocks per tile (= 256 threads)
+static constexpr int CT_PW = CT_W + 6, CT_PH = CT_H + 6;       // sample tile with 3-sample halo
+static constexpr int CT_CW = CT_W / 2 + 2, CT_CH = CT_H / 2 + 2;   // cells: c = x0-2 .. x0+CT_W, r = y0-2 .. y0+CT_H (step 2)
+static_assert( CT_BX * CT_BY == CT_THREADS, "one thread per 4x4 block" );
+
+struct ClsSmem
+{
+  Pel pix[CT_PH][CT_PW];
+  int cv [CT_CH][CT_CW];
+  int ch [CT_CH][CT_CW];
+  int cd0[CT_CH][CT_CW];
+  int cd1[CT_CH][CT_CW];
+};
+
+// samples of the band outside [-kHalo, W+kHalo) x [-kHalo, bandH+kHalo) are not readable: they are
+// replaced by 0 and only ever feed 4x4 blocks / samples outside the picture, which are discarded
+ALFG_HD Pel loadBandSample( const Pel* d_in, const KParams& k, int gx, int gy )
+{
+  if( gx < -kHalo || gx >= k.picWidth + kHalo || gy < -kHalo || gy >= k.bandH + kHalo ) return 0;
+  return d_in[( ptrdiff_t ) ( gy + kHalo ) * k.inPitch + ( gx + kHalo )];
+}
+
+ALFG_HD void clsPhaseLoad( ClsSmem& s, int tid, const Pel* d_in, const KParams& k, int x0, int y0 )
+{
+  for( int i = tid; i < CT_PW * CT_PH; i += CT_THREADS )
+  {
+    const int r = i / CT_PW, c = i - r * CT_PW;
+    s.pix[r][c] = loadBandSample( d_in, k, x0 - 3 + c, y0 - 3 + r );
+  }
+}
+
+ALFG_HD void clsPhaseCells( ClsSmem& s, int tid, const KParams& k, int y0 )
+{
+  for( int i = tid; i < CT_CW * CT_CH; i += CT_THREADS )
+  {
+    const int ci = i / CT_CW, cj = i - ci * CT_CW;
+    const int r  = y0 - 2 + 2 * ci;                     // band row of the cell
+    // cell (r, c) is pixel tile entry [r - (y0-3)][c - (x0-3)] = [2ci+1][2cj+1]
+    int v, h, d0, d1;
+    lapCell( &s.pix[2 * ci + 1][2 * cj + 1], CT_PW, k.bandY0 + r, k.vbH, k.vbPos, v, h, d0, d1 );
+    s.cv[ci][cj] = v; s.ch[ci][cj] = h; s.cd0[ci][cj] = d0; s.cd1[ci][cj] = d1;
+  }
+}
+
+ALFG_HD void clsPhaseBlocks( const ClsSmem& s, int tid, const int16_t* d_ctuSet, uint8_t* d_cls, const KParams& k, int x0, int y0 )
+{
+  const int tx = tid % CT_BX, ty = tid / CT_BX;
+  const int bx = x0 + 4 * tx, by = y0 + 4 * ty;          // band coordinates of the block
+  if( bx >= k.picWidth || by >= k.bandH ) return;
+  if( d_ctuSet[( by / k.ctuSize ) * k.numCtuCols + bx / k.ctuSize] < 0 ) return;
+
+  const int y = k.bandY0 + by;
+  int kBeg, kEnd;
+  cellRowRange( y, k.vbH, k.vbPos, kBeg, kEnd );
+  int sumV = 0, sumH = 0, sumD0 = 0, sumD1 = 0;
+  for( int kk = kBeg; kk < kEnd; kk++ )
+  {
+    const int ci = 2 * ty + kk;                          // r = by - 2 + 2kk
+    for( int l = 0; l < 4; l++ )
+    {
+      const int cj = 2 * tx + l;                         // c = bx - 2 + 2l
+      sumV += s.cv[ci][cj]; sumH += s.ch[ci][cj]; sumD0 += s.cd0[ci][cj]; sumD1 += s.cd1[ci][cj];
+    }
+  }
+  int c, t;
+  classFromSums( sumV, sumH, sumD0, sumD1, y, k.bitDepth + 4, k.vbH, k.vbPos, c, t );
+  d_cls[( by >> 2 ) * k.clsStride + ( bx >> 2 )] = ( uint8_t ) ( c | ( t << 5 ) );
+}
+
+// ------------------------------------------------------------------ filter
+static constexpr int FT_TX = 32, FT_TY = 8, FT_ROWS = 4;
+static constexpr int FT_THREADS = FT_TX * FT_TY;
+static constexpr int FT_W  = FT_TX, FT_H = FT_TY * FT_ROWS;    // 32 x 32 samples per tile
+static constexpr int FT_PW = FT_W + 6, FT_PH = FT_H + 6;
+
+struct FltSmem
+{
+  Pel pix[FT_PH][FT_PW];
+};
+
+ALFG_HD void fltPhaseLoad( FltSmem& s, int tid, const Pel* d_in, const KParams& k, int x0, int y0 )
+{
+  for( int i = tid; i < FT_PW * FT_PH; i += FT_THREADS )
+  {
+    const int r = i / FT_PW, c = i - r * FT_PW;
+    s.pix[r][c] = loadBandSample( d_in, k, x0 - 3 + c, y0 - 3 + r );
+  }
+}
+
+ALFG_HD void fltPhaseCompute( const FltSmem& s, int tx, int ty, const int16_t* d_ctuSet, const uint8_t* d_cls,
+                              const int16_t* d_coef, const int16_t* d_clip, Pel* d_out, const KParams& k, int x0, int y0 )
+{
+  const int x = x0 + tx;
+  if( x >= k.picWidth ) return;
+  const int maxVal = ( 1 << k.bitDepth ) - 1;
+  for( int j = 0; j < FT_ROWS; j++ )
+  {
+    const int ly = ty + j * FT_TY;
+    const int y  = y0 + ly;
+    if( y >= k.bandH ) break;
+    const int set = d_ctuSet[( y / k.ctuSize ) * k.numCtuCols + x / k.ctuSize];
+    if( set < 0 ) continue;
+    const uint8_t cl   = d_cls[( y >> 2 ) * k.clsStride + ( x >> 2 )];
+    const int classIdx = cl & 31, tr = cl >> 5;
+    const int off      = set * kSetStride + classIdx * kNumCoeff;
+    d_out[( ptrdiff_t ) y * k.outPitch + x] =
+      filterLumaSample( &s.pix[ly + 3][tx + 3], FT_PW, k.bandY0 + y, d_coef + off, d_clip + off, tr, k.vbH, k.vbPos, maxVal );
+  }
+}
+
+// ------------------------------------------------------------------ chunking of a band
+// A band (one CTU row or the whole frame) is split into chunks of whole CTU rows that are
+// transferred / filtered / read back in a pipeline over several CUDA streams.
+// env VVENC_ALF_GPU_CHUNK_ROWS = CTU rows per chunk (0 or unset: automatic, ~4 chunks per band)
+inline int chunkCtuRows( int bandH, int ctuSize )
+{
+  const int ctuRows = ( bandH + ctuSize - 1 ) / ctuSize;
+  if( const char* e = getenv( "VVENC_ALF_GPU_CHUNK_ROWS" ) )
+  {
+    const int v = atoi( e );
+    if( v > 0 ) return v < ctuRows ? v : ctuRows;
+  }
+  if( ctuRows <= 2 ) return ctuRows;
+  return ( ctuRows + 3 ) / 4;
+}
+
+} // namespace alfgpu
diff --git a/source/Lib/CommonLib/cuda/AlfGpuCuda.cu b/source/Lib/CommonLib/cuda/AlfGpuCuda.cu
new file mode 100644
index 0000000..dd2eb04
--- /dev/null
+++ b/source/Lib/CommonLib/cuda/AlfGpuCuda.cu
@@ -0,0 +1,870 @@
+/* -----------------------------------------------------------------------------
+AlfGpuCuda.cu - CUDA backend for the VVenC ALF luma reconstruction
+
+Per worker (encoder thread, or picture slot of the frame-resident path) it owns: CUDA
+streams, pinned staging buffers, device buffers and a device coefficient table (16
+fixed sets uploaded once + APS sets of the current picture uploaded per call).
+
+Frame-resident path (--AlfGpu 1, default): classifyFrame() at the start of the ALF
+uploads the picture once and computes gradients / classes / transpose indices; the
+encoder uses the classes for its statistics. filterFrameResident() after the filter
+decisions reuses the picture and the classes already on the device: only the CTU map
+and the APS sets go up, only the filtered picture comes back.
+
+A band (one CTU row, or the whole frame in frame mode) is split into chunks of CTU
+rows that run as a software pipeline over several streams:
+    host pack(c) -> H2D(c)        (the CPU packs chunk c+1 while chunk c is copied)
+    kernels(c) wait for H2D(c-1, c, c+1) (3-sample halo from the neighbour chunks)
+    D2H(c) -> host unpack(c)      (unpack of chunk c overlaps the GPU work of c+1..)
+so transfers, kernels and host copies of different chunks overlap.
+env: VVENC_ALF_GPU_STREAMS (default 2), VVENC_ALF_GPU_CHUNK_ROWS (CTU rows per chunk).
+Every stage of every chunk is timed with CUDA events; GPU energy is read through NVML.
+------------------------------------------------------------------------------- */
+
+#include "../AlfGpu.h"
+#include "AlfGpuKernels.cuh"
+
+#include <cuda_runtime.h>
+#include <nvml.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+namespace alfgpu
+{
+
+#define ALF_CUDA_CHECK( x )                                                                       \
+  do {                                                                                            \
+    cudaError_t e_ = ( x );                                                                       \
+    if( e_ != cudaSuccess ) {                                                                     \
+      fprintf( stderr, "[AlfGpu] CUDA error %s at %s:%d\n", cudaGetErrorString( e_ ), __FILE__, __LINE__ ); \
+      abort();                                                                                    \
+    }                                                                                             \
+  } while( 0 )
+
+class CudaBackend : public Backend
+{
+  static constexpr int kMaxStreams = 4;
+
+  struct Worker
+  {
+    cudaStream_t stream[kMaxStreams] = {};
+    cudaEvent_t  evMeta0 = nullptr, evMeta1 = nullptr;
+    std::vector<cudaEvent_t> ev;                  // 6 per chunk: H2D start/end, kernel start, after classify, after filter, after D2H
+    size_t capIn = 0, capOut = 0, capCls = 0, capMap = 0;
+    Pel     *hIn = nullptr, *hOut = nullptr, *dIn = nullptr, *dOut = nullptr;
+    uint8_t *hCls = nullptr, *dCls = nullptr;
+    int16_t *hMap = nullptr, *dMap = nullptr;
+    int16_t *hAps = nullptr;                      // pinned: [coef | clip] of APS sets
+    int16_t *dCoef = nullptr, *dClip = nullptr;   // kMaxSets * kSetStride each
+    int residentW = 0, residentH = 0;             // picture currently resident in dIn / dCls (frame-resident path)
+    // covariance statistics, per colour component
+    struct Buf { void* h = nullptr; void* d = nullptr; size_t cap = 0; };
+    Buf cvOrg[3], cvRec[3], cvUnit[3], cvRect[3], cvElem[3], cvOut[3], cvUsed[3];
+    cudaEvent_t cvEv[3][4] = {};
+    // original prefetched at the start of the picture (prefetchOriginal): valid size per component + completion event
+    int orgW[3] = { 0, 0, 0 }, orgH[3] = { 0, 0, 0 };
+    cudaEvent_t orgEv = nullptr;
+    bool orgPending = false;
+    // CCALF statistics
+    Buf ccSlf[3], ccRect[3], ccUnit[3], ccElem[3], ccOut[3];
+    cudaEvent_t ccEv[3][4] = {};
+    // filter derivation (merging)
+    Buf mgCov, mgCovMerged, mgClip, mgRes;
+    cudaEvent_t mgEv[4] = {};
+    // run() split into enqueue / finish (fused classify + covariance)
+    bool   runPending = false;
+    int    pendChunks = 0, pendChunkH = 0;
+    double pendPackMs = 0;
+    uint64_t pendH2D = 0, pendD2H = 0;
+    std::chrono::steady_clock::time_point pendT0;
+
+    void ensureEvents( size_t n )
+    {
+      while( ev.size() < n )
+      {
+        cudaEvent_t e;
+        ALF_CUDA_CHECK( cudaEventCreate( &e ) );
+        ev.push_back( e );
+      }
+    }
+
+    static void growBuf( Buf& b, size_t bytes )
+    {
+      if( bytes <= b.cap ) return;
+      if( b.h ) cudaFreeHost( b.h );
+      if( b.d ) cudaFree( b.d );
+      ALF_CUDA_CHECK( cudaMallocHost( &b.h, bytes ) );
+      ALF_CUDA_CHECK( cudaMalloc( &b.d, bytes ) );
+      b.cap = bytes;
+    }
+
+    ~Worker()
+    {
+      if( !stream[0] ) return;
+      for( int c = 0; c < 3; c++ )
+      {
+        for( Buf* b : { &cvOrg[c], &cvRec[c], &cvUnit[c], &cvRect[c], &cvElem[c], &cvOut[c], &cvUsed[c],
+                        &ccSlf[c], &ccRect[c], &ccUnit[c], &ccElem[c], &ccOut[c] } )
+        {
+          if( b->h ) cudaFreeHost( b->h );
+          if( b->d ) cudaFree( b->d );
+        }
+        for( auto e : cvEv[c] ) if( e ) cudaEventDestroy( e );
+        for( auto e : ccEv[c] ) if( e ) cudaEventDestroy( e );
+      }
+      for( Buf* b : { &mgCov, &mgCovMerged, &mgClip, &mgRes } )
+      {
+        if( b->h ) cudaFreeHost( b->h );
+        if( b->d ) cudaFree( b->d );
+      }
+      for( auto e : mgEv ) if( e ) cudaEventDestroy( e );
+      if( orgEv ) cudaEventDestroy( orgEv );
+      for( auto s : stream ) if( s ) cudaStreamSynchronize( s );
+      for( auto e : ev ) cudaEventDestroy( e );
+      cudaEventDestroy( evMeta0 ); cudaEventDestroy( evMeta1 );
+      cudaFreeHost( hIn ); cudaFreeHost( hOut ); cudaFreeHost( hCls ); cudaFreeHost( hMap ); cudaFreeHost( hAps );
+      cudaFree( dIn ); cudaFree( dOut ); cudaFree( dCls ); cudaFree( dMap ); cudaFree( dCoef ); cudaFree( dClip );
+      for( auto s : stream ) if( s ) cudaStreamDestroy( s );
+    }
+  };
+
+  int m_device = 0;
+  int m_numStreams = 2;
+  int m_slotBase   = 1;                           // workers [0, m_slotBase) = encoder threads, then one per slot
+  std::vector<int16_t> m_fixedCoef, m_fixedClip;
+  std::vector<std::unique_ptr<Worker>> m_workers;
+  std::mutex m_mutex;
+  bool m_nvmlOk = false;
+  nvmlDevice_t m_nvmlDev{};
+  // page-locked (cudaHostRegister) long-lived host buffers: uploads read them directly
+  std::vector<std::pair<const char*, size_t>> m_reg;
+  std::mutex m_regMutex;
+
+  bool isRegistered( const void* a, size_t bytes )
+  {
+    std::lock_guard<std::mutex> lock( m_regMutex );
+    const char* p = ( const char* ) a;
+    for( auto& r : m_reg ) if( p >= r.first && p + bytes <= r.first + r.second ) return true;
+    return false;
+  }
+
+  template<typename T> static void growHost( T*& p, size_t& cap, size_t n )
+  {
+    if( n <= cap ) return;
+    if( p ) ALF_CUDA_CHECK( cudaFreeHost( p ) );
+    ALF_CUDA_CHECK( cudaMallocHost( ( void** ) &p, n * sizeof( T ) ) );
+    cap = n;
+  }
+  template<typename T> static void growDev( T*& p, size_t n, size_t oldCap )
+  {
+    if( n <= oldCap && p ) return;
+    if( p ) ALF_CUDA_CHECK( cudaFree( p ) );
+    ALF_CUDA_CHECK( cudaMalloc( ( void** ) &p, n * sizeof( T ) ) );
+  }
+
+  Worker* getWorker( int idx )
+  {
+    std::lock_guard<std::mutex> lock( m_mutex );
+    if( idx >= ( int ) m_workers.size() ) m_workers.resize( idx + 1 );
+    if( !m_workers[idx] )
+    {
+      ALF_CUDA_CHECK( cudaSetDevice( m_device ) );
+      Worker* w = new Worker;
+      for( int i = 0; i < m_numStreams; i++ ) ALF_CUDA_CHECK( cudaStreamCreateWithFlags( &w->stream[i], cudaStreamNonBlocking ) );
+      ALF_CUDA_CHECK( cudaEventCreate( &w->evMeta0 ) );
+      ALF_CUDA_CHECK( cudaEventCreate( &w->evMeta1 ) );
+      const size_t tab = ( size_t ) kMaxSets * kSetStride;
+      ALF_CUDA_CHECK( cudaMalloc( ( void** ) &w->dCoef, tab * sizeof( int16_t ) ) );
+      ALF_CUDA_CHECK( cudaMalloc( ( void** ) &w->dClip, tab * sizeof( int16_t ) ) );
+      ALF_CUDA_CHECK( cudaMemset( w->dCoef, 0, tab * sizeof( int16_t ) ) );
+      ALF_CUDA_CHECK( cudaMemset( w->dClip, 0, tab * sizeof( int16_t ) ) );
+      ALF_CUDA_CHECK( cudaMemcpy( w->dCoef, m_fixedCoef.data(), m_fixedCoef.size() * sizeof( int16_t ), cudaMemcpyHostToDevice ) );
+      ALF_CUDA_CHECK( cudaMemcpy( w->dClip, m_fixedClip.data(), m_fixedClip.size() * sizeof( int16_t ), cudaMemcpyHostToDevice ) );
+      ALF_CUDA_CHECK( cudaMallocHost( ( void** ) &w->hAps, 2 * kMaxAps * kSetStride * sizeof( int16_t ) ) );
+      m_workers[idx].reset( w );
+    }
+    return m_workers[idx].get();
+  }
+
+public:
+  ~CudaBackend() override
+  {
+    m_workers.clear();
+    if( m_nvmlOk ) nvmlShutdown();
+  }
+
+  const char* name() const override { return "cuda"; }
+
+  bool init( const int16_t* fixedCoef, const int16_t* fixedClip, int, int, int numWorkers ) override
+  {
+    int n = 0;
+    if( cudaGetDeviceCount( &n ) != cudaSuccess || n == 0 ) return false;
+    if( const char* d = getenv( "VVENC_ALF_GPU_DEVICE" ) ) m_device = std::max( 0, std::min( n - 1, atoi( d ) ) );
+    if( const char* s = getenv( "VVENC_ALF_GPU_STREAMS" ) ) m_numStreams = std::max( 1, std::min( kMaxStreams, atoi( s ) ) );
+    ALF_CUDA_CHECK( cudaSetDevice( m_device ) );
+    cudaDeviceProp prop;
+    ALF_CUDA_CHECK( cudaGetDeviceProperties( &prop, m_device ) );
+    fprintf( stderr, "[AlfGpu] CUDA device %d: %s (sm_%d%d, %d SMs), %d stream(s)\n", m_device, prop.name, prop.major, prop.minor,
+             prop.multiProcessorCount, m_numStreams );
+
+    m_fixedCoef.assign( fixedCoef, fixedCoef + kNumFixedSets * kSetStride );
+    m_fixedClip.assign( fixedClip, fixedClip + kNumFixedSets * kSetStride );
+    m_workers.resize( std::max( 1, numWorkers ) );
+    m_slotBase = std::max( 1, numWorkers );
+
+    if( nvmlInit_v2() == NVML_SUCCESS )
+    {
+      char pci[32];
+      if( cudaDeviceGetPCIBusId( pci, sizeof( pci ), m_device ) == cudaSuccess &&
+          nvmlDeviceGetHandleByPciBusId_v2( pci, &m_nvmlDev ) == NVML_SUCCESS )
+      {
+        m_nvmlOk = true;
+      }
+    }
+    // load the kernels now (lazy module loading would otherwise charge the first frame)
+    cudaFuncAttributes attr;
+    cudaFuncGetAttributes( &attr, kAlfClassify );
+    cudaFuncGetAttributes( &attr, kAlfFilterLuma );
+    cudaFuncGetAttributes( &attr, kAlfCovariance );
+    cudaFuncGetAttributes( &attr, kAlfMerge );
+    cudaFuncGetAttributes( &attr, kAlfMergeDerive );
+    return true;
+  }
+
+  bool readEnergy_mJ( unsigned long long& e ) override
+  {
+    return m_nvmlOk && nvmlDeviceGetTotalEnergyConsumption( m_nvmlDev, &e ) == NVML_SUCCESS;
+  }
+  bool readPower_mW( unsigned& p ) override
+  {
+    return m_nvmlOk && nvmlDeviceGetPowerUsage( m_nvmlDev, &p ) == NVML_SUCCESS;
+  }
+
+  // what one call of the generic pipeline does
+  enum Step : unsigned
+  {
+    UP_IN    = 1,    // pack + H2D of the input band (else: the slot's resident input is used)
+    UP_CLS   = 2,    // H2D of p.cpuClass
+    CLASSIFY = 4,
+    FILTER   = 8,    // filter kernel + D2H + unpack of the filtered CTUs
+    DN_CLS   = 16,   // D2H of the classes into p.outClass
+  };
+
+  void filterLumaBand( const BandParams& p, int mode, int worker, Timing& t ) override
+  {
+    unsigned steps = UP_IN | FILTER;
+    if( mode == MODE_FILTER ) steps |= UP_CLS; else steps |= CLASSIFY;
+    if( p.outClass && mode != MODE_FILTER ) steps |= DN_CLS;
+    run( p, getWorker( worker ), steps, t );
+  }
+
+  void classifyFrame( const BandParams& p, int slot, Timing& t ) override
+  {
+    run( p, getWorker( m_slotBase + slot ), UP_IN | CLASSIFY | DN_CLS, t );
+  }
+
+  void filterFrameResident( const BandParams& p, int slot, Timing& t ) override
+  {
+    run( p, getWorker( m_slotBase + slot ), FILTER, t );
+  }
+
+  bool registerHost( void* p, size_t bytes ) override
+  {
+    if( const char* e = getenv( "VVENC_ALF_GPU_NOREG" ) ) if( atoi( e ) ) return false;
+    ALF_CUDA_CHECK( cudaSetDevice( m_device ) );
+    if( cudaHostRegister( p, bytes, cudaHostRegisterDefault ) != cudaSuccess )
+    {
+      cudaGetLastError();   // clear the error, fall back to staging copies
+      return false;
+    }
+    std::lock_guard<std::mutex> lock( m_regMutex );
+    m_reg.push_back( { ( const char* ) p, bytes } );
+    return true;
+  }
+
+  void unregisterHost( void* p ) override
+  {
+    std::lock_guard<std::mutex> lock( m_regMutex );
+    for( size_t i = 0; i < m_reg.size(); i++ )
+    {
+      if( m_reg[i].first != ( const char* ) p ) continue;
+      cudaSetDevice( m_device );
+      cudaDeviceSynchronize();
+      cudaHostUnregister( p );
+      m_reg.erase( m_reg.begin() + i );
+      return;
+    }
+  }
+
+  // asynchronous upload of the original planes: runs while the CTUs of the picture are still being encoded
+  void prefetchOriginal( const OrigPlanes& o, int slot, Timing& t ) override
+  {
+    using clk = std::chrono::steady_clock;
+    const auto t0 = clk::now();
+    Worker* w = getWorker( m_slotBase + slot );
+    ALF_CUDA_CHECK( cudaSetDevice( m_device ) );
+    if( !w->orgEv ) ALF_CUDA_CHECK( cudaEventCreate( &w->orgEv ) );
+    cudaStream_t st = w->stream[m_numStreams - 1];
+    double packMs = 0;
+    for( int c = 0; c < o.numComp; c++ )
+    {
+      const size_t n = ( size_t ) o.width[c] * o.height[c];
+      Worker::growBuf( w->cvOrg[c], n * sizeof( Pel ) );
+      const auto a = clk::now();
+      Pel* h = ( Pel* ) w->cvOrg[c].h;
+      for( int y = 0; y < o.height[c]; y++ ) memcpy( h + ( size_t ) y * o.width[c], o.org[c] + y * o.stride[c], o.width[c] * sizeof( Pel ) );
+      packMs += std::chrono::duration<double, std::milli>( clk::now() - a ).count();
+      ALF_CUDA_CHECK( cudaMemcpyAsync( w->cvOrg[c].d, h, n * sizeof( Pel ), cudaMemcpyHostToDevice, st ) );
+      w->orgW[c] = o.width[c];
+      w->orgH[c] = o.height[c];
+      t.bytesH2D += n * sizeof( Pel );
+    }
+    ALF_CUDA_CHECK( cudaEventRecord( w->orgEv, st ) );
+    w->orgPending = true;
+    t.hostPackMs += packMs;
+    t.totalMs    += std::chrono::duration<double, std::milli>( clk::now() - t0 ).count();
+  }
+
+  // classification + covariance statistics as one submission; one synchronisation at the end
+  void classifyAndCovariance( const BandParams& p, const CovJob* jobs, int numJobs, int slot, Timing& tCls, Timing& tCov ) override
+  {
+    Worker* w = getWorker( m_slotBase + slot );
+    unsigned steps = UP_IN | CLASSIFY;
+    if( p.outClass ) steps |= DN_CLS;
+    runEnqueue( p, w, steps );
+    covarianceFrame( jobs, numJobs, slot, tCov );   // the luma job waits for the classification events
+    runFinish( p, w, steps, tCls );
+  }
+
+  void mergeFilters( const MergeJob& job, MergeResult& res, int slot, Timing& t ) override
+  {
+    using clk = std::chrono::steady_clock;
+    auto ms   = []( clk::time_point a, clk::time_point b ) { return std::chrono::duration<double, std::milli>( b - a ).count(); };
+    const auto t0 = clk::now();
+    Worker* w = getWorker( m_slotBase + slot );
+    ALF_CUDA_CHECK( cudaSetDevice( m_device ) );
+    for( auto& e : w->mgEv ) if( !e ) ALF_CUDA_CHECK( cudaEventCreate( &e ) );
+    const size_t n = ( size_t ) kNumClasses * covStride( job.nb );
+    Worker::growBuf( w->mgCov,       n * sizeof( float ) );
+    Worker::growBuf( w->mgCovMerged, n * sizeof( float ) );
+    Worker::growBuf( w->mgClip,      ( size_t ) kNumClasses * kNumClasses * kNumCoeff );
+    Worker::growBuf( w->mgRes,       sizeof( MergeResult ) );
+    const auto a = clk::now();
+    memcpy( w->mgCov.h, job.cov, n * sizeof( float ) );
+    const double packMs = ms( a, clk::now() );
+    cudaStream_t st = w->stream[0];
+    MergeBufs b{ ( const float* ) w->mgCov.d, ( float* ) w->mgCovMerged.d, ( int8_t* ) w->mgClip.d, ( MergeResult* ) w->mgRes.d };
+    ALF_CUDA_CHECK( cudaEventRecord( w->mgEv[0], st ) );
+    ALF_CUDA_CHECK( cudaMemcpyAsync( w->mgCov.d, w->mgCov.h, n * sizeof( float ), cudaMemcpyHostToDevice, st ) );
+    ALF_CUDA_CHECK( cudaEventRecord( w->mgEv[1], st ) );
+    launchAlfMerge( job, b, st );
+    ALF_CUDA_CHECK( cudaGetLastError() );
+    ALF_CUDA_CHECK( cudaEventRecord( w->mgEv[2], st ) );
+    ALF_CUDA_CHECK( cudaMemcpyAsync( w->mgRes.h, w->mgRes.d, sizeof( MergeResult ), cudaMemcpyDeviceToHost, st ) );
+    ALF_CUDA_CHECK( cudaEventRecord( w->mgEv[3], st ) );
+    ALF_CUDA_CHECK( cudaEventSynchronize( w->mgEv[3] ) );
+    const auto u = clk::now();
+    memcpy( &res, w->mgRes.h, sizeof( MergeResult ) );
+    const double unpackMs = ms( u, clk::now() );
+    float x, y, z, sp;
+    cudaEventElapsedTime( &x, w->mgEv[0], w->mgEv[1] );
+    cudaEventElapsedTime( &y, w->mgEv[1], w->mgEv[2] );
+    cudaEventElapsedTime( &z, w->mgEv[2], w->mgEv[3] );
+    cudaEventElapsedTime( &sp, w->mgEv[0], w->mgEv[3] );
+    t.hostPackMs   += packMs;
+    t.h2dMs        += x;
+    t.distMs       += y;
+    t.d2hMs        += z;
+    t.hostUnpackMs += unpackMs;
+    t.gpuSpanMs    += sp;
+    t.totalMs      += ms( t0, clk::now() );
+    t.bytesH2D     += n * sizeof( float );
+    t.bytesD2H     += sizeof( MergeResult );
+  }
+
+  void ccalfStatsFrame( const CcAlfJob* jobs, int numJobs, int slot, Timing& t ) override
+  {
+    using clk = std::chrono::steady_clock;
+    auto ms   = []( clk::time_point a, clk::time_point b ) { return std::chrono::duration<double, std::milli>( b - a ).count(); };
+    const auto t0 = clk::now();
+    Worker* w = getWorker( m_slotBase + slot );
+    ALF_CUDA_CHECK( cudaSetDevice( m_device ) );
+    double packMs = 0, unpackMs = 0;
+    for( int j = 0; j < numJobs; j++ )
+    {
+      const CcAlfJob& jb = jobs[j];
+      const int c = jb.comp;
+      cudaStream_t st = w->stream[j % m_numStreams];
+      for( auto& e : w->ccEv[c] ) if( !e ) ALF_CUDA_CHECK( cudaEventCreate( &e ) );
+      CovKParams k = jb.k;
+      if( !w->dIn || w->residentW != ( jb.width << k.sx ) || w->residentH != ( jb.height << k.sy ) )
+      {
+        fprintf( stderr, "[AlfGpu] ccalfStatsFrame without a matching classifyFrame\n" );
+        abort();
+      }
+      const size_t planeN = ( size_t ) jb.width * jb.height;
+      const size_t outN   = ( size_t ) jb.numUnits * k.numElem;
+      Worker::growBuf( w->ccSlf[c],  planeN * sizeof( Pel ) );
+      Worker::growBuf( w->ccUnit[c], ( jb.numUnits + 1 ) * sizeof( int ) );
+      Worker::growBuf( w->ccRect[c], ( size_t ) jb.numUnits * 4 * sizeof( int16_t ) );
+      Worker::growBuf( w->ccElem[c], k.numElem * sizeof( uint32_t ) );
+      Worker::growBuf( w->ccOut[c],  outN * sizeof( float ) );
+      const auto a = clk::now();
+      Pel* hs = ( Pel* ) w->ccSlf[c].h;
+      for( int y = 0; y < jb.height; y++ ) memcpy( hs + ( size_t ) y * jb.width, jb.slf + y * jb.slfStride, jb.width * sizeof( Pel ) );
+      int* hu = ( int* ) w->ccUnit[c].h;
+      for( int u = 0; u <= jb.numUnits; u++ ) hu[u] = u;
+      memcpy( w->ccRect[c].h, jb.ctuRect, ( size_t ) jb.numUnits * 4 * sizeof( int16_t ) );
+      memcpy( w->ccElem[c].h, jb.elem, k.numElem * sizeof( uint32_t ) );
+      bool upOrg = false;
+      if( jb.org )
+      {
+        Worker::growBuf( w->cvOrg[c], planeN * sizeof( Pel ) );
+        Pel* ho = ( Pel* ) w->cvOrg[c].h;
+        for( int y = 0; y < jb.height; y++ ) memcpy( ho + ( size_t ) y * jb.width, jb.org + y * jb.orgStride, jb.width * sizeof( Pel ) );
+        upOrg = true;
+      }
+      else if( w->orgW[c] != jb.width || w->orgH[c] != jb.height )
+      {
+        fprintf( stderr, "[AlfGpu] ccalfStatsFrame without a prefetched original\n" );
+        abort();
+      }
+      packMs += ms( a, clk::now() );
+      k.recPitch = w->residentW + 2 * kHalo;
+      k.orgPitch = jb.width;
+      k.slfPitch = jb.width;
+
+      ALF_CUDA_CHECK( cudaEventRecord( w->ccEv[c][0], st ) );
+      if( !upOrg && w->orgPending ) ALF_CUDA_CHECK( cudaStreamWaitEvent( st, w->orgEv, 0 ) );
+      if( upOrg ) ALF_CUDA_CHECK( cudaMemcpyAsync( w->cvOrg[c].d, w->cvOrg[c].h, planeN * sizeof( Pel ), cudaMemcpyHostToDevice, st ) );
+      ALF_CUDA_CHECK( cudaMemcpyAsync( w->ccSlf[c].d, w->ccSlf[c].h, planeN * sizeof( Pel ), cudaMemcpyHostToDevice, st ) );
+      ALF_CUDA_CHECK( cudaMemcpyAsync( w->ccUnit[c].d, w->ccUnit[c].h, ( jb.numUnits + 1 ) * sizeof( int ), cudaMemcpyHostToDevice, st ) );
+      ALF_CUDA_CHECK( cudaMemcpyAsync( w->ccRect[c].d, w->ccRect[c].h, ( size_t ) jb.numUnits * 4 * sizeof( int16_t ), cudaMemcpyHostToDevice, st ) );
+      ALF_CUDA_CHECK( cudaMemcpyAsync( w->ccElem[c].d, w->ccElem[c].h, k.numElem * sizeof( uint32_t ), cudaMemcpyHostToDevice, st ) );
+      ALF_CUDA_CHECK( cudaEventRecord( w->ccEv[c][1], st ) );
+      const Pel* dRec = w->dIn + ( size_t ) kHalo * k.recPitch + kHalo;
+      launchAlfCovariance( k, jb.numUnits, dRec, ( const Pel* ) w->cvOrg[c].d, nullptr, ( const int* ) w->ccUnit[c].d,
+                           ( const int16_t* ) w->ccRect[c].d, ( const uint32_t* ) w->ccElem[c].d, ( float* ) w->ccOut[c].d, nullptr, st,
+                           ( const Pel* ) w->ccSlf[c].d );
+      ALF_CUDA_CHECK( cudaGetLastError() );
+      ALF_CUDA_CHECK( cudaEventRecord( w->ccEv[c][2], st ) );
+      ALF_CUDA_CHECK( cudaMemcpyAsync( w->ccOut[c].h, w->ccOut[c].d, outN * sizeof( float ), cudaMemcpyDeviceToHost, st ) );
+      ALF_CUDA_CHECK( cudaEventRecord( w->ccEv[c][3], st ) );
+      t.bytesH2D += planeN * sizeof( Pel ) * ( upOrg ? 2 : 1 ) + ( jb.numUnits + 1 ) * sizeof( int ) + ( size_t ) jb.numUnits * 8 + k.numElem * 4;
+      t.bytesD2H += outN * sizeof( float );
+    }
+    double sH2D = 0, sK = 0, sD2H = 0, span = 0;
+    for( int j = 0; j < numJobs; j++ )
+    {
+      const CcAlfJob& jb = jobs[j];
+      const int c = jb.comp;
+      ALF_CUDA_CHECK( cudaEventSynchronize( w->ccEv[c][3] ) );
+      const auto a = clk::now();
+      memcpy( jb.out, w->ccOut[c].h, ( size_t ) jb.numUnits * jb.k.numElem * sizeof( float ) );
+      unpackMs += ms( a, clk::now() );
+      float x, y, z, sp;
+      cudaEventElapsedTime( &x, w->ccEv[c][0], w->ccEv[c][1] );
+      cudaEventElapsedTime( &y, w->ccEv[c][1], w->ccEv[c][2] );
+      cudaEventElapsedTime( &z, w->ccEv[c][2], w->ccEv[c][3] );
+      cudaEventElapsedTime( &sp, w->ccEv[jobs[0].comp][0], w->ccEv[c][3] );
+      sH2D += x; sK += y; sD2H += z; span = std::max<double>( span, sp );
+    }
+    t.hostPackMs   += packMs;
+    t.h2dMs        += sH2D;
+    t.ccalfMs      += sK;
+    t.d2hMs        += sD2H;
+    t.hostUnpackMs += unpackMs;
+    t.gpuSpanMs    += span;
+    t.totalMs      += ms( t0, clk::now() );
+  }
+
+  void covarianceFrame( const CovJob* jobs, int numJobs, int slot, Timing& t ) override
+  {
+    using clk = std::chrono::steady_clock;
+    auto ms   = []( clk::time_point a, clk::time_point b ) { return std::chrono::duration<double, std::milli>( b - a ).count(); };
+    const auto t0 = clk::now();
+    Worker* w = getWorker( m_slotBase + slot );
+    ALF_CUDA_CHECK( cudaSetDevice( m_device ) );
+    double packMs = 0, unpackMs = 0;
+
+    // one stream per colour component: pack + H2D, kernel, D2H; the components overlap
+    for( int j = 0; j < numJobs; j++ )
+    {
+      const CovJob& jb = jobs[j];
+      const int c = jb.comp;
+      cudaStream_t st = w->stream[j % m_numStreams];
+      for( auto& e : w->cvEv[c] ) if( !e ) ALF_CUDA_CHECK( cudaEventCreate( &e ) );
+      CovKParams k = jb.k;
+      const size_t orgN  = ( size_t ) jb.width * jb.height;
+      const int    nCtu  = jb.unitCtuStart[jb.numUnits];
+      const size_t outN  = ( size_t ) jb.numUnits * k.numClasses * k.numElem;
+      const size_t usedN = ( size_t ) jb.numUnits * k.numClasses;
+      Worker::growBuf( w->cvOrg[c],  orgN * sizeof( Pel ) );
+      Worker::growBuf( w->cvUnit[c], ( jb.numUnits + 1 ) * sizeof( int ) );
+      Worker::growBuf( w->cvRect[c], ( size_t ) nCtu * 4 * sizeof( int16_t ) );
+      Worker::growBuf( w->cvElem[c], k.numElem * sizeof( uint32_t ) );
+      Worker::growBuf( w->cvOut[c],  outN * sizeof( float ) );
+      Worker::growBuf( w->cvUsed[c], usedN );
+
+      const auto a = clk::now();
+      const bool upOrg = jb.org != nullptr;
+      if( upOrg )
+      {
+        Pel* hOrg = ( Pel* ) w->cvOrg[c].h;
+        for( int y = 0; y < jb.height; y++ ) memcpy( hOrg + ( size_t ) y * jb.width, jb.org + y * jb.orgStride, jb.width * sizeof( Pel ) );
+      }
+      else if( w->orgW[c] != jb.width || w->orgH[c] != jb.height )
+      {
+        fprintf( stderr, "[AlfGpu] covarianceFrame without a prefetched original\n" );
+        abort();
+      }
+      memcpy( w->cvUnit[c].h, jb.unitCtuStart, ( jb.numUnits + 1 ) * sizeof( int ) );
+      memcpy( w->cvRect[c].h, jb.ctuRect, ( size_t ) nCtu * 4 * sizeof( int16_t ) );
+      memcpy( w->cvElem[c].h, jb.elem, k.numElem * sizeof( uint32_t ) );
+      k.orgPitch = jb.width;
+      k.recPitch = jb.width + 2 * kHalo;
+      const Pel* dRec;
+      const uint8_t* dCls = nullptr;
+      size_t recBytes = 0;
+      bool recDirect = false;
+      if( c == 0 )
+      {
+        if( !w->dIn || w->residentW != jb.width || w->residentH != jb.height )
+        {
+          fprintf( stderr, "[AlfGpu] covarianceFrame (luma) without a matching classifyFrame\n" );
+          abort();
+        }
+        k.clsStride = jb.width >> 2;
+        dRec = w->dIn + ( size_t ) kHalo * k.recPitch + kHalo;
+        dCls = w->dCls;
+      }
+      else
+      {
+        recBytes = ( size_t ) k.recPitch * ( jb.height + 2 * kHalo ) * sizeof( Pel );
+        Worker::growBuf( w->cvRec[c], recBytes );
+        const Pel* recTop = jb.rec - kHalo * jb.recStride - kHalo;
+        recDirect = isRegistered( recTop, ( ( size_t ) ( jb.height + 2 * kHalo - 1 ) * jb.recStride + k.recPitch ) * sizeof( Pel ) );
+        if( !recDirect )
+        {
+          Pel* hRec = ( Pel* ) w->cvRec[c].h;
+          for( int y = -kHalo; y < jb.height + kHalo; y++ )
+          {
+            memcpy( hRec + ( size_t ) ( y + kHalo ) * k.recPitch, jb.rec + y * jb.recStride - kHalo, k.recPitch * sizeof( Pel ) );
+          }
+        }
+        dRec = ( const Pel* ) w->cvRec[c].d + ( size_t ) kHalo * k.recPitch + kHalo;
+      }
+      packMs += ms( a, clk::now() );
+
+      ALF_CUDA_CHECK( cudaEventRecord( w->cvEv[c][0], st ) );
+      if( !upOrg && w->orgPending ) ALF_CUDA_CHECK( cudaStreamWaitEvent( st, w->orgEv, 0 ) );
+      if( c == 0 && w->runPending )
+      {
+        // fused submission: the luma statistics need the classes of every chunk
+        for( int ch = 0; ch < w->pendChunks; ch++ ) ALF_CUDA_CHECK( cudaStreamWaitEvent( st, w->ev[ch * 6 + 3], 0 ) );
+      }
+      if( upOrg ) ALF_CUDA_CHECK( cudaMemcpyAsync( w->cvOrg[c].d, w->cvOrg[c].h, orgN * sizeof( Pel ), cudaMemcpyHostToDevice, st ) );
+      if( recBytes && recDirect )
+      {
+        ALF_CUDA_CHECK( cudaMemcpy2DAsync( w->cvRec[c].d, k.recPitch * sizeof( Pel ), jb.rec - kHalo * jb.recStride - kHalo, jb.recStride * sizeof( Pel ),
+                                           k.recPitch * sizeof( Pel ), jb.height + 2 * kHalo, cudaMemcpyHostToDevice, st ) );
+      }
+      else if( recBytes ) ALF_CUDA_CHECK( cudaMemcpyAsync( w->cvRec[c].d, w->cvRec[c].h, recBytes, cudaMemcpyHostToDevice, st ) );
+      ALF_CUDA_CHECK( cudaMemcpyAsync( w->cvUnit[c].d, w->cvUnit[c].h, ( jb.numUnits + 1 ) * sizeof( int ), cudaMemcpyHostToDevice, st ) );
+      ALF_CUDA_CHECK( cudaMemcpyAsync( w->cvRect[c].d, w->cvRect[c].h, ( size_t ) nCtu * 4 * sizeof( int16_t ), cudaMemcpyHostToDevice, st ) );
+      ALF_CUDA_CHECK( cudaMemcpyAsync( w->cvElem[c].d, w->cvElem[c].h, k.numElem * sizeof( uint32_t ), cudaMemcpyHostToDevice, st ) );
+      ALF_CUDA_CHECK( cudaEventRecord( w->cvEv[c][1], st ) );
+      launchAlfCovariance( k, jb.numUnits, dRec, ( const Pel* ) w->cvOrg[c].d, dCls, ( const int* ) w->cvUnit[c].d,
+                           ( const int16_t* ) w->cvRect[c].d, ( const uint32_t* ) w->cvElem[c].d, ( float* ) w->cvOut[c].d,
+                           ( uint8_t* ) w->cvUsed[c].d, st );
+      ALF_CUDA_CHECK( cudaGetLastError() );
+      ALF_CUDA_CHECK( cudaEventRecord( w->cvEv[c][2], st ) );
+      ALF_CUDA_CHECK( cudaMemcpyAsync( w->cvOut[c].h, w->cvOut[c].d, outN * sizeof( float ), cudaMemcpyDeviceToHost, st ) );
+      ALF_CUDA_CHECK( cudaMemcpyAsync( w->cvUsed[c].h, w->cvUsed[c].d, usedN, cudaMemcpyDeviceToHost, st ) );
+      ALF_CUDA_CHECK( cudaEventRecord( w->cvEv[c][3], st ) );
+      t.bytesH2D += ( upOrg ? orgN * sizeof( Pel ) : 0 ) + recBytes + ( jb.numUnits + 1 ) * sizeof( int ) + ( size_t ) nCtu * 8 + k.numElem * 4;
+      t.bytesD2H += outN * sizeof( float ) + usedN;
+    }
+
+    // wait per component, unpack, collect the event times
+    double sH2D = 0, sCov = 0, sD2H = 0, span = 0;
+    for( int j = 0; j < numJobs; j++ )
+    {
+      const CovJob& jb = jobs[j];
+      const int c = jb.comp;
+      cudaStream_t st = w->stream[j % m_numStreams];
+      ALF_CUDA_CHECK( cudaStreamSynchronize( st ) );
+      const auto a = clk::now();
+      const size_t outN = ( size_t ) jb.numUnits * jb.k.numClasses * jb.k.numElem, usedN = ( size_t ) jb.numUnits * jb.k.numClasses;
+      memcpy( jb.out, w->cvOut[c].h, outN * sizeof( float ) );
+      memcpy( jb.used, w->cvUsed[c].h, usedN );
+      unpackMs += ms( a, clk::now() );
+      float x, y, z, sp;
+      cudaEventElapsedTime( &x, w->cvEv[c][0], w->cvEv[c][1] );
+      cudaEventElapsedTime( &y, w->cvEv[c][1], w->cvEv[c][2] );
+      cudaEventElapsedTime( &z, w->cvEv[c][2], w->cvEv[c][3] );
+      cudaEventElapsedTime( &sp, w->cvEv[jobs[0].comp][0], w->cvEv[c][3] );
+      sH2D += x; sCov += y; sD2H += z; span = std::max<double>( span, sp );
+    }
+    const auto t1 = clk::now();
+    t.hostPackMs   += packMs;
+    t.h2dMs        += sH2D;
+    t.covMs        += sCov;
+    t.d2hMs        += sD2H;
+    t.hostUnpackMs += unpackMs;
+    t.gpuSpanMs    += span;
+    t.totalMs      += ms( t0, t1 );
+  }
+
+private:
+  void run( const BandParams& p, Worker* w, const unsigned steps, Timing& t )
+  {
+    runEnqueue( p, w, steps );
+    runFinish( p, w, steps, t );
+  }
+
+  // number of pipeline chunks: small pictures run as one chunk (the per-chunk fixed cost dominates there)
+  static int chunkRowsFor( const BandParams& p )
+  {
+    const int ctuRows = ( p.bandH + p.ctuSize - 1 ) / p.ctuSize;
+    if( !getenv( "VVENC_ALF_GPU_CHUNK_ROWS" ) && ( size_t ) p.picWidth * p.bandH < ( size_t ) 1280 * 720 ) return ctuRows;
+    return chunkCtuRows( p.bandH, p.ctuSize );
+  }
+
+  // enqueues uploads, kernels and downloads of all chunks; runFinish() waits, unpacks and collects the timing
+  void runEnqueue( const BandParams& p, Worker* w, const unsigned steps )
+  {
+    using clk = std::chrono::steady_clock;
+    auto ms   = []( clk::time_point a, clk::time_point b ) { return std::chrono::duration<double, std::milli>( b - a ).count(); };
+    const auto t0 = clk::now();
+    ALF_CUDA_CHECK( cudaSetDevice( m_device ) );
+
+    const int    inPitch   = p.picWidth + 2 * kHalo;
+    const size_t inN       = ( size_t ) inPitch * ( p.bandH + 2 * kHalo );
+    const size_t outN      = ( size_t ) p.picWidth * p.bandH;
+    const int    clsStride = p.picWidth >> 2;
+    const size_t clsN      = ( size_t ) clsStride * ( ( p.bandH + 3 ) >> 2 );
+    const int    ctuRows   = ( p.bandH + p.ctuSize - 1 ) / p.ctuSize;
+    const size_t mapN      = ( size_t ) ctuRows * p.numCtuCols;
+    const int    chunkH    = chunkRowsFor( p ) * p.ctuSize;
+    const int    nChunks   = ( p.bandH + chunkH - 1 ) / chunkH;
+    const bool   upIn      = steps & UP_IN, filter = steps & FILTER, classify = steps & CLASSIFY;
+
+    if( upIn )
+    {
+      size_t c = w->capIn; growHost( w->hIn, w->capIn, inN ); growDev( w->dIn, inN, c );
+      w->residentH = p.bandH; w->residentW = p.picWidth;
+    }
+    else
+    {
+      if( !w->dIn || w->residentH != p.bandH || w->residentW != p.picWidth )
+      {
+        fprintf( stderr, "[AlfGpu] filterFrameResident without a matching classifyFrame\n" );
+        abort();
+      }
+    }
+    if( filter ) { size_t c = w->capOut; growHost( w->hOut, w->capOut, outN ); growDev( w->dOut, outN, c ); }
+    if( upIn || ( steps & UP_CLS ) ) { size_t c = w->capCls; growHost( w->hCls, w->capCls, clsN ); growDev( w->dCls, clsN, c ); }
+    { size_t c = w->capMap; growHost( w->hMap, w->capMap, mapN ); growDev( w->dMap, mapN, c ); }
+    w->ensureEvents( ( size_t ) nChunks * 6 );
+    auto EV = [&]( int c, int i ) { return w->ev[c * 6 + i]; };
+    auto ST = [&]( int c ) { return w->stream[c % m_numStreams]; };
+
+    double packMs = 0;
+    uint64_t h2d = 0, d2h = 0;
+    // input read directly from a page-locked buffer (registerHost) or through the pinned staging buffer
+    const bool direct = upIn && isRegistered( p.src - kHalo * p.srcStride - kHalo,
+                                              ( ( size_t ) ( p.bandH + 2 * kHalo - 1 ) * p.srcStride + inPitch ) * sizeof( Pel ) );
+
+    // ---- per-call metadata (CTU map, APS sets, optional CPU classes) on stream 0; all chunks wait for it
+    {
+      const auto a = clk::now();
+      memcpy( w->hMap, p.ctuSetIdx, mapN * sizeof( int16_t ) );
+      const bool aps = filter && p.numAps > 0;
+      if( aps )
+      {
+        memcpy( w->hAps, p.apsCoef, p.numAps * kSetStride * sizeof( int16_t ) );
+        memcpy( w->hAps + kMaxAps * kSetStride, p.apsClip, p.numAps * kSetStride * sizeof( int16_t ) );
+      }
+      if( steps & UP_CLS ) memcpy( w->hCls, p.cpuClass, clsN );
+      packMs += ms( a, clk::now() );
+
+      cudaStream_t s = w->stream[0];
+      ALF_CUDA_CHECK( cudaEventRecord( w->evMeta0, s ) );
+      ALF_CUDA_CHECK( cudaMemcpyAsync( w->dMap, w->hMap, mapN * sizeof( int16_t ), cudaMemcpyHostToDevice, s ) );
+      h2d += mapN * sizeof( int16_t );
+      if( aps )
+      {
+        const size_t n = ( size_t ) p.numAps * kSetStride;
+        ALF_CUDA_CHECK( cudaMemcpyAsync( w->dCoef + kNumFixedSets * kSetStride, w->hAps, n * sizeof( int16_t ), cudaMemcpyHostToDevice, s ) );
+        ALF_CUDA_CHECK( cudaMemcpyAsync( w->dClip + kNumFixedSets * kSetStride, w->hAps + kMaxAps * kSetStride, n * sizeof( int16_t ), cudaMemcpyHostToDevice, s ) );
+        h2d += 2 * n * sizeof( int16_t );
+      }
+      if( steps & UP_CLS )
+      {
+        ALF_CUDA_CHECK( cudaMemcpyAsync( w->dCls, w->hCls, clsN, cudaMemcpyHostToDevice, s ) );
+        h2d += clsN;
+      }
+      ALF_CUDA_CHECK( cudaEventRecord( w->evMeta1, s ) );
+    }
+
+    // ---- pack + H2D per chunk (chunk c owns input rows [y0, y0+h); the first/last chunk also carry the outer halo)
+    for( int c = 0; c < nChunks; c++ )
+    {
+      ALF_CUDA_CHECK( cudaEventRecord( EV( c, 0 ), ST( c ) ) );
+      if( upIn )
+      {
+        const int y0   = c * chunkH, h = std::min( chunkH, p.bandH - y0 );
+        const int rBeg = ( c == 0 ) ? -kHalo : y0;                       // band rows
+        const int rEnd = ( c == nChunks - 1 ) ? p.bandH + kHalo : y0 + h;
+        const size_t off = ( size_t ) ( rBeg + kHalo ) * inPitch, n = ( size_t ) ( rEnd - rBeg ) * inPitch;
+        if( direct )
+        {
+          ALF_CUDA_CHECK( cudaMemcpy2DAsync( w->dIn + off, inPitch * sizeof( Pel ), p.src + ( ptrdiff_t ) rBeg * p.srcStride - kHalo, p.srcStride * sizeof( Pel ),
+                                             inPitch * sizeof( Pel ), rEnd - rBeg, cudaMemcpyHostToDevice, ST( c ) ) );
+        }
+        else
+        {
+          const auto a = clk::now();
+          for( int y = rBeg; y < rEnd; y++ )
+          {
+            memcpy( w->hIn + ( size_t ) ( y + kHalo ) * inPitch, p.src + ( ptrdiff_t ) y * p.srcStride - kHalo, inPitch * sizeof( Pel ) );
+          }
+          packMs += ms( a, clk::now() );
+          ALF_CUDA_CHECK( cudaMemcpyAsync( w->dIn + off, w->hIn + off, n * sizeof( Pel ), cudaMemcpyHostToDevice, ST( c ) ) );
+        }
+        h2d += n * sizeof( Pel );
+      }
+      ALF_CUDA_CHECK( cudaEventRecord( EV( c, 1 ), ST( c ) ) );
+    }
+
+    // ---- kernels + D2H per chunk
+    for( int c = 0; c < nChunks; c++ )
+    {
+      const int y0 = c * chunkH, h = std::min( chunkH, p.bandH - y0 );
+      cudaStream_t s = ST( c );
+      ALF_CUDA_CHECK( cudaStreamWaitEvent( s, w->evMeta1, 0 ) );
+      if( upIn && c > 0 )           ALF_CUDA_CHECK( cudaStreamWaitEvent( s, EV( c - 1, 1 ), 0 ) );   // top halo
+      if( upIn && c < nChunks - 1 ) ALF_CUDA_CHECK( cudaStreamWaitEvent( s, EV( c + 1, 1 ), 0 ) );   // bottom halo
+
+      KParams k;
+      k.picWidth = p.picWidth;  k.bandY0 = p.bandY0 + y0;  k.bandH = h;  k.ctuSize = p.ctuSize;
+      k.numCtuCols = p.numCtuCols;  k.bitDepth = p.bitDepth;  k.vbH = p.vbH;  k.vbPos = p.vbPos;
+      k.inPitch = inPitch;  k.clsStride = clsStride;  k.outPitch = p.picWidth;
+      const Pel*     in  = w->dIn + ( size_t ) y0 * inPitch;              // halo top of the chunk
+      const int16_t* map = w->dMap + ( y0 / p.ctuSize ) * p.numCtuCols;
+      uint8_t*       cl  = w->dCls + ( size_t ) ( y0 >> 2 ) * clsStride;
+      Pel*           out = filter ? w->dOut + ( size_t ) y0 * p.picWidth : nullptr;
+
+      ALF_CUDA_CHECK( cudaEventRecord( EV( c, 2 ), s ) );
+      if( classify ) launchAlfClassify( in, map, cl, k, s );
+      ALF_CUDA_CHECK( cudaGetLastError() );
+      ALF_CUDA_CHECK( cudaEventRecord( EV( c, 3 ), s ) );
+      if( filter ) launchAlfFilterLuma( in, map, cl, w->dCoef, w->dClip, out, k, s );
+      ALF_CUDA_CHECK( cudaGetLastError() );
+      ALF_CUDA_CHECK( cudaEventRecord( EV( c, 4 ), s ) );
+      if( filter )
+      {
+        ALF_CUDA_CHECK( cudaMemcpyAsync( w->hOut + ( size_t ) y0 * p.picWidth, out, ( size_t ) h * p.picWidth * sizeof( Pel ), cudaMemcpyDeviceToHost, s ) );
+        d2h += ( size_t ) h * p.picWidth * sizeof( Pel );
+      }
+      if( steps & DN_CLS )
+      {
+        const size_t n = ( size_t ) clsStride * ( ( h + 3 ) >> 2 );
+        ALF_CUDA_CHECK( cudaMemcpyAsync( w->hCls + ( size_t ) ( y0 >> 2 ) * clsStride, cl, n, cudaMemcpyDeviceToHost, s ) );
+        d2h += n;
+      }
+      ALF_CUDA_CHECK( cudaEventRecord( EV( c, 5 ), s ) );
+    }
+    w->runPending = true;
+    w->pendChunks = nChunks;
+    w->pendChunkH = chunkH;
+    w->pendPackMs = packMs;
+    w->pendH2D    = h2d;
+    w->pendD2H    = d2h;
+    w->pendT0     = t0;
+  }
+
+  void runFinish( const BandParams& p, Worker* w, const unsigned steps, Timing& t )
+  {
+    using clk = std::chrono::steady_clock;
+    auto ms   = []( clk::time_point a, clk::time_point b ) { return std::chrono::duration<double, std::milli>( b - a ).count(); };
+    const int    clsStride = p.picWidth >> 2;
+    const bool   filter    = steps & FILTER;
+    const int    nChunks   = w->pendChunks, chunkH = w->pendChunkH;
+    auto EV = [&]( int c, int i ) { return w->ev[c * 6 + i]; };
+    double unpackMs = 0;
+
+    // ---- unpack chunk by chunk as they complete (overlaps with the GPU work of later chunks)
+    for( int c = 0; c < nChunks; c++ )
+    {
+      ALF_CUDA_CHECK( cudaEventSynchronize( EV( c, 5 ) ) );
+      const auto a = clk::now();
+      const int y0 = c * chunkH, h = std::min( chunkH, p.bandH - y0 );
+      if( filter )
+      {
+        for( int r = y0 / p.ctuSize; r < ( y0 + h + p.ctuSize - 1 ) / p.ctuSize; r++ )
+        {
+          const int ry0 = r * p.ctuSize, rh = std::min( p.ctuSize, p.bandH - ry0 );
+          for( int col = 0; col < p.numCtuCols; col++ )
+          {
+            if( p.ctuSetIdx[r * p.numCtuCols + col] < 0 ) continue;
+            const int x0 = col * p.ctuSize, wd = std::min( p.ctuSize, p.picWidth - x0 );
+            for( int y = ry0; y < ry0 + rh; y++ )
+            {
+              memcpy( p.dst + ( ptrdiff_t ) y * p.dstStride + x0, w->hOut + ( size_t ) y * p.picWidth + x0, wd * sizeof( Pel ) );
+            }
+          }
+        }
+      }
+      if( steps & DN_CLS )
+      {
+        const size_t n = ( size_t ) clsStride * ( ( h + 3 ) >> 2 ), off = ( size_t ) ( y0 >> 2 ) * clsStride;
+        memcpy( p.outClass + off, w->hCls + off, n );
+      }
+      unpackMs += ms( a, clk::now() );
+    }
+    const auto t3 = clk::now();
+
+    // ---- event timing: per-stage sums over chunks + overall GPU span
+    float meta = 0;
+    cudaEventElapsedTime( &meta, w->evMeta0, w->evMeta1 );
+    double sH2D = meta, sCls = 0, sFlt = 0, sD2H = 0, span = 0;
+    for( int c = 0; c < nChunks; c++ )
+    {
+      float a, b, d, e, f;
+      cudaEventElapsedTime( &a, EV( c, 0 ), EV( c, 1 ) );
+      cudaEventElapsedTime( &b, EV( c, 2 ), EV( c, 3 ) );
+      cudaEventElapsedTime( &d, EV( c, 3 ), EV( c, 4 ) );
+      cudaEventElapsedTime( &e, EV( c, 4 ), EV( c, 5 ) );
+      cudaEventElapsedTime( &f, w->evMeta0, EV( c, 5 ) );
+      sH2D += a; sCls += b; sFlt += d; sD2H += e; span = std::max<double>( span, f );
+    }
+
+    t.hostPackMs   += w->pendPackMs;
+    t.h2dMs        += sH2D;
+    t.classifyMs   += sCls;
+    t.filterMs     += sFlt;
+    t.d2hMs        += sD2H;
+    t.hostUnpackMs += unpackMs;
+    t.gpuSpanMs    += span;
+    t.totalMs      += ms( w->pendT0, t3 );
+    t.chunks       += nChunks;
+    t.bytesH2D     += w->pendH2D;
+    t.bytesD2H     += w->pendD2H;
+    w->runPending = false;
+  }
+};
+
+Backend* createCudaBackend()
+{
+  return new CudaBackend;   // init() reports failure when no device is available
+}
+
+} // namespace alfgpu
